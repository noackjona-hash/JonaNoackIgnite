<Application x:Class="Ignite.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Ignite.Desktop">
    <Application.Resources>
        <!-- ============================================================ -->
        <!-- IGNITE MEDICAL SUITE v5.0.0 - NEXT-GEN OBSIDIAN GLASSWORK    -->
        <!-- State-of-the-Art Radiology & AI Telemetry Cockpit            -->
        <!-- ============================================================ -->

        <!-- Deep Space Obsidian & Titanium Palette -->
        <Color x:Key="ColorAppBg">#07090E</Color>
        <Color x:Key="ColorSurface">#0D111A</Color>
        <Color x:Key="ColorSurfaceCard">#131826</Color>
        <Color x:Key="ColorSurfaceHover">#1C2336</Color>
        <Color x:Key="ColorBorder">#1E273A</Color>
        <Color x:Key="ColorBorderBright">#303D57</Color>
        
        <!-- Laser Neon Accents -->
        <Color x:Key="ColorCyan">#00F0FF</Color>
        <Color x:Key="ColorMedicalBlue">#2563EB</Color>
        <Color x:Key="ColorPurple">#8B5CF6</Color>
        <Color x:Key="ColorCritical">#FF2A55</Color>
        <Color x:Key="ColorWarning">#FFB300</Color>
        <Color x:Key="ColorSuccess">#00E676</Color>

        <!-- Solid Color Brushes -->
        <SolidColorBrush x:Key="AppBgBrush" Color="{StaticResource ColorAppBg}"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource ColorSurface}"/>
        <SolidColorBrush x:Key="SurfaceCardBrush" Color="{StaticResource ColorSurfaceCard}"/>
        <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource ColorSurfaceHover}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource ColorBorder}"/>
        <SolidColorBrush x:Key="BorderBrightBrush" Color="{StaticResource ColorBorderBright}"/>
        <SolidColorBrush x:Key="CyanBrush" Color="{StaticResource ColorCyan}"/>
        <SolidColorBrush x:Key="MedicalBlueBrush" Color="{StaticResource ColorMedicalBlue}"/>
        <SolidColorBrush x:Key="PurpleBrush" Color="{StaticResource ColorPurple}"/>
        <SolidColorBrush x:Key="CriticalBrush" Color="{StaticResource ColorCritical}"/>
        <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource ColorWarning}"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource ColorSuccess}"/>

        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A3B1C6"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#607089"/>

        <!-- High-End Cockpit Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceCardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,5"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource CyanBrush}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0C2540"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource CyanBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented Modern Tool RadioButton Style -->
        <Style x:Key="MedicalToolRadioStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="{StaticResource SurfaceCardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0E2F54"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource CyanBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource CyanBrush}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Glassmorphism TabControl & TabItem -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="tabBorder"
                                Background="#0F131E"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1,1,1,0"
                                Margin="1,0"
                                CornerRadius="4,4,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="{StaticResource SurfaceCardBrush}"/>
                                <Setter TargetName="tabBorder" Property="BorderBrush" Value="{StaticResource CyanBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource CyanBrush}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Dark DataGrid -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="RowBackground" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="#0F131C"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="RowHeight" Value="26"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#121622"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <!-- Menu Bar Styling -->
        <Style TargetType="Menu">
            <Setter Property="Background" Value="#090C12"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="#090C12"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>

        <!-- Modern Slider Styling -->
        <Style TargetType="Slider">
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Application.Resources>
</Application>
