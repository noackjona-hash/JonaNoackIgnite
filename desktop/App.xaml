<Application x:Class="Ignite.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Ignite.Desktop"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- ============================================================ -->
        <!-- IGNITE VOICEMOD-INSPIRED ULTRA-MODERN DARK THEME             -->
        <!-- Sleek Charcoal Black, Electric Mint/Cyan, Neon Lime CTA      -->
        <!-- Squircles, Rounded Floating Docks, Glassmorphic Highlights   -->
        <!-- ============================================================ -->

        <!-- Base Dark Canvas Colors -->
        <Color x:Key="ColorAppBg">#0B0E14</Color>
        <Color x:Key="ColorSidebar">#0F121A</Color>
        <Color x:Key="ColorSurface">#131722</Color>
        <Color x:Key="ColorSurfaceCard">#181D2A</Color>
        <Color x:Key="ColorSurfaceHover">#21283B</Color>
        <Color x:Key="ColorInputBg">#121622</Color>
        <Color x:Key="ColorBorder">#222838</Color>
        <Color x:Key="ColorBorderBright">#323B52</Color>

        <!-- Voicemod Electric Accents -->
        <Color x:Key="ColorCyan">#00F5C4</Color>          <!-- Signature Voicemod Electric Mint/Cyan -->
        <Color x:Key="ColorCyanHover">#33FFD4</Color>
        <Color x:Key="ColorProLime">#B4FF00</Color>        <!-- Voicemod Pro Badge / Hero CTA Lime -->
        <Color x:Key="ColorMedicalTeal">#00D2B4</Color>
        <Color x:Key="ColorMedicalBlue">#0099FF</Color>
        <Color x:Key="ColorPurple">#8B5CF6</Color>        <!-- Voice Lab / AI Purple -->
        <Color x:Key="ColorCritical">#FF4757</Color>      <!-- Alert / Triage Red -->
        <Color x:Key="ColorWarning">#FFA502</Color>       <!-- Warning Amber -->
        <Color x:Key="ColorSuccess">#00F5C4</Color>       <!-- Health / Normothermie Mint -->

        <!-- Solid Color Brushes -->
        <SolidColorBrush x:Key="AppBgBrush" Color="{StaticResource ColorAppBg}"/>
        <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource ColorSidebar}"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource ColorSurface}"/>
        <SolidColorBrush x:Key="SurfaceCardBrush" Color="{StaticResource ColorSurfaceCard}"/>
        <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource ColorSurfaceHover}"/>
        <SolidColorBrush x:Key="InputBgBrush" Color="{StaticResource ColorInputBg}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource ColorBorder}"/>
        <SolidColorBrush x:Key="BorderBrightBrush" Color="{StaticResource ColorBorderBright}"/>
        <SolidColorBrush x:Key="CyanBrush" Color="{StaticResource ColorCyan}"/>
        <SolidColorBrush x:Key="CyanHoverBrush" Color="{StaticResource ColorCyanHover}"/>
        <SolidColorBrush x:Key="ProLimeBrush" Color="{StaticResource ColorProLime}"/>
        <SolidColorBrush x:Key="MedicalTealBrush" Color="{StaticResource ColorMedicalTeal}"/>
        <SolidColorBrush x:Key="MedicalBlueBrush" Color="{StaticResource ColorMedicalBlue}"/>
        <SolidColorBrush x:Key="PurpleBrush" Color="{StaticResource ColorPurple}"/>
        <SolidColorBrush x:Key="CriticalBrush" Color="{StaticResource ColorCritical}"/>
        <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource ColorWarning}"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource ColorSuccess}"/>

        <!-- Modern Typography Brushes -->
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#5A6679"/>

        <!-- ============================================================ -->
        <!-- VOICEMOD SLEEK MINIMAL SCROLLBAR SYSTEM                      -->
        <!-- ============================================================ -->
        <Style x:Key="VoicemodScrollThumb" TargetType="{x:Type Thumb}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="IsTabStop" Value="false"/>
            <Setter Property="Focusable" Value="false"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border CornerRadius="3" Background="#282E3E" Margin="1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3F4860"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter Property="Background" Value="{StaticResource CyanBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="8"/>
                    <Setter Property="Height" Value="Auto"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="true">
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource VoicemodScrollThumb}"/>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track">
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource VoicemodScrollThumb}"/>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============================================================ -->
        <!-- VOICEMOD BUTTON STYLES                                       -->
        <!-- ============================================================ -->
        <!-- Standard Dark Pill Button -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceCardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="2,2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BorderBrightBrush}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#10141E"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource CyanBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Voicemod Glowing Primary Cyan Pill Button -->
        <Style x:Key="VoicemodPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CyanBrush}"/>
            <Setter Property="Foreground" Value="#090C12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Margin" Value="3,2"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="16"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource CyanHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Voicemod Lime "HOL DIR PRO" Hero Style Button -->
        <Style x:Key="VoicemodLimeHeroButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ProLimeBrush}"/>
            <Setter Property="Foreground" Value="#090C12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,7"/>
            <Setter Property="Margin" Value="3,2"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="16"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#C8FF20"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================ -->
        <!-- VOICEMOD CATEGORY FILTER PILL (RADIOBUTTON)                  -->
        <!-- In Voicemod: [ Alle ] [ Rollenspiel ] [ Memes ] [ FPS ]      -->
        <!-- Active: Cyan bg, dark bold text. Inactive: Dark slate pill.  -->
        <!-- ============================================================ -->
        <Style x:Key="VoicemodPillStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="{StaticResource SurfaceCardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="pillBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pillBorder" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                <Setter TargetName="pillBorder" Property="BorderBrush" Value="{StaticResource BorderBrightBrush}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="pillBorder" Property="Background" Value="{StaticResource CyanBrush}"/>
                                <Setter TargetName="pillBorder" Property="BorderBrush" Value="{StaticResource CyanBrush}"/>
                                <Setter Property="Foreground" Value="#090C12"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Alias for legacy MedicalToolRadioStyle to inherit the beautiful Voicemod pill look -->
        <Style x:Key="MedicalToolRadioStyle" TargetType="RadioButton" BasedOn="{StaticResource VoicemodPillStyle}"/>

        <!-- ============================================================ -->
        <!-- VOICEMOD LEFT NAVIGATION RAIL SQUIRCLE BUTTON                -->
        <!-- Squircle 44x44, dark inactive, bright cyan when active       -->
        <!-- ============================================================ -->
        <Style x:Key="VoicemodRailRadioStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#6B778D"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="railBd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="12"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="railBd" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="railBd" Property="Background" Value="{StaticResource CyanBrush}"/>
                                <Setter Property="Foreground" Value="#090C12"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Left Rail Standard Squircle Push Button (For non-toggle actions) -->
        <Style x:Key="VoicemodRailButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#6B778D"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="railBd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="railBd" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="railBd" Property="Background" Value="{StaticResource CyanBrush}"/>
                                <Setter Property="Foreground" Value="#090C12"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================ -->
        <!-- VOICEMOD FLOATING DOCK TOOL RADIO BUTTON                     -->
        <!-- Sleek compact tool selector inside bottom floating capsule    -->
        <!-- ============================================================ -->
        <Style x:Key="VoicemodDockRadioStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8A96A8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="dockBd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="dockBd" Property="Background" Value="#222A3C"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="dockBd" Property="Background" Value="#172C38"/>
                                <Setter Property="Foreground" Value="{StaticResource CyanBrush}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================ -->
        <!-- VOICEMOD SLIDER WITH CYAN GLOW & ROUNDED THUMB               -->
        <!-- In Voicemod: Sliders have a dark channel and cyan fill       -->
        <!-- ============================================================ -->
        <Style x:Key="VoicemodSliderThumb" TargetType="{x:Type Thumb}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Grid Width="16" Height="16">
                            <Ellipse Fill="#FFFFFF" Stroke="{StaticResource CyanBrush}" StrokeThickness="3"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Height" Value="22"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="6" Background="#1B2130" CornerRadius="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource VoicemodSliderThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================ -->
        <!-- VOICEMOD TABCONTROL & MODERN TABITEMS                        -->
        <!-- Clean, horizontal pill/indicator tabs                        -->
        <!-- ============================================================ -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="tabBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,2"
                                CornerRadius="6,6,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tabBorder" Property="BorderBrush" Value="{StaticResource CyanBrush}"/>
                                <Setter TargetName="tabBorder" Property="Background" Value="#172230"/>
                                <Setter Property="Foreground" Value="{StaticResource CyanBrush}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================ -->
        <!-- VOICEMOD MODERN DARK COMBOBOX                                -->
        <!-- ============================================================ -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource InputBgBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="28"/>
        </Style>

        <!-- ============================================================ -->
        <!-- VOICEMOD MODERN CHECKBOX                                     -->
        <!-- ============================================================ -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ============================================================ -->
        <!-- VOICEMOD DARK TABLE / DATAGRID                               -->
        <!-- Clean dark background, subtle row hover, cyan selection      -->
        <!-- ============================================================ -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="RowBackground" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="#10141E"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="RowHeight" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#161B26"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <!-- Menu Bar Styling -->
        <Style TargetType="Menu">
            <Setter Property="Background" Value="#0A0D14"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="#0A0D14"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>

        <!-- Text Box Styling -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBgBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

    </Application.Resources>
</Application>
