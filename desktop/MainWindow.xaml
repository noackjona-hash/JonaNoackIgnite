                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconStethoscope}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0" SnapsToDevicePixels="True"/>
