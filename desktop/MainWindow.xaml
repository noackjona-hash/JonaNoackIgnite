                            <!-- ============================================================ -->
                            <!-- VOICEMOD SIGNATURE FLOATING ACTION DOCK (BOTTOM CAPSULE)     -->
                            <!-- Interactive Tools, Big Glowing Pulse Trigger, Zoom controls  -->
                            <!-- ============================================================ -->
                            <Border Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20" 
                                    Background="#EE111520" BorderBrush="{StaticResource BorderBrightBrush}" BorderThickness="1.5" CornerRadius="26" Padding="10,6">
