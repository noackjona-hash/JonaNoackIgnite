                                <!-- Color LUT Ramp Display -->
                                <Border Height="12" Margin="0,4,0,8" CornerRadius="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#000080" Offset="0.0"/>
                                            <GradientStop Color="#800080" Offset="0.25"/>
                                            <GradientStop Color="#FF0000" Offset="0.55"/>
                                            <GradientStop Color="#FFFF00" Offset="0.8"/>
                                            <GradientStop Color="#FFFFFF" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <Border Background="#0E131C" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="8">
                                    <StackPanel>
                                        <TextBlock Text="Statistische Erläuterung:" FontWeight="Bold" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                        <TextBlock Text="• Cyan = Median-Temperatur des gesunden Gewebes" FontSize="10" Foreground="{StaticResource CyanBrush}"/>
                                        <TextBlock Text="• Rot = Robuster Schwellenwert (Median + k*MAD). Pixel rechts davon werden als Entzündungsherd markiert." FontSize="10" Foreground="{StaticResource CriticalBrush}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- TAB 5: THERMAL LINE PROFILE T(s) -->
                    <TabItem x:Name="TabProfile" Header="📈 Profil T(s)">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Thermisches Schnittprofil T(s)" FontWeight="Bold" FontSize="13" Foreground="{StaticResource CyanBrush}" Margin="0,0,0,2"/>
                                <TextBlock Text="Transversaler oder longitudinaler Temperaturverlauf entlang des gezogenen Messvektors." FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <!-- Metric KPI Cards -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="6,4" Margin="0,0,2,0">
                                        <StackPanel>
                                            <TextBlock Text="T MIN" FontSize="9" FontWeight="Bold" Foreground="{StaticResource CyanBrush}"/>
                                            <TextBlock x:Name="TxtProfileMinTemp" Text="-- °C" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="6,4" Margin="2,0">
                                        <StackPanel>
                                            <TextBlock Text="T MAX" FontSize="9" FontWeight="Bold" Foreground="#EF4444"/>
                                            <TextBlock x:Name="TxtProfileMaxTemp" Text="-- °C" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="6,4" Margin="2,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="T MITTEL" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock x:Name="TxtProfileMeanTemp" Text="-- °C" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="8,5" Margin="0,0,0,8">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock x:Name="TxtProfileLength" Text="Pfadlänge: -- px" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock x:Name="TxtProfileMaxGrad" Text="Maximaler Gradient |dT/ds|: -- K/px" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button HorizontalAlignment="Right" Content="CSV KOPIEREN" Click="BtnCopyProfileCsv_Click" Padding="6,2" FontSize="10"/>
                                    </Grid>
                                </Border>

                                <!-- Vector Chart Display Canvas -->
                                <Border Background="#06090F" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="4" Height="200">
                                    <Canvas x:Name="CanvasProfileGraph" ClipToBounds="True" Background="#06090F" SizeChanged="CanvasProfileGraph_SizeChanged"/>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- TAB 6: POINT TEMPERATURE PROBES & ARMSTRONG RISK -->
                    <TabItem x:Name="TabProbes" Header="📍 Sonden">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Klinische Punkt-Temperatursonden (P₁ ... Pn)" FontWeight="Bold" FontSize="13" Foreground="{StaticResource CyanBrush}" Margin="0,0,0,2"/>
                                <TextBlock Text="Manuelle Platzierung von Messsonden für bilateralen Armstrong-Seitenvergleich an homologen Stellen." FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <!-- Armstrong Delta T Callout Card -->
                                <Border x:Name="BorderArmstrongRiskCard" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="ARMSTRONG-VERGLEICH (P₁ vs P₂):" FontWeight="Bold" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                            <Border x:Name="BadgeArmstrongState" HorizontalAlignment="Right" Background="#122538" BorderBrush="{StaticResource CyanBrush}" BorderThickness="1" CornerRadius="2" Padding="6,1">
                                                <TextBlock x:Name="TxtProbeRiskBadge" Text="KEINE DATEN" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource CyanBrush}"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock x:Name="TxtProbeDeltaT" Text="ΔT = -- K" FontSize="22" FontWeight="Black" Foreground="{StaticResource CyanBrush}" Margin="0,4,0,2"/>
                                        <TextBlock x:Name="TxtProbeAssessment" Text="Klicken Sie im Bild auf zwei homologe Stellen (z. B. linker Großzeh &amp; rechter Großzeh)." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Placed Probes List -->
                                <TextBlock Text="Gesetzte Messpunkte:" FontWeight="Bold" FontSize="11" Margin="0,0,0,4"/>
                                <DataGrid x:Name="GridProbes" MaxHeight="170">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Sonde" Binding="{Binding Label}" Width="50"/>
                                        <DataGridTextColumn Header="X" Binding="{Binding Position.X, StringFormat={}{0:F0}}" Width="45"/>
                                        <DataGridTextColumn Header="Y" Binding="{Binding Position.Y, StringFormat={}{0:F0}}" Width="45"/>
                                        <DataGridTextColumn Header="Raw" Binding="{Binding RawVal}" Width="45"/>
                                        <DataGridTextColumn Header="Temperatur" Binding="{Binding Temperature, StringFormat={}{0:F1} °C}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                    <Button Content="SONDEN ZURÜCKSETZEN" Click="BtnResetProbes_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- TAB 7: ANATOMISCHE FUSS-ZONEN MATRIX -->
                    <TabItem x:Name="TabAnatomy" Header="🦶 Armstrong 5-Zonen">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="Anatomische Zonen-Matrix (Armstrong-Pflock-Zonen)" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource CyanBrush}"/>
                                <TextBlock Text="Automatisierte Segmentierung der Extremität in 5 funktionelle Belastungszonen." FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>

                            <DataGrid Grid.Row="1" x:Name="GridAnatomicalZones">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Anatomische Zone" Binding="{Binding ZoneName}" Width="135"/>
                                    <DataGridTextColumn Header="Links °C" Binding="{Binding MeanTempLeft, StringFormat={}{0:F1}}" Width="60"/>
                                    <DataGridTextColumn Header="Rechts °C" Binding="{Binding MeanTempRight, StringFormat={}{0:F1}}" Width="60"/>
                                    <DataGridTextColumn Header="ΔT (K)" Binding="{Binding DeltaT, StringFormat={}{0:F1}}" Width="50"/>
                                    <DataGridTextColumn Header="Klinischer Status" Binding="{Binding RiskAssessment}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Grid.Row="2" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="Klinische Interpretation der Fußsohlen-Zonen:" FontWeight="Bold" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="• Metatarsale I-II &amp; Hallux weisen die höchste Inzidenz für diabetische Spätfolgen (Malum perforans pedis) auf." FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                    <TextBlock Text="• Bei Asymmetrie ΔT ≥ 2.2 K ist die Entlastung durch orthopädisches Schuhwerk zwingend erforderlich." FontSize="10.5" Foreground="{StaticResource CriticalBrush}" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- TAB 7B: 6 TAYLOR-PALMER ANGIOSOME VASCULAR TERRITORIES -->
                    <TabItem x:Name="TabAngiosomes" Header="🩺 Angiosome">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="Taylor &amp; Palmer Angiosom-Gefäßterritorien (6 Territorien)" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource CyanBrush}"/>
                                <TextBlock Text="Zuordnung der Gewebetemperaturen zu den versorgenden Arterien (A. tibialis post., A. peronea, A. tibialis ant.)." FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>

                            <DataGrid Grid.Row="1" x:Name="GridAngiosomes">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="55"/>
                                    <DataGridTextColumn Header="Territorium" Binding="{Binding TerritoryName}" Width="135"/>
                                    <DataGridTextColumn Header="Zubringerarterie" Binding="{Binding FeederArtery}" Width="160"/>
                                    <DataGridTextColumn Header="T Mean" Binding="{Binding MeanTemp, StringFormat={}{0:F1} °C}" Width="55"/>
                                    <DataGridTextColumn Header="ΔT" Binding="{Binding DeltaT, StringFormat={}{0:F1} K}" Width="45"/>
                                    <DataGridTextColumn Header="Vaskulärer Befund" Binding="{Binding PerfusionStatus}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Grid.Row="2" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="Gefäßchirurgische Leitlinien-Beurteilung:" FontWeight="Bold" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="• Mediales Plantar-Angiosom: Höchste Inzidenz für Ulkushäufung bei Stenose der A. tibialis posterior.&#x0a;• Laterales Calcaneus-Angiosom: Indikator für distale Peroneal-Perfusion." FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- TAB 7C: PREDICTIVE 7-DAY ULCER RISK FORECASTER -->
                    <TabItem x:Name="TabPrediction" Header="🔮 Prädiktion">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Multivariates 7-Tage Ulzerations-Risikomodell" FontWeight="Bold" FontSize="13" Foreground="{StaticResource CyanBrush}" Margin="0,0,0,2"/>
                                <TextBlock Text="Prädiktive Wahrscheinlichkeitsrechnung basierend auf Armstrong-Delta, Laplace-Wärmestau (THDI) und mikrovaskulärer Stauung." FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <!-- Big KPI Risk Banner -->
                                <Border Background="#1A1828" BorderBrush="{StaticResource CriticalBrush}" BorderThickness="1" CornerRadius="3" Padding="12" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="7-TAGE ULKUS-WAHRSCHEINLICHKEIT:" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock x:Name="TxtPredProbability" Text="-- %" FontSize="26" FontWeight="Black" Foreground="{StaticResource CriticalBrush}" Margin="0,2,0,0"/>
                                            <TextBlock x:Name="TxtPredTier" Text="KEINE DATEN" FontSize="11" FontWeight="Bold" Foreground="#FCA5A5" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" VerticalAlignment="Center" Background="#122538" BorderBrush="{StaticResource CyanBrush}" BorderThickness="1" CornerRadius="3" Padding="10,6">
                                            <StackPanel>
                                                <TextBlock Text="ARMSTRONG STAGE" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                                <TextBlock x:Name="TxtPredStage" Text="Grad 0" FontSize="13" FontWeight="Bold" Foreground="{StaticResource CyanBrush}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Laplace Heat Entrapment & Autonomic Neuropathy -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,0,3,0">
                                        <StackPanel>
                                            <TextBlock Text="WÄRMESTAU-INDEX (THDI)" FontSize="9" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                                            <TextBlock x:Name="TxtPredThdi" Text="-- K/px²" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,2,0,0"/>
                                            <TextBlock Text="Laplace-Verdichtung (Hitzeinsel)" FontSize="9.5" Foreground="{StaticResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="8" Margin="3,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="AUTONOME NEUROPATHIE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource CyanBrush}"/>
                                            <TextBlock x:Name="TxtPredAns" Text="-- / 10" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,2,0,0"/>
                                            <TextBlock Text="Mikrozirkulatorische Parese" FontSize="9.5" Foreground="{StaticResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Clinical Risk Analysis Card -->
                                <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Charcot-Arthropathie Frühwarnung:" FontWeight="Bold" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock x:Name="TxtPredCharcot" Text="Unauffällig" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,6"/>
                                        
                                        <TextBlock Text="Sofortige Klinische Intervention:" FontWeight="Bold" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock x:Name="TxtPredIntervention" Text="Pipeline ausführen für prädiktive Risikoeinschätzung..." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource CyanBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- TAB 7D: ISOTHERM SLICING & DIGITAL SUBTRACTION THERMOGRAPHY -->
                    <TabItem x:Name="TabIsotherms" Header="🌐 Isothermen">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Isothermen-Bandfilterung &amp; Digital Subtraction (DST)" FontWeight="Bold" FontSize="13" Foreground="{StaticResource CyanBrush}" Margin="0,0,0,2"/>
                                <TextBlock Text="Selektive farbliche Isolierung definierter Temperaturkorridore und Verlaufs-Differenzanalyse." FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <!-- Isotherm Window Slider -->
                                <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="Isothermes Temperatur-Band [T_low, T_high]:" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock x:Name="TxtIsothermRange" Text="32.0 °C - 36.0 °C" HorizontalAlignment="Right" FontWeight="Bold" Foreground="{StaticResource CyanBrush}" FontSize="11"/>
                                        </Grid>
                                        
                                        <TextBlock Text="Untere Temperaturschwelle:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,1"/>
                                        <Slider x:Name="SliderIsothermLow" Minimum="20.0" Maximum="38.0" Value="32.0" SmallChange="0.5" ValueChanged="SliderIsotherm_ValueChanged"/>

                                        <TextBlock Text="Obere Temperaturschwelle:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,1"/>
                                        <Slider x:Name="SliderIsothermHigh" Minimum="24.0" Maximum="42.0" Value="36.0" SmallChange="0.5" ValueChanged="SliderIsotherm_ValueChanged"/>
                                    </StackPanel>
                                </Border>

                                <!-- Digital Subtraction Tracking -->
                                <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="Digital Subtraction Thermography (DST):" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock x:Name="TxtDstOffset" Text="-1.2 K (Besserung)" HorizontalAlignment="Right" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" FontSize="11"/>
                                        </Grid>
                                        <TextBlock Text="Simulierte longitudinale Therapiedifferenz (ΔΔT):" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,1"/>
                                        <Slider x:Name="SliderDstOffset" Minimum="-3.0" Maximum="3.0" Value="-1.2" SmallChange="0.2" ValueChanged="SliderDst_ValueChanged"/>
                                        <TextBlock Text="• Blau = Signifikante Gewebeabkühlung / Heilung&#x0a;• Rot = Entzündungszunahme / Progression&#x0a;• Grün/Grau = Stabiler Befund" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- TAB 8: BILATERAL SYMMETRY (ARMSTRONG CRITERIA) -->
                    <TabItem Header="⚖️ Bilateral">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="Bilateraler Armstrong-Seitenvergleich (ΔT >= 2.2 K)" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource CyanBrush}"/>
                                <TextBlock Text="Vergleicht anatomische Zonen der linken und rechten Extremität zur Frühwarnung diabetischer Fußulzera." FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,1,0,0"/>
                            </StackPanel>

                            <DataGrid Grid.Row="1" x:Name="GridSymmetry">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Anatomische Zone" Binding="{Binding Name}" Width="140"/>
                                    <DataGridTextColumn Header="Links Mean" Binding="{Binding LeftMean, StringFormat={}{0:F1}}" Width="70"/>
                                    <DataGridTextColumn Header="Rechts Mean" Binding="{Binding RightMean, StringFormat={}{0:F1}}" Width="70"/>
                                    <DataGridTextColumn Header="ΔT (K)" Binding="{Binding DeltaT, StringFormat={}{0:F1}}" Width="50"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Grid.Row="2" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="Armstrong-Gesamtbeurteilung:" FontWeight="Bold" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock x:Name="TxtSymmetryAssessment" Text="Klicken Sie auf 'Extremitäten trennen' oder laden Sie zwei Bilder..." TextWrapping="Wrap" Margin="0,3,0,0" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- TAB 9: PERFUSION ANALYSIS -->
                    <TabItem Header="📉 Perfusion">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Longitudinale Perfusionsanalyse (dT/dy)" FontWeight="Bold" FontSize="13" Foreground="{StaticResource CyanBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="Berechnet den Temperaturgradienten entlang der anatomischen Achse zur Erkennung distaler Durchblutungsabbrüche (pAVK)." 
                                           TextWrapping="Wrap" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"/>

                                <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtPerfusionStatus" Text="STATUS: --" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock x:Name="TxtPerfusionDrop" Text="Maximaler Gradientenabfall: -- K/Zeile" FontSize="11.5" Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <Separator Margin="0,6" Background="{StaticResource BorderBrush}"/>
                                        <TextBlock x:Name="TxtPerfusionDesc" Text="Keine Daten. Bitte zuerst Pipeline ausführen." TextWrapping="Wrap" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#0E131C" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="Klinische Interpretation:" FontWeight="Bold" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3"/>
                                        <TextBlock Text="• Ein kontinuierlicher, moderater Gradient von proximal nach distal ist physiologisch normal." FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,1"/>
                                        <TextBlock Text="• Ein sprunghafter Abfall (> 2.5 K) deutet auf eine fokal verminderte Mikrozirkulation oder Ischämie hin." FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,1"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- TAB 10: LUA CLINICAL RULE ENGINE -->
                    <TabItem Header="📜 Leitlinien (Lua)">
