                                            </StackPanel>
                                        </Border>

                                        <!-- K-Factor Slider -->
                                        <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6">
                                                    <TextBlock Text="Schwellenwert-Faktor (Standard: 3.0)" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                                    <Border HorizontalAlignment="Right" Background="#F1F5F9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,3">
                                                        <TextBlock Text="{Binding ElementName=SliderK, Path=Value, StringFormat={}{0:F1}}" FontWeight="Bold" Foreground="{StaticResource CyanBrush}" FontSize="11"/>
                                                    </Border>
                                                </Grid>
                                                <Slider x:Name="SliderK" Minimum="1.5" Maximum="5.0" Value="3.0" SmallChange="0.1" ValueChanged="SliderK_ValueChanged"/>
                                            </StackPanel>
                                        </Border>

