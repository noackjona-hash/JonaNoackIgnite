                                                <TextBlock Text="HARDWARE-LATENZ (AVX2 SIMD GEMESSEN)" FontWeight="Bold" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                                <TextBlock x:Name="TxtTissuePixels" Text="Gewebe-Pixel: 236.450" Margin="0,4,0,2" FontSize="11"/>
                                                <TextBlock x:Name="TxtHotspotCount" Text="Gefundene Herde: 3" Margin="0,2" FontSize="11"/>
                                                <TextBlock x:Name="TxtLatency" Text="Rechenzeit: 271,4 ms (AVX2 SIMD: 25.4 ms)" Margin="0,2" FontSize="11" Foreground="{StaticResource CyanBrush}" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>



                            <!-- TAB 2: DETECTED HOTSPOTS TABLE -->
                            <TabItem>
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconMicroscope}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0" SnapsToDevicePixels="True"/>
                                        <TextBlock Text="Herde" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </TabItem.Header>
                                <Grid Margin="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="Klinisch auffällige Entzündungsareale (Hyperthermie):" FontWeight="Bold" Margin="0,0,0,8" Foreground="{StaticResource CyanBrush}" FontSize="12"/>

                                    <DataGrid Grid.Row="1" x:Name="GridHotspots" SelectionChanged="GridHotspots_SelectionChanged">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="ID" Binding="{Binding Region.Id}" Width="35"/>
                                            <DataGridTextColumn Header="Fläche" Binding="{Binding Region.AreaPixels}" Width="50"/>
                                            <DataGridTextColumn Header="Max T" Binding="{Binding Region.MaxVal}" Width="45"/>
                                            <DataGridTextColumn Header="Zirkul." Binding="{Binding Region.Circularity, StringFormat={}{0:F2}}" Width="50"/>
                                            <DataGridTextColumn Header="Klassifikation" Binding="{Binding DisplayDiagnosisType}" Width="125" FontWeight="SemiBold"/>
                                            <DataGridTextColumn Header="Risiko" Binding="{Binding Assessment.RiskLevel}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <Border Grid.Row="2" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,10,0,0">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Differentialdiagnose (Druckstelle vs. Entzündung):" FontWeight="Bold" FontSize="11" Foreground="{StaticResource CyanBrush}"/>
                                                <Border Grid.Column="1" x:Name="BadgeDiagnosisType" Background="#26FFB300" BorderBrush="#FFB300" BorderThickness="1" CornerRadius="6" Padding="6,2">
                                                    <TextBlock x:Name="TxtDiagnosisBadge" Text="DIFFERENTIAL-ANALYSE" FontSize="9" FontWeight="Bold" Foreground="#FFB300"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock x:Name="TxtLuaRecommendation" Text="Wählen Sie einen Herd aus der Tabelle..." TextWrapping="Wrap" Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </TabItem>

                            <!-- TAB 3: 256-BIN RADIOMETRIC HISTOGRAM -->
                            <TabItem x:Name="TabHistogram">
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconRadiometry}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0" SnapsToDevicePixels="True"/>
