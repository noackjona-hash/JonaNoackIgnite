                                                <TextBlock x:Name="TxtBiomechDirectives" Text="• Regelmäßige Druckmessung und radiometrische Kontrolle empfohlen." TextWrapping="Wrap" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2"/>
                                                <TextBlock Text="• Ab 320 kPa: Diabetesschutzschuhwerk mit retrokapitaler Entlastungsrolle" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2"/>
                                                <TextBlock Text="• Ab 450 kPa: Akutes Ulkus-Breakdown-Risiko. Vollentlastung oder Walker erforderlich" FontSize="10" Foreground="{StaticResource CriticalBrush}" Margin="0,2"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <!-- TAB: 3D-OBERFLÄCHEN-REKONSTRUKTION & LAMBERT-KANTENKORREKTUR -->
                            <TabItem x:Name="Tab3DReconstruction">
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconRelief}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0" SnapsToDevicePixels="True"/>
                                        <TextBlock Text="3D-Kanten" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </TabItem.Header>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="3D-Anatomische Rekonstruktion &amp; Kantenkorrektur" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource CyanBrush}" Margin="0,0,0,2"/>
                                        <TextBlock Text="Kompensation des physikalischen Randabfalls durch schräge Einstrahlwinkel θ und Lambert'sche Emissivitätsminderung ε(θ)." FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"/>

                                        <!-- 3D KPI Banner -->
                                        <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6">
                                                    <TextBlock Text="MAX. OBERFLÄCHEN-WÖLBUNG (Z_max):" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                                    <Border HorizontalAlignment="Right" Background="#E0F2FE" BorderBrush="{StaticResource CyanBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1">
                                                        <TextBlock x:Name="Txt3DStatusBadge" Text="LAMBERT KOMPENSIERT" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource CyanBrush}"/>
                                                    </Border>
                                                </Grid>
                                                <TextBlock x:Name="Txt3DMaxDepth" Text="-- mm" FontSize="26" FontWeight="Black" Foreground="{StaticResource CyanBrush}" Margin="0,2,0,2"/>
                                                <TextBlock x:Name="Txt3DCompensationSummary" Text="Mittlere Randkorrektur: ΔT = -- K | Pixel: --" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- 3D Metrics Grid -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,4,0">
                                                <StackPanel>
                                                    <TextBlock Text="MAX. EINSTRAHLWINKEL (θ_max)" FontSize="9" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                                                    <TextBlock x:Name="Txt3DMaxAngle" Text="-- °" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="1" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="4,0,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="KOMPENSIERTE PIXEL" FontSize="9" FontWeight="Bold" Foreground="{StaticResource CyanBrush}"/>
                                                    <TextBlock x:Name="Txt3DPixelCount" Text="-- px" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- 3D Curvature Metrics Grid -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,4,0">
                                                <StackPanel>
                                                    <TextBlock Text="MITTLERE KRÜMMUNG (H)" FontSize="9" FontWeight="Bold" Foreground="{StaticResource CyanBrush}"/>
                                                    <TextBlock x:Name="Txt3DMeanCurv" Text="-- mm⁻¹" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="1" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="4,0,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="GAUSSSCHE KRÜMMUNG (K)" FontSize="9" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                                                    <TextBlock x:Name="Txt3DGaussCurv" Text="-- mm⁻²" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Physical Model Explanation Card -->
                                        <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="Physikalische Korrekturformeln:" FontWeight="Bold" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                                <TextBlock Text="• Tiefe: Z(x,y) = Z_peak · [0.5 sin(u π/2) + 0.5 √(1 - (1-u)²)]^0.65" FontSize="10" FontFamily="Consolas" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="• Glättung: Poisson-Laplace Relaxation ∇²Z = 0 (organische Wölbung)" FontSize="10" FontFamily="Consolas" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                                <TextBlock Text="• Radiometrie: ε(θ)/ε₀ = (1 - R_Fresnel(θ))/(1 - R₀) [LWIR n=1.34]" FontSize="10" FontFamily="Consolas" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                                <TextBlock Text="• Stefan-Boltzmann: T_korr = T_app · (ε₀/ε(θ))^0.25 + ΔT_Tiefe(Z)" FontSize="10" FontFamily="Consolas" Foreground="{StaticResource CyanBrush}" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Action Buttons -->
                                        <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="3D-Projektionen im Viewport:" FontWeight="Bold" FontSize="11" Margin="0,0,0,8"/>
                                                <Button Click="BtnView3DAnatomy_Click" Style="{StaticResource VoicemodPrimaryButtonStyle}" Margin="0,0,0,6">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource IconRelief}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" SnapsToDevicePixels="True"/>
                                                        <TextBlock Text="3D-Anatomie mit Kantenkorrektur anzeigen" VerticalAlignment="Center"/>
