<Window x:Class="Ignite.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IGNITE Medical Imaging Suite v5.0.0 [Jugend forscht 2026] — Next-Gen AI Thermografie-Cockpit"
        Height="980" Width="1620"
        Background="{StaticResource AppBgBrush}" Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Display, Segoe UI, Arial"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Next-Gen Brand Header -->
            <RowDefinition Height="Auto"/> <!-- 1: Menu Bar -->
            <RowDefinition Height="Auto"/> <!-- 2: Clinical Ergonomic Toolbar -->
            <RowDefinition Height="*"/>    <!-- 3: Main Dual-Viewport & Inspector -->
            <RowDefinition Height="Auto"/> <!-- 4: Bottom Filmstrip Case Gallery -->
            <RowDefinition Height="28"/>   <!-- 5: Status Bar -->
        </Grid.RowDefinitions>

        <!-- 0. NEXT-GEN MEDICAL BRAND HEADER -->
        <Border Grid.Row="0" Background="#0A0D15" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Branding & Core Badges -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" Background="#0F1829" BorderBrush="{StaticResource CyanBrush}" BorderThickness="1.5" CornerRadius="6" Margin="0,0,12,0">
                        <TextBlock Text="🩺" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="IGNITE" FontWeight="Black" FontSize="18" Foreground="{StaticResource CyanBrush}"/>
                            <TextBlock Text=" AI WORKSTATION" FontWeight="Bold" FontSize="18" Foreground="#FFFFFF" Margin="4,0,0,0"/>
                            <Border Background="#102540" BorderBrush="{StaticResource CyanBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="10,0,0,0">
                                <TextBlock Text="v5.0.0 AVX2" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource CyanBrush}"/>
                            </Border>
                            <Border Background="#2C163D" BorderBrush="{StaticResource PurpleBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="6,0,0,0">
                                <TextBlock Text="Jugend forscht 2026" FontSize="10.5" FontWeight="Bold" Foreground="#D8B4FE"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Deterministische Thermografie: Top-Hat Morphologie · Vaskulärer Frangi-Filter · Armstrong Ulzera-Prävention" 
                                   FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Center: AI Diagnostic Summary Chip -->
                <Border Grid.Column="1" HorizontalAlignment="Center" Background="#0F1420" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="BadgeAiStatusDot" Width="8" Height="8" Background="{StaticResource SuccessBrush}" CornerRadius="4" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtHeaderAiStatus" Text="AI BEFUND: SYSTEM BEREIT" FontWeight="Bold" FontSize="11.5" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        <Separator Width="1" Height="14" Margin="12,0" Background="{StaticResource BorderBrush}"/>
                        <TextBlock x:Name="PatientIdText" Text="PATIENT: ANON-7F3A9" FontSize="11" Foreground="{StaticResource CyanBrush}" VerticalAlignment="Center"/>
                        <Separator Width="1" Height="14" Margin="12,0" Background="{StaticResource BorderBrush}"/>
                        <TextBlock Text="DSGVO Art. 30: SQLITE SHA-256" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Right: Performance Telemetry -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#0E1B2E" BorderBrush="{StaticResource CyanBrush}" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚡" Margin="0,0,4,0" FontSize="11"/>
                            <TextBlock x:Name="EngineTimingText" Text="Go Core: 169.5 ms (AVX2)" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource CyanBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#121622" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,3">
                        <TextBlock Text="SIMD: 32 Pixel/Takt" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1. MAIN MENU BAR -->
        <Menu Grid.Row="1" Background="#080A0F" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="6,2">
            <MenuItem Header="_Datei">
                <MenuItem Header="_Wärmebild öffnen..." Click="MenuOpenImage_Click" InputGestureText="Strg+O"/>
                <MenuItem Header="_Zweites Bild für Seitenvergleich..." Click="MenuOpenContralateral_Click"/>
                <Separator Background="{StaticResource BorderBrush}"/>
                <MenuItem Header="_Befundbericht exportieren (HTML/JSON)..." Click="MenuExportReport_Click"/>
                <Separator Background="{StaticResource BorderBrush}"/>
                <MenuItem Header="_Beenden" Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="_Diagnostik">
                <MenuItem Header="1. Entzündungs-Detektor (Top-Hat &amp; MAD)" Click="ModeInflammation_Click"/>
                <MenuItem Header="2. Venen- &amp; Gefäßkartierung (Frangi-Hesse)" Click="ModeVascular_Click"/>
                <MenuItem Header="3. Perfusion &amp; Temperaturgradient (dT/dy)" Click="ModePerfusion_Click"/>
                <MenuItem Header="4. Bilateraler Seitenvergleich (Armstrong ΔT >= 2.2K)" Click="ModeBilateral_Click"/>
            </MenuItem>
            <MenuItem Header="_Falschfarben &amp; Fensterung">
                <MenuItem Header="Ironbow (Standard Medizin)" Click="PaletteIronbow_Click"/>
                <MenuItem Header="Rainbow / Spektral" Click="PaletteRainbow_Click"/>
                <MenuItem Header="Inferno" Click="PaletteInferno_Click"/>
                <MenuItem Header="Monochrom Graustufen" Click="PaletteGray_Click"/>
            </MenuItem>
            <MenuItem Header="_Werkzeuge">
                <MenuItem Header="_DSGVO-Auditprotokoll anzeigen" Click="MenuAuditLog_Click"/>
                <MenuItem Header="_Lua-Regel-Editor öffnen" Click="MenuLuaEditor_Click"/>
                <MenuItem Header="_Hardware-Benchmark (AVX2 vs Skalar)" Click="MenuBenchmark_Click"/>
            </MenuItem>
            <MenuItem Header="_Hilfe">
                <MenuItem Header="_Über IGNITE v5.0.0 (Jugend Forscht)..." Click="MenuAbout_Click"/>
                <MenuItem Header="_Methodische Dokumentation" Click="MenuDocs_Click"/>
            </MenuItem>
        </Menu>

        <!-- 2. CLINICAL ACTION TOOLBAR -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Clustered Modern Controls -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    
                    <!-- Cluster 1: Interactive Tool Selector -->
                    <Border Background="#0A0E17" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="2" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="RbToolPan" Style="{StaticResource MedicalToolRadioStyle}" GroupName="CanvasTools" Content="✋ Pan/Zoom" IsChecked="True" Checked="ToolRadio_Checked" ToolTip="Freies Verschieben &amp; stufenloses Zoomen mit Mausrad oder rechter Maustaste"/>
                            <RadioButton x:Name="RbToolRoi" Style="{StaticResource MedicalToolRadioStyle}" GroupName="CanvasTools" Content="✂️ ROI" Checked="ToolRadio_Checked" ToolTip="Rechteck zur gezielten Analyse von Zehe, Ferse oder Areal aufziehen"/>
                            <RadioButton x:Name="RbToolProfile" Style="{StaticResource MedicalToolRadioStyle}" GroupName="CanvasTools" Content="📏 Profil T(s)" Checked="ToolRadio_Checked" ToolTip="Linie über das Gewebe ziehen für 2D-Temperaturdiagramm &amp; Gradient |dT/ds|"/>
                            <RadioButton x:Name="RbToolProbe" Style="{StaticResource MedicalToolRadioStyle}" GroupName="CanvasTools" Content="📍 Sonden" Checked="ToolRadio_Checked" ToolTip="Punkt-Messpins setzen &amp; bilateralen Armstrong ΔT-Ulkuswert sofort berechnen"/>
                            <RadioButton x:Name="RbToolWL" Style="{StaticResource MedicalToolRadioStyle}" GroupName="CanvasTools" Content="🌓 W/L" Checked="ToolRadio_Checked" ToolTip="Linke Maustaste ziehen für interaktive Fensterung (Breite horizontal / Level vertikal)"/>
                        </StackPanel>
                    </Border>

                    <!-- Cluster 2: Viewport Mode Selector -->
                    <Border Background="#0A0E17" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="2" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="RbViewDual" Style="{StaticResource MedicalToolRadioStyle}" GroupName="ViewModes" Content="🖼️ Dual" IsChecked="True" Checked="ViewMode_Checked" ToolTip="Synchronisierte Doppelansicht: Original und diagnostischer Befund"/>
                            <RadioButton x:Name="RbViewCurtain" Style="{StaticResource MedicalToolRadioStyle}" GroupName="ViewModes" Content="🌓 Vorhang-Wipe" Checked="ViewMode_Checked" ToolTip="Interaktiver Schiebe-Vorhang: Ziehen Sie die Trennlinie zwischen Rohbild und Gefäß-/Entzündungsbefund"/>
                            <RadioButton x:Name="RbView3DRelief" Style="{StaticResource MedicalToolRadioStyle}" GroupName="ViewModes" Content="🏔️ 3D-Relief" Checked="ViewMode_Checked" ToolTip="Topographische 2.5D Höhenkarte: Heißes Entzündungsgewebe erhebt sich dreidimensional mit Relief-Schattierung"/>
                            <RadioButton x:Name="RbViewDSA" Style="{StaticResource MedicalToolRadioStyle}" GroupName="ViewModes" Content="🩸 DSA Angio" Checked="ViewMode_Checked" ToolTip="Reine Angiographie (Digital Subtraction Angiography): Dunkler Hintergrund mit leuchtendem Gefäßbaum"/>
                        </StackPanel>
                    </Border>

                    <!-- Actions -->
                    <Button Content="📂 Bild laden" Click="MenuOpenImage_Click" Background="#161D2B" BorderBrush="{StaticResource MedicalBlueBrush}"/>
                    <Button Content="⚡ Berechnen" Click="BtnRunAnalysis_Click" Background="#2563EB" Foreground="White" FontWeight="Bold"/>

                    <Separator Width="1" Height="20" Margin="6,0" Background="{StaticResource BorderBrush}"/>

                    <Button Content="⚖️ Füße trennen" Click="BtnAutoSplitFeet_Click" ToolTip="Trennt Extremitäten automatisch &amp; berechnet bilateralen Armstrong-Vergleich"/>
                    <Button Content="✂️ Reset ROI" Click="BtnResetROI_Click" ToolTip="Entfernt benutzerdefinierte Bereichsauswahl"/>
                    <Button Content="🗑️ Reset Messung" Click="BtnResetProbes_Click" ToolTip="Entfernt gesetzte Sonden und das aktuelle Schnittprofil"/>

                    <Separator Width="1" Height="20" Margin="6,0" Background="{StaticResource BorderBrush}"/>

                    <!-- Clinical Examination Presets -->
                    <TextBlock Text="Preset:" VerticalAlignment="Center" Margin="2,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                    <ComboBox x:Name="ComboPreset" Width="170" SelectionChanged="ComboPreset_SelectionChanged" Background="#101420" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11">
                        <ComboBoxItem Content="-- Klinisches Preset --" IsSelected="True"/>
                        <ComboBoxItem Content="🦶 Diabetischer Fuß (Armstrong)"/>
                        <ComboBoxItem Content="🩸 Gefäßbaum / DSA (Frangi)"/>
                        <ComboBoxItem Content="🔥 Akute Entzündung (Top-Hat)"/>
                        <ComboBoxItem Content="❄️ Ischämie-Verdacht (Perfusion)"/>
                    </ComboBox>

                    <Separator Width="1" Height="20" Margin="6,0" Background="{StaticResource BorderBrush}"/>

                    <!-- Viewport Toggles -->
                    <CheckBox x:Name="ChkSyncViewports" Content="🔗 Synchron" IsChecked="True" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="4,0" FontSize="11" ToolTip="Synchronisiert Zoom und Verschiebung beider Viewports simultan"/>
                    <CheckBox x:Name="ChkMinMaxTracker" Content="🎯 Min/Max" IsChecked="True" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="4,0" FontSize="11" Click="ChkMinMaxTracker_Click" ToolTip="Hebt automatisch absolut kälteste und heißeste Gewebestelle mit Fadenkreuz hervor"/>
                    <CheckBox x:Name="ChkEnableVeinOverlay" Content="🩸 Venen" IsChecked="True" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="4,0" FontSize="11" Click="ChkEnableVeinOverlay_Click" ToolTip="Schaltet das Frangi-Gefäßoverlay ein oder aus"/>

                    <Separator Width="1" Height="20" Margin="6,0" Background="{StaticResource BorderBrush}"/>

                    <!-- Color Palette Dropdown -->
                    <TextBlock Text="LUT:" VerticalAlignment="Center" Margin="2,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                    <ComboBox x:Name="ComboPalette" Width="110" SelectionChanged="ComboPalette_SelectionChanged" Background="#101420" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11">
                        <ComboBoxItem Content="Ironbow" IsSelected="True"/>
                        <ComboBoxItem Content="Rainbow"/>
                        <ComboBoxItem Content="Inferno"/>
                        <ComboBoxItem Content="Graustufen"/>
                    </ComboBox>

                    <Separator Width="1" Height="20" Margin="6,0" Background="{StaticResource BorderBrush}"/>

                    <!-- Zoom Controls -->
                    <Button Content="🔍 +" Click="BtnZoomIn_Click" Width="30" Padding="0"/>
                    <Button Content="100%" Click="BtnZoomReset_Click" Width="40" Padding="0"/>
                    <Button Content="🔍 -" Click="BtnZoomOut_Click" Width="30" Padding="0"/>
                    <Button Content="↔ Fit" Click="BtnZoomFit_Click" Width="38" Padding="0"/>
                </StackPanel>

                <!-- Center: Animated Progress Bar -->
                <ProgressBar Grid.Column="1" x:Name="AnalysisProgressBar" Height="3" IsIndeterminate="True" Foreground="{StaticResource CyanBrush}" Background="Transparent" BorderThickness="0" Margin="14,0" Visibility="Collapsed" VerticalAlignment="Center"/>

                <!-- Right: Report Export Button -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="💾 Befund exportieren" Click="MenuExportReport_Click" Background="#102540" Foreground="{StaticResource CyanBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. WORKSTATION MAIN DUAL VIEWPORT & DOCKING INSPECTOR -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="520"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="470" MinWidth="380"/>
            </Grid.ColumnDefinitions>

            <!-- DUAL VIEWPORT WORKBENCH -->
            <Grid Grid.Column="0" Background="#06080D">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Sub-Header showing Viewport Titles -->
                <Border Grid.Row="0" Background="#0F131D" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="8" Height="8" Background="{StaticResource CyanBrush}" CornerRadius="2" Margin="0,0,6,0"/>
                            <TextBlock Text="PRIMÄR-RADIOMETRIE (EINGANGS-THERMOGRAMM)" FontWeight="Bold" FontSize="11" Foreground="{StaticResource CyanBrush}"/>
                            <TextBlock x:Name="TxtToolHintVp1" Text=" · Mausrad = Zoom | Ziehen = Verschieben" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="6,0,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="8" Height="8" Background="{StaticResource SuccessBrush}" CornerRadius="2" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtVp2Title" Text="DIAGNOSTISCHER BEFUND (OVERLAYS &amp; VENEN)" FontWeight="Bold" FontSize="11" Foreground="{StaticResource SuccessBrush}"/>
                            <TextBlock x:Name="TxtResultSubtitle" Text=" · Go AVX2 Engine" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Split Viewports with DICOM HUD Overlays -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ColViewport1" Width="*"/>
                        <ColumnDefinition x:Name="ColDivider" Width="1"/>
                        <ColumnDefinition x:Name="ColViewport2" Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- VIEWPORT 1 (Original Thermal Image + Interactive Vectors) -->
                    <Grid Grid.Column="0" Background="#04060A" ClipToBounds="True">
                        <ScrollViewer x:Name="ScrollOriginal" 
                                      HorizontalScrollBarVisibility="Auto" 
                                      VerticalScrollBarVisibility="Auto"
                                      PreviewMouseWheel="Viewport_PreviewMouseWheel"
                                      ScrollChanged="ScrollOriginal_ScrollChanged">
                            <Grid x:Name="CanvasOriginal" 
                                  Background="Transparent"
                                  MouseDown="ViewportOriginal_MouseDown" 
                                  MouseMove="ViewportOriginal_MouseMove" 
                                  MouseUp="ViewportOriginal_MouseUp" 
                                  MouseLeave="ViewportOriginal_MouseLeave">
                                <Image x:Name="ImgOriginal" Stretch="None"/>
                                <Canvas x:Name="OverlayOriginalCanvas" IsHitTestVisible="False"/>
                            </Grid>
                        </ScrollViewer>

                        <!-- DICOM Corner HUD Overlays -->
                        <Grid IsHitTestVisible="False" Margin="10">
                            <TextBlock Text="PATIENT: ANON-7F3A9&#x0a;MODUS: IR-THERM" FontSize="9.5" FontFamily="Consolas, Segoe UI" Foreground="#88FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <TextBlock x:Name="HudVp1TopRight" Text="MATRIX: 1440x1080&#x0a;ZOOM: 100%" FontSize="9.5" FontFamily="Consolas, Segoe UI" Foreground="#88FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Top" TextAlignment="Right"/>
                            <TextBlock x:Name="HudVp1BottomLeft" Text="LUT: IRONBOW&#x0a;W/L: 255 / 128" FontSize="9.5" FontFamily="Consolas, Segoe UI" Foreground="#8800F0FF" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                            <TextBlock Text="STATUS: KALIBRIERT&#x0a;FLIR / INFRATEC" FontSize="9.5" FontFamily="Consolas, Segoe UI" Foreground="#8800F0FF" HorizontalAlignment="Right" VerticalAlignment="Bottom" TextAlignment="Right"/>
                        </Grid>
                    </Grid>

                    <!-- Viewport Divider -->
                    <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Stretch" Background="#1E273A"/>

                    <!-- VIEWPORT 2 (Diagnostic Befund / Curtain Wipe / 3D Relief) -->
                    <Grid Grid.Column="2" Background="#04060A" ClipToBounds="True">
                        <ScrollViewer x:Name="ScrollResult" 
                                      HorizontalScrollBarVisibility="Auto" 
                                      VerticalScrollBarVisibility="Auto"
                                      PreviewMouseWheel="Viewport_PreviewMouseWheel"
                                      ScrollChanged="ScrollResult_ScrollChanged">
                            <Grid x:Name="CanvasResult" 
                                  Background="Transparent"
                                  MouseDown="ViewportResult_MouseDown"
                                  MouseMove="ViewportResult_MouseMove" 
                                  MouseUp="ViewportResult_MouseUp"
                                  MouseLeave="Viewport_MouseLeave">
                                <!-- Base Image (Diagnostic Result / Overlays / 3D Relief) -->
                                <Image x:Name="ImgResult" Stretch="None"/>

                                <!-- Curtain Wipe Layer (Raw Thermogram under clipping mask) -->
                                <Image x:Name="ImgCurtainRaw" Stretch="None" Visibility="Collapsed">
                                    <Image.Clip>
                                        <RectangleGeometry x:Name="CurtainClipRect" Rect="0,0,0,0"/>
                                    </Image.Clip>
                                </Image>

                                <!-- Vector Overlays Canvas -->
                                <Canvas x:Name="OverlayResultCanvas" IsHitTestVisible="False"/>

                                <!-- Interactive Curtain Divider Line & Handle -->
                                <Canvas x:Name="CanvasCurtain" Visibility="Collapsed" IsHitTestVisible="True">
                                    <Line x:Name="LineCurtain" Stroke="{StaticResource CyanBrush}" StrokeThickness="2" StrokeDashArray="3,2"/>
                                    <Border x:Name="BorderCurtainHandle" Width="34" Height="34" Background="#E60E1B2E" BorderBrush="{StaticResource CyanBrush}" BorderThickness="1.5" CornerRadius="17" Cursor="SizeWE" MouseDown="CurtainHandle_MouseDown">
                                        <TextBlock Text="◀ 🌓 ▶" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource CyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Canvas>
                            </Grid>
                        </ScrollViewer>

                        <!-- Floating Armstrong High-Alert Banner -->
                        <Border x:Name="FloatingArmstrongBanner" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0" 
                                Background="#E6D32F2F" BorderBrush="#FFEB3B" BorderThickness="1.5" CornerRadius="4" Padding="12,5" IsHitTestVisible="False">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚠️ " FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtFloatingArmstrong" Text="ARMSTRONG-WARNUNG: ΔT = 2.8 K (≥ 2.2 K) — Hohes Ulkusrisiko!" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- DICOM Corner HUD Overlays -->
                        <Grid IsHitTestVisible="False" Margin="10">
                            <TextBlock Text="DIAGNOSTIK: FRANGI + TOP-HAT&#x0a;ENGINE: x86_64 AVX2" FontSize="9.5" FontFamily="Consolas, Segoe UI" Foreground="#88FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <TextBlock x:Name="HudVp2TopRight" Text="KLASSIFIKATION: LUA 5.1&#x0a;AUDIT: SQLITE SHA-256" FontSize="9.5" FontFamily="Consolas, Segoe UI" Foreground="#88FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Top" TextAlignment="Right"/>
                            <TextBlock x:Name="HudVp2BottomLeft" Text="OVERLAYS: 🩸 VENEN + 🔥 HERDE&#x0a;ARMSTRONG ΔT &gt;= 2.2K" FontSize="9.5" FontFamily="Consolas, Segoe UI" Foreground="#8800E676" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                            <TextBlock Text="AUTONOM / DETERMINISTISCH&#x0a;JUGEND FORSCHT 2026" FontSize="9.5" FontFamily="Consolas, Segoe UI" Foreground="#8800E676" HorizontalAlignment="Right" VerticalAlignment="Bottom" TextAlignment="Right"/>
                        </Grid>

                        <!-- Floating Calibrated Temperature Scale Bar -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" 
                                Background="#D00F1420" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="5,6">
                            <StackPanel Width="32" HorizontalAlignment="Center">
                                <TextBlock Text="42°C" FontSize="8.5" FontWeight="Bold" Foreground="#FF3B5B" HorizontalAlignment="Center"/>
                                <Border Height="120" Width="10" Margin="0,4" CornerRadius="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FFFFFF" Offset="0.0"/>
                                            <GradientStop Color="#FFFF00" Offset="0.2"/>
                                            <GradientStop Color="#FF0000" Offset="0.45"/>
                                            <GradientStop Color="#800080" Offset="0.75"/>
                                            <GradientStop Color="#000080" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <TextBlock Text="20°C" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource CyanBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- SPLITTER -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#0A0E17"/>

            <!-- RIGHT DOCKING INSPECTOR PANEL -->
            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <TabControl x:Name="InspectorTabs" Background="Transparent" BorderThickness="0">
                    
                    <!-- TAB 1: PARAMETER & FENSTERUNG (W/L) -->
                    <TabItem Header="⚙️ Parameter">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Diagnostische Pipeline-Parameter" FontWeight="Bold" FontSize="13" Foreground="{StaticResource CyanBrush}" Margin="0,0,0,10"/>

                                <!-- Window / Level Contrast Controls -->
                                <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="DICOM Fensterung (Window / Level):" FontWeight="Bold" FontSize="11" Margin="0,0,0,4"/>
                                        <Grid Margin="0,2">
                                            <TextBlock Text="Fensterbreite (Kontrast W):" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock x:Name="TxtWindowWidth" Text="255" HorizontalAlignment="Right" FontWeight="Bold" Foreground="{StaticResource CyanBrush}" FontSize="10.5"/>
                                        </Grid>
                                        <Slider x:Name="SliderWindowWidth" Minimum="40" Maximum="255" Value="255" SmallChange="5" ValueChanged="SliderWindowWidth_ValueChanged"/>

                                        <Grid Margin="0,4,0,0">
                                            <TextBlock Text="Fensterzentrum (Helligkeit L):" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock x:Name="TxtWindowLevel" Text="128" HorizontalAlignment="Right" FontWeight="Bold" Foreground="{StaticResource CyanBrush}" FontSize="10.5"/>
                                        </Grid>
                                        <Slider x:Name="SliderWindowLevel" Minimum="20" Maximum="235" Value="128" SmallChange="5" ValueChanged="SliderWindowLevel_ValueChanged"/>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                            <Button Content="Standard" Click="BtnWLReset_Click" Padding="6,2" FontSize="10"/>
                                            <Button Content="Gewebe-Boost" Click="BtnWLSoftTissue_Click" Padding="6,2" FontSize="10" Margin="4,0,0,0"/>
                                            <Button Content="Hotspot-Fokus" Click="BtnWLHotspot_Click" Padding="6,2" FontSize="10" Margin="4,0,0,0"/>
