                                                <TextBlock x:Name="TxtHotspotCount" Text="Gefundene Herde: --" Margin="0,2" FontSize="11"/>
                                                <TextBlock x:Name="TxtLatency" Text="Rechenzeit: -- ms" Margin="0,2" FontSize="11" Foreground="{StaticResource CyanBrush}" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <!-- TAB 3: DETECTED HOTSPOTS TABLE -->
                            <TabItem Header="🔬 Herde">
                                <Grid Margin="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="Klinisch auffällige Entzündungsareale (Hyperthermie):" FontWeight="Bold" Margin="0,0,0,8" Foreground="{StaticResource CyanBrush}" FontSize="12"/>

                                    <DataGrid Grid.Row="1" x:Name="GridHotspots" SelectionChanged="GridHotspots_SelectionChanged">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="ID" Binding="{Binding Region.Id}" Width="35"/>
                                            <DataGridTextColumn Header="Fläche" Binding="{Binding Region.AreaPixels}" Width="55"/>
                                            <DataGridTextColumn Header="Anteil %" Binding="{Binding Region.AreaPercent, StringFormat={}{0:F2}%}" Width="60"/>
                                            <DataGridTextColumn Header="Max T" Binding="{Binding Region.MaxVal}" Width="45"/>
                                            <DataGridTextColumn Header="Zirkul." Binding="{Binding Region.Circularity, StringFormat={}{0:F2}}" Width="50"/>
                                            <DataGridTextColumn Header="Risiko" Binding="{Binding Assessment.RiskLevel}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <Border Grid.Row="2" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,10,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Klinische Lua-Bewertung des ausgewählten Herds:" FontWeight="Bold" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock x:Name="TxtLuaRecommendation" Text="Wählen Sie einen Herd aus der Tabelle..." TextWrapping="Wrap" Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </TabItem>

                            <!-- TAB 4: 256-BIN RADIOMETRIC HISTOGRAM -->
                            <TabItem x:Name="TabHistogram" Header="📊 Spektrum">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="Radiometrisches Dichtespektrum (256-Kanal)" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource CyanBrush}" Margin="0,0,0,2"/>
                                        <TextBlock Text="Temperaturverteilung mit statistischen Trennlinien für Median und MAD-Ausreißer." FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"/>

                                        <!-- KPI Grid -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8,6" Margin="0,0,3,0">
                                                <StackPanel>
                                                    <TextBlock Text="MEDIAN T" FontSize="9" FontWeight="Bold" Foreground="{StaticResource CyanBrush}"/>
                                                    <TextBlock x:Name="TxtHistoMedian" Text="-- °C" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="1" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8,6" Margin="3,0">
                                                <StackPanel>
                                                    <TextBlock Text="MAD STREUUNG" FontSize="9" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                                                    <TextBlock x:Name="TxtHistoMad" Text="-- K" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="2" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8,6" Margin="3,0,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="SCHWELLE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource CriticalBrush}"/>
                                                    <TextBlock x:Name="TxtHistoThreshold" Text="-- °C" FontSize="14" FontWeight="Bold" Foreground="{StaticResource CriticalBrush}"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Histogram Canvas -->
                                        <Border Background="#06090F" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="6" Height="190">
                                            <Canvas x:Name="CanvasHistogram" ClipToBounds="True" Background="#06090F" SizeChanged="CanvasHistogram_SizeChanged"/>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <!-- TAB 5: THERMAL LINE PROFILE T(s) -->
                            <TabItem x:Name="TabProfile" Header="📈 Profil T(s)">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="Thermisches Schnittprofil T(s)" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource CyanBrush}" Margin="0,0,0,2"/>
                                        <TextBlock Text="Temperaturverlauf entlang des gezogenen Messvektors." FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"/>

                                        <!-- KPI Grid -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8,6" Margin="0,0,3,0">
                                                <StackPanel>
                                                    <TextBlock Text="T MIN" FontSize="9" FontWeight="Bold" Foreground="{StaticResource CyanBrush}"/>
                                                    <TextBlock x:Name="TxtProfileMinTemp" Text="-- °C" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="1" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8,6" Margin="3,0">
                                                <StackPanel>
                                                    <TextBlock Text="T MAX" FontSize="9" FontWeight="Bold" Foreground="{StaticResource CriticalBrush}"/>
                                                    <TextBlock x:Name="TxtProfileMaxTemp" Text="-- °C" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="2" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8,6" Margin="3,0,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="T MITTEL" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <TextBlock x:Name="TxtProfileMeanTemp" Text="-- °C" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10,6" Margin="0,0,0,10">
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock x:Name="TxtProfileLength" Text="Pfadlänge: -- px" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock x:Name="TxtProfileMaxGrad" Text="Maximaler Gradient: -- K/px" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Button HorizontalAlignment="Right" Content="CSV KOPIEREN" Click="BtnCopyProfileCsv_Click" Padding="8,3" FontSize="10"/>
                                            </Grid>
                                        </Border>

                                        <!-- Vector Graph -->
                                        <Border Background="#06090F" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="6" Height="200">
                                            <Canvas x:Name="CanvasProfileGraph" ClipToBounds="True" Background="#06090F" SizeChanged="CanvasProfileGraph_SizeChanged"/>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <!-- TAB 6: POINT TEMPERATURE PROBES -->
                            <TabItem x:Name="TabProbes" Header="📍 Sonden">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="Klinische Punkt-Temperatursonden (P₁ ... Pn)" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource CyanBrush}" Margin="0,0,0,2"/>
                                        <TextBlock Text="Manuelle Platzierung von Messsonden für bilateralen Armstrong-Seitenvergleich." FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"/>

                                        <!-- Armstrong Delta T Callout Card -->
                                        <Border x:Name="BorderArmstrongRiskCard" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="ARMSTRONG-VERGLEICH (P₁ vs P₂):" FontWeight="Bold" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                                    <Border x:Name="BadgeArmstrongState" HorizontalAlignment="Right" Background="#122538" BorderBrush="{StaticResource CyanBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1">
                                                        <TextBlock x:Name="TxtProbeRiskBadge" Text="KEINE DATEN" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource CyanBrush}"/>
                                                    </Border>
                                                </Grid>
                                                <TextBlock x:Name="TxtProbeDeltaT" Text="ΔT = -- K" FontSize="22" FontWeight="Black" Foreground="{StaticResource CyanBrush}" Margin="0,4,0,2"/>
                                                <TextBlock x:Name="TxtProbeAssessment" Text="Klicken Sie im Bild auf zwei homologe Stellen." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Probes List -->
                                        <TextBlock Text="Gesetzte Messpunkte:" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>
                                        <DataGrid x:Name="GridProbes" MaxHeight="170">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Sonde" Binding="{Binding Label}" Width="50"/>
                                                <DataGridTextColumn Header="X" Binding="{Binding Position.X, StringFormat={}{0:F0}}" Width="45"/>
                                                <DataGridTextColumn Header="Y" Binding="{Binding Position.Y, StringFormat={}{0:F0}}" Width="45"/>
                                                <DataGridTextColumn Header="Raw" Binding="{Binding RawVal}" Width="45"/>
                                                <DataGridTextColumn Header="Temperatur" Binding="{Binding Temperature, StringFormat={}{0:F1} °C}" Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <Button Content="SONDEN ZURÜCKSETZEN" Click="BtnResetProbes_Click" HorizontalAlignment="Right" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <!-- TAB 7: ANATOMISCHE FUSS-ZONEN MATRIX -->
                            <TabItem x:Name="TabAnatomy" Header="🦶 5-Zonen">
                                <Grid Margin="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                        <TextBlock Text="Anatomische Zonen-Matrix (Armstrong-Pflock-Zonen)" FontWeight="Bold" FontSize="13" Foreground="{StaticResource CyanBrush}"/>
                                        <TextBlock Text="Automatisierte Segmentierung der Extremität in 5 funktionelle Belastungszonen." FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>

                                    <DataGrid Grid.Row="1" x:Name="GridAnatomicalZones">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Anatomische Zone" Binding="{Binding ZoneName}" Width="135"/>
                                            <DataGridTextColumn Header="Links °C" Binding="{Binding MeanTempLeft, StringFormat={}{0:F1}}" Width="60"/>
                                            <DataGridTextColumn Header="Rechts °C" Binding="{Binding MeanTempRight, StringFormat={}{0:F1}}" Width="60"/>
                                            <DataGridTextColumn Header="ΔT (K)" Binding="{Binding DeltaT, StringFormat={}{0:F1}}" Width="50"/>
                                            <DataGridTextColumn Header="Klinischer Status" Binding="{Binding RiskAssessment}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <Border Grid.Row="2" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,10,0,0">
                                        <TextBlock Text="• Bei Asymmetrie ΔT ≥ 2.2 K ist Entlastung durch orthopädisches Schuhwerk erforderlich." FontSize="10.5" Foreground="{StaticResource CriticalBrush}"/>
                                    </Border>
                                </Grid>
                            </TabItem>

                            <!-- TAB 7B: 6 TAYLOR-PALMER ANGIOSOMES -->
                            <TabItem x:Name="TabAngiosomes" Header="🩺 Angiosome">
                                <Grid Margin="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="Taylor &amp; Palmer Angiosom-Gefäßterritorien (6 Territorien)" FontWeight="Bold" FontSize="13" Foreground="{StaticResource CyanBrush}" Margin="0,0,0,8"/>

                                    <DataGrid Grid.Row="1" x:Name="GridAngiosomes">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="45"/>
                                            <DataGridTextColumn Header="Territorium" Binding="{Binding TerritoryName}" Width="130"/>
                                            <DataGridTextColumn Header="Arterie" Binding="{Binding FeederArtery}" Width="140"/>
                                            <DataGridTextColumn Header="T Mean" Binding="{Binding MeanTemp, StringFormat={}{0:F1} °C}" Width="55"/>
                                            <DataGridTextColumn Header="ΔT" Binding="{Binding DeltaT, StringFormat={}{0:F1} K}" Width="45"/>
                                            <DataGridTextColumn Header="Befund" Binding="{Binding PerfusionStatus}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </TabItem>

                            <!-- TAB 7C: PREDICTIVE 7-DAY ULCER RISK FORECASTER -->
                            <TabItem x:Name="TabPrediction" Header="🔮 Prädiktion">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="Multivariates 7-Tage Ulzerations-Risikomodell" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource CyanBrush}" Margin="0,0,0,2"/>
                                        <TextBlock Text="Prädiktive Wahrscheinlichkeitsrechnung basierend auf Armstrong-Delta &amp; Laplace-THDI." FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"/>

                                        <!-- KPI Risk Banner -->
                                        <Border Background="#1C1524" BorderBrush="{StaticResource CriticalBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="7-TAGE ULKUS-WAHRSCHEINLICHKEIT:" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                                    <TextBlock x:Name="TxtPredProbability" Text="-- %" FontSize="26" FontWeight="Black" Foreground="{StaticResource CriticalBrush}" Margin="0,2,0,0"/>
                                                    <TextBlock x:Name="TxtPredTier" Text="KEINE DATEN" FontSize="11" FontWeight="Bold" Foreground="#FCA5A5" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" VerticalAlignment="Center" Background="#122538" BorderBrush="{StaticResource CyanBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8">
                                                    <StackPanel>
                                                        <TextBlock Text="ARMSTRONG" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                                        <TextBlock x:Name="TxtPredStage" Text="Grad 0" FontSize="13" FontWeight="Bold" Foreground="{StaticResource CyanBrush}" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Laplace THDI & ANS -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,4,0">
                                                <StackPanel>
                                                    <TextBlock Text="WÄRMESTAU-INDEX (THDI)" FontSize="9" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                                                    <TextBlock x:Name="TxtPredThdi" Text="-- K/px²" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="1" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="4,0,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="AUTONOME NEUROPATHIE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource CyanBrush}"/>
                                                    <TextBlock x:Name="TxtPredAns" Text="-- / 10" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
                                            <StackPanel>
                                                <TextBlock Text="Charcot-Arthropathie Frühwarnung:" FontWeight="Bold" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"/>
                                                <TextBlock x:Name="TxtPredCharcot" Text="Unauffällig" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,6"/>
                                                <TextBlock Text="Sofortige Klinische Intervention:" FontWeight="Bold" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"/>
                                                <TextBlock x:Name="TxtPredIntervention" Text="Pipeline ausführen für prädiktive Risikoeinschätzung..." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource CyanBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <!-- TAB 7D: ISOTHERMEN & DIGITAL SUBTRACTION (DST) -->
                            <TabItem x:Name="TabIsotherms" Header="🌐 Isothermen">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="Isothermen-Band &amp; Digital Subtraction (DST)" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource CyanBrush}" Margin="0,0,0,2"/>
                                        <TextBlock Text="Selektive farbliche Isolierung definierter Temperaturkorridore." FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"/>

                                        <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6">
                                                    <TextBlock Text="Isothermes Temperatur-Band:" FontWeight="Bold" FontSize="11"/>
                                                    <Border HorizontalAlignment="Right" Background="#111520" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,3">
                                                        <TextBlock x:Name="TxtIsothermRange" Text="32.0 °C - 36.0 °C" FontWeight="Bold" Foreground="{StaticResource CyanBrush}" FontSize="11"/>
                                                    </Border>
                                                </Grid>
                                                
                                                <TextBlock Text="Untere Schwelle:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,2"/>
                                                <Slider x:Name="SliderIsothermLow" Minimum="20.0" Maximum="38.0" Value="32.0" SmallChange="0.5" ValueChanged="SliderIsotherm_ValueChanged" Margin="0,0,0,8"/>

                                                <TextBlock Text="Obere Schwelle:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,2"/>
                                                <Slider x:Name="SliderIsothermHigh" Minimum="24.0" Maximum="42.0" Value="36.0" SmallChange="0.5" ValueChanged="SliderIsotherm_ValueChanged"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6">
                                                    <TextBlock Text="Digital Subtraction Thermography:" FontWeight="Bold" FontSize="11"/>
                                                    <Border HorizontalAlignment="Right" Background="#111520" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,3">
                                                        <TextBlock x:Name="TxtDstOffset" Text="-1.2 K (Besserung)" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" FontSize="11"/>
                                                    </Border>
                                                </Grid>
                                                <Slider x:Name="SliderDstOffset" Minimum="-3.0" Maximum="3.0" Value="-1.2" SmallChange="0.2" ValueChanged="SliderDst_ValueChanged"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <!-- TAB 8: BILATERAL SYMMETRY (ARMSTRONG) -->
                            <TabItem Header="⚖️ Bilateral">
                                <Grid Margin="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="Bilateraler Armstrong-Seitenvergleich (ΔT >= 2.2 K)" FontWeight="Bold" FontSize="13" Foreground="{StaticResource CyanBrush}" Margin="0,0,0,8"/>

                                    <DataGrid Grid.Row="1" x:Name="GridSymmetry">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Zone" Binding="{Binding Name}" Width="140"/>
                                            <DataGridTextColumn Header="Links Mean" Binding="{Binding LeftMean, StringFormat={}{0:F1}}" Width="70"/>
                                            <DataGridTextColumn Header="Rechts Mean" Binding="{Binding RightMean, StringFormat={}{0:F1}}" Width="70"/>
                                            <DataGridTextColumn Header="ΔT (K)" Binding="{Binding DeltaT, StringFormat={}{0:F1}}" Width="50"/>
                                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <Border Grid.Row="2" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,10,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Armstrong-Gesamtbeurteilung:" FontWeight="Bold" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock x:Name="TxtSymmetryAssessment" Text="Klicken Sie auf 'Extremitäten trennen'..." TextWrapping="Wrap" Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </TabItem>

                            <!-- TAB 9: PERFUSION ANALYSIS -->
                            <TabItem Header="📉 Perfusion">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="Longitudinale Perfusionsanalyse (dT/dy)" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource CyanBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="Temperaturgradient entlang der anatomischen Achse zur Erkennung distaler Durchblutungsabbrüche." 
                                                   TextWrapping="Wrap" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"/>

                                        <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock x:Name="TxtPerfusionStatus" Text="STATUS: --" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock x:Name="TxtPerfusionDrop" Text="Maximaler Gradientenabfall: -- K/Zeile" FontSize="11.5" Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <Separator Margin="0,8" Background="{StaticResource BorderBrush}"/>
                                                <TextBlock x:Name="TxtPerfusionDesc" Text="Keine Daten. Bitte zuerst Pipeline ausführen." TextWrapping="Wrap" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <!-- TAB 10: LUA CLINICAL RULE ENGINE -->
                            <TabItem Header="📜 Leitlinien (Lua)">
                                <Grid Margin="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="Klinische Entscheidungslogik (Eingebettetes Lua 5.1):" FontWeight="Bold" Margin="0,0,0,6" Foreground="{StaticResource CyanBrush}" FontSize="12"/>

                                    <TextBox Grid.Row="1" x:Name="TxtLuaCode" 
                                             FontFamily="Consolas, Cascadia Code, Courier New" FontSize="11.5" 
                                             Background="#06090F" Foreground="#A9B7C6" BorderBrush="{StaticResource BorderBrush}"
                                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>

                                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                        <Button Content="STANDARD WIEDERHERSTELLEN" Click="BtnResetLua_Click"/>
                                        <Button Content="REGEL SPEICHERN &amp; ANWENDEN" Click="BtnApplyLua_Click" Style="{StaticResource VoicemodPrimaryButtonStyle}" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </TabItem>

                            <!-- TAB 11: AUDIT TRAIL (SQLITE) -->
                            <TabItem Header="🗄️ DSGVO Audit">
                                <Grid Margin="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="DSGVO Art. 30 Evaluationsprotokoll (SQLite):" FontWeight="Bold" Margin="0,0,0,6" Foreground="{StaticResource CyanBrush}" FontSize="12"/>

                                    <DataGrid Grid.Row="1" x:Name="GridAudit">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="30"/>
                                            <DataGridTextColumn Header="Zeitstempel" Binding="{Binding Timestamp}" Width="125"/>
                                            <DataGridTextColumn Header="Patient" Binding="{Binding PatientId}" Width="90"/>
                                            <DataGridTextColumn Header="Modus" Binding="{Binding AnalysisType}" Width="110"/>
                                            <DataGridTextColumn Header="Herde" Binding="{Binding HotspotsFound}" Width="45"/>
                                            <DataGridTextColumn Header="Max ΔT" Binding="{Binding MaxDeltaT, StringFormat={}{0:F1} K}" Width="60"/>
                                            <DataGridTextColumn Header="Risiko" Binding="{Binding RiskLevel}" Width="75"/>
                                            <DataGridTextColumn Header="Laufzeit" Binding="{Binding ExecutionTimeMs, StringFormat={}{0:F1} ms}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </TabItem>

                        </TabControl>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============================================================ -->
            <!-- ROW 3: BOTTOM PACS FILMSTRIP GALLERY                         -->
            <!-- ============================================================ -->
            <Border Grid.Row="3" x:Name="FilmstripContainer" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <Border Grid.Row="0" Background="#0F131E" Padding="12,2">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📁 KLINISCHE SERIE &amp; TESTFÄLLE (PACS ARCHIV)" FontWeight="Bold" FontSize="10.5" Foreground="{StaticResource CyanBrush}"/>
                                <TextBlock x:Name="TxtFilmstripCount" Text=" (21 Patientenfälle)" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="4,0,0,0"/>
                                <TextBlock Text=" · 1 Klick zum sofortigen Laden" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="10,0,0,0"/>
                            </StackPanel>
                            <Button x:Name="BtnToggleFilmstrip" HorizontalAlignment="Right" Content="Ausblenden" Click="BtnToggleFilmstrip_Click" Padding="6,1" FontSize="9.5" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Grid>
                    </Border>
                    
                    <ScrollViewer Grid.Row="1" x:Name="ScrollFilmstrip" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="8,8">
                        <StackPanel x:Name="PanelFilmstrip" Orientation="Horizontal"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ============================================================ -->
            <!-- ROW 4: STATUS & TELEMETRY BAR                                -->
            <!-- ============================================================ -->
            <Border Grid.Row="4" Background="#080A10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="●" Foreground="{StaticResource CyanBrush}" FontSize="9" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText" Text="Bereit für radiologische Befundung. Bild laden oder Fall aus Filmstrip wählen." FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="SIMD x86_64 AVX2 256-Bit (32 Pixel/Takt)" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="16,0"/>

                    <TextBlock Grid.Column="2" x:Name="CursorCoordsText" Text="X: --, Y: -- | Temp: --" FontSize="10.5" Foreground="{StaticResource CyanBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
