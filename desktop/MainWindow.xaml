                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{StaticResource IconExport}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0"/>
