                                                </Grid>
                                                <TextBlock Text="Messen Sie den Hallux-Valgus-Winkel (HVA) durch 3-Punkt-Klick (1. Schaft MT-I, 2. Gelenk MTP-I Scheitelpunkt, 3. Hallux)." FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                                <Button Click="BtnActivateGoniometerTool_Click" Style="{StaticResource VoicemodPrimaryButtonStyle}" Margin="0,0,0,8">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Path Data="{StaticResource IconGoniometer}" Fill="#FFFFFF" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0"/>
                                                        <TextBlock Text="Goniometer-Werkzeug aktivieren" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>

                                                <!-- Angle Value Display Grid -->
                                                <Grid Margin="0,0,0,6">
