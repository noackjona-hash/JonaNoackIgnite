                                                    <TextBlock Text="Fensterzentrum (Helligkeit L)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                    <Border HorizontalAlignment="Right" Background="#111520" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,3">
                                                        <TextBlock x:Name="TxtWindowLevel" Text="128" FontWeight="Bold" Foreground="{StaticResource CyanBrush}" FontSize="11"/>
                                                    </Border>
                                                </Grid>
                                                <Slider x:Name="SliderWindowLevel" Minimum="20" Maximum="235" Value="128" SmallChange="5" ValueChanged="SliderWindowLevel_ValueChanged" Margin="0,0,0,10"/>

                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Content="Standard" Click="BtnWLReset_Click" Padding="8,3" FontSize="10.5"/>
                                                    <Button Content="Gewebe-Boost" Click="BtnWLSoftTissue_Click" Padding="8,3" FontSize="10.5" Margin="4,0,0,0"/>
                                                    <Button Content="Hotspot-Fokus" Click="BtnWLHotspot_Click" Padding="8,3" FontSize="10.5" Margin="4,0,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- K-Factor Slider -->
                                        <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6">
                                                    <TextBlock Text="Schwellenwert-Faktor k (Standard: 3.0)" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                                    <Border HorizontalAlignment="Right" Background="#111520" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,3">
                                                        <TextBlock Text="{Binding ElementName=SliderK, Path=Value, StringFormat={}{0:F1}}" FontWeight="Bold" Foreground="{StaticResource CyanBrush}" FontSize="11"/>
                                                    </Border>
                                                </Grid>
                                                <Slider x:Name="SliderK" Minimum="1.5" Maximum="5.0" Value="3.0" SmallChange="0.1" ValueChanged="SliderK_ValueChanged"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Kernel Radius Slider -->
                                        <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6">
                                                    <TextBlock Text="Top-Hat Kernel-Radius" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                                    <Border HorizontalAlignment="Right" Background="#111520" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,3">
                                                        <TextBlock Text="{Binding ElementName=SliderKernel, Path=Value, StringFormat={}{0:P0}}" FontWeight="Bold" Foreground="{StaticResource CyanBrush}" FontSize="11"/>
                                                    </Border>
                                                </Grid>
                                                <Slider x:Name="SliderKernel" Minimum="0.01" Maximum="0.12" Value="0.05" SmallChange="0.01" ValueChanged="SliderKernel_ValueChanged"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Threshold Mode Selector -->
                                        <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="Statistisches Modell:" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6"/>
                                                <ComboBox x:Name="ComboThresholdMode" SelectedIndex="0">
                                                    <ComboBoxItem Content="Robustes MAD (Median Absolute Deviation) — Empfohlen"/>
                                                    <ComboBoxItem Content="Gauß-Verteilung (Mittelwert ± k*Sigma)"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </Border>

                                        <!-- Clinical Feature Toggles -->
                                        <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Text="Klinische Module:" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6"/>
                                                <CheckBox x:Name="ChkFrangi" Content="Venenkartierung aktivieren (Frangi-Hesse)" IsChecked="True" Margin="0,3"/>
                                                <CheckBox x:Name="ChkPerfusion" Content="Longitudinaler Temperaturgradient (dT/dy)" IsChecked="True" Margin="0,3"/>
                                                <CheckBox x:Name="ChkAnatomicalCutoff" Content="Anatomischer Cutoff (Waden oberhalb 65%)" IsChecked="True" Margin="0,3"/>
                                                <CheckBox x:Name="ChkErodeMargin" Content="Gewebekanten-Erosion (Chamfer-Distanz)" IsChecked="True" Margin="0,3"/>
                                            </StackPanel>
                                        </Border>

                                        <Button Content="GESAMTE PIPELINE NEU BERECHNEN" Click="BtnRunAnalysis_Click" Style="{StaticResource VoicemodPrimaryButtonStyle}" Margin="0,0,0,10"/>

                                        <!-- Hardware SIMD Latency Card -->
                                        <Border Background="#10141E" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12">
                                            <StackPanel>
                                                <TextBlock Text="HARDWARE-LATENZ (AVX2 SIMD GEMESSEN)" FontWeight="Bold" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
