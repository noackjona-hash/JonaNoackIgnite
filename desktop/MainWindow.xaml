                                    </StackPanel>
                                </TabItem.Header>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="Biomechanische Plantardruck- &amp; Scherspannungsschätzung" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource CyanBrush}" Margin="0,0,0,2"/>
                                        <TextBlock Text="Thermodynamische Druck- und Scherspannungsschätzung (Pennes-Bioheat-Modell, kPa) zur Lokalisierung ulzerationsgefährdeter Druckspitzen." FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"/>

                                        <!-- Peak Pressure KPI Banner -->
                                        <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6">
                                                    <TextBlock Text="SPITZENDRUCK (P_peak):" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                                    <Border x:Name="BadgeBiomechRisk" HorizontalAlignment="Right" Background="#E0F2FE" BorderBrush="{StaticResource CyanBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1">
                                                        <TextBlock x:Name="TxtBiomechRiskCategory" Text="PHYSIOLOGISCH NORMAL" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource CyanBrush}"/>
                                                    </Border>
                                                </Grid>
                                                <TextBlock x:Name="TxtBiomechPeakPressure" Text="-- kPa" FontSize="26" FontWeight="Black" Foreground="{StaticResource CriticalBrush}" Margin="0,2,0,2"/>
                                                <TextBlock x:Name="TxtBiomechPeakLoc" Text="Peak-Lokalisation: X = --, Y = --" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Pressure Metrics Grid -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,4,0">
                                                <StackPanel>
                                                    <TextBlock Text="MITTLERER SOHLENDRUCK" FontSize="9" FontWeight="Bold" Foreground="{StaticResource CyanBrush}"/>
                                                    <TextBlock x:Name="TxtBiomechMeanPressure" Text="-- kPa" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="1" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="4,0,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="GEFÄHRDETE FLÄCHE (≥450 kPa)" FontSize="9" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                                                    <TextBlock x:Name="TxtBiomechHighRiskArea" Text="-- px" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Quick Action Filters -->
                                        <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="Spezial-Projektionen im Viewport:" FontWeight="Bold" FontSize="11" Margin="0,0,0,8"/>
                                                <Button Click="BtnViewPressureProxy_Click" Style="{StaticResource VoicemodPrimaryButtonStyle}" Margin="0,0,0,6">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource IconPressure}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" SnapsToDevicePixels="True"/>
                                                        <TextBlock Text="Biomechanische Druck-Map anzeigen" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Click="BtnViewLaplace_Click" Padding="10,6" Margin="0,0,0,4">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource IconLaplace}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" SnapsToDevicePixels="True"/>
                                                        <TextBlock Text="2D-Laplace Wärmestau-Filter (∇²T) anzeigen" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Border>

                                        <!-- Digital Orthopedic Goniometer Card -->
                                        <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6">
                                                    <TextBlock Text="Orthopädisches Goniometer (HVA / IMA):" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
