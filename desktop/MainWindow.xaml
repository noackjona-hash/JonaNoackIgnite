                            <!-- TAB 8: PREDICTIVE 7-DAY ULCER RISK FORECASTER -->
                            <TabItem x:Name="TabPrediction">
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconShield}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0" SnapsToDevicePixels="True"/>
