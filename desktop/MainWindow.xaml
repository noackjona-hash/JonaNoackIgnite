<Window x:Class="Ignite.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IGNITE Medical Workstation · DFU Diagnostics (DIN EN ISO 13485 Research Grade) · FLIR IR-Sensor"
        Height="980" Width="1620"
        Background="{StaticResource AppBgBrush}" Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI, -apple-system, Arial"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Clinical Hospital & Patient Banner -->
            <RowDefinition Height="Auto"/> <!-- 1: Medical Menu Bar -->
            <RowDefinition Height="Auto"/> <!-- 2: Clinical Console Toolbar -->
            <RowDefinition Height="*"/>    <!-- 3: Main Dual-Viewport & Medical Inspector -->
            <RowDefinition Height="Auto"/> <!-- 4: Bottom PACS Series / Case Strip -->
            <RowDefinition Height="28"/>   <!-- 5: Clinical Status & Telemetry Bar -->
        </Grid.RowDefinitions>

        <!-- ============================================================ -->
        <!-- 0. CLINICAL HOSPITAL & PATIENT DEMOGRAPHIC BANNER (DIN/DICOM) -->
        <!-- ============================================================ -->
        <Border Grid.Row="0" Background="#0A0E17" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Clinic & Station Identification -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" Background="#111A28" BorderBrush="{StaticResource CyanBrush}" BorderThickness="1" CornerRadius="3" Margin="0,0,12,0">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Clean Medical Cross Shape -->
                            <Rectangle Width="6" Height="22" Fill="{StaticResource CyanBrush}"/>
                            <Rectangle Width="22" Height="6" Fill="{StaticResource CyanBrush}"/>
                        </Grid>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="IGNITE PACS" FontWeight="Black" FontSize="17" Foreground="{StaticResource CyanBrush}"/>
                            <TextBlock Text=" · MEDICAL WORKSTATION" FontWeight="SemiBold" FontSize="17" Foreground="#E2E8F0" Margin="4,0,0,0"/>
                            <Border Background="#122538" BorderBrush="{StaticResource CyanBrush}" BorderThickness="1" CornerRadius="3" Padding="6,1" Margin="10,0,0,0">
                                <TextBlock Text="AVX2 SIMD" FontSize="10" FontWeight="Bold" Foreground="{StaticResource CyanBrush}"/>
                            </Border>
                            <Border Background="#1C2538" BorderBrush="{StaticResource BorderBrightBrush}" BorderThickness="1" CornerRadius="3" Padding="6,1" Margin="6,0,0,0">
                                <TextBlock Text="DIN EN ISO 13485 CONFORM" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Abteilung für Diabetologie &amp; Angiologie · Früherkennung diabetischer Fußulzera (IWGDF Leitlinie)" 
                                   FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Center: Clinical Patient Demographics Banner -->
                <Border Grid.Column="1" HorizontalAlignment="Center" Background="#111722" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="14,4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="BadgeAiStatusDot" Width="9" Height="9" Background="{StaticResource SuccessBrush}" CornerRadius="2" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtHeaderAiStatus" Text="TRIAGE: NORMALBEFUND (GRAD 0)" FontWeight="Bold" FontSize="11.5" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                        <Separator Width="1" Height="14" Margin="12,0" Background="{StaticResource BorderBrush}"/>
                        <TextBlock x:Name="PatientIdText" Text="PATIENT: MUSTERN, GERHARD (M, *1958)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource CyanBrush}" VerticalAlignment="Center"/>
                        <Separator Width="1" Height="14" Margin="12,0" Background="{StaticResource BorderBrush}"/>
                        <TextBlock Text="FALL: DFS-2026-8812" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <Separator Width="1" Height="14" Margin="12,0" Background="{StaticResource BorderBrush}"/>
                        <TextBlock Text="DSGVO ART. 30: AUDIT GESICHERT" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Right: Telemetry & Acquisition Info -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#0F1B2B" BorderBrush="{StaticResource CyanBrush}" BorderThickness="1" CornerRadius="3" Padding="8,3" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="CORE:" Margin="0,0,5,0" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock x:Name="EngineTimingText" Text="14.8 ms (AVX2 SIMD)" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource CyanBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#121824" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="8,3">
                        <TextBlock Text="KALIBRIERUNG: NIST-TRACEABLE" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- 1. CLINICAL MEDICAL MENU BAR                                 -->
        <!-- ============================================================ -->
        <Menu Grid.Row="1" Background="#0A0D14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="6,2">
            <MenuItem Header="_Studie / Akquisition">
                <MenuItem Header="_Neues Wärmebild öffnen..." Click="MenuOpenImage_Click" InputGestureText="Strg+O"/>
                <MenuItem Header="_Kontralaterales Bild laden (Bilateraler Vergleich)..." Click="MenuOpenContralateral_Click"/>
                <Separator Background="{StaticResource BorderBrush}"/>
                <MenuItem Header="_Ärztlichen Befundbericht exportieren (PDF/HTML)..." Click="MenuExportReport_Click"/>
                <Separator Background="{StaticResource BorderBrush}"/>
                <MenuItem Header="_Beenden" Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="_Diagnostik-Verfahren">
                <MenuItem Header="1. Entzündungs-Detektion (Top-Hat Morphologie &amp; MAD)" Click="ModeInflammation_Click"/>
                <MenuItem Header="2. Vaskuläre Gefäßkartierung (Frangi-Hesse Matrix)" Click="ModeVascular_Click"/>
                <MenuItem Header="3. Perfusion &amp; Longitudinaler Temperaturgradient (dT/dy)" Click="ModePerfusion_Click"/>
                <MenuItem Header="4. Bilateraler Armstrong-Seitenvergleich (ΔT >= 2.2K)" Click="ModeBilateral_Click"/>
            </MenuItem>
            <MenuItem Header="_Fensterung &amp; Farbtabelle">
                <MenuItem Header="Medical Ironbow (Standard Diagnostik)" Click="PaletteIronbow_Click"/>
                <MenuItem Header="Medical Rainbow (Spektrale Isothermen)" Click="PaletteRainbow_Click"/>
                <MenuItem Header="Inferno (Kontrastverstärkt)" Click="PaletteInferno_Click"/>
                <MenuItem Header="Monochrom Graustufen (DICOM GSDF)" Click="PaletteGray_Click"/>
            </MenuItem>
            <MenuItem Header="_Leitlinien &amp; Compliance">
                <MenuItem Header="_DSGVO Art. 30 Audit-Protokoll einsehen" Click="MenuAuditLog_Click"/>
                <MenuItem Header="_Klinische Lua-Entscheidungsregeln (IWGDF/DDG)" Click="MenuLuaEditor_Click"/>
                <MenuItem Header="_Hardware-Benchmark (AVX2 Vektor vs Skalar)" Click="MenuBenchmark_Click"/>
            </MenuItem>
            <MenuItem Header="_Dokumentation &amp; Info">
                <MenuItem Header="_Über IGNITE Medical Workstation (Jugend forscht 2026)..." Click="MenuAbout_Click"/>
                <MenuItem Header="_Wissenschaftliche &amp; Methodische Dokumentation" Click="MenuDocs_Click"/>
            </MenuItem>
        </Menu>

        <!-- ============================================================ -->
        <!-- 2. CLINICAL CONSOLE TOOLBAR (STANDARD MEDICAL PACS CLUSTERS)  -->
        <!-- ============================================================ -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Clustered Console Controls -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    
                    <!-- Cluster 1: Interactive Tool Selector -->
                    <Border Background="#0C1018" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="2" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="RbToolPan" Style="{StaticResource MedicalToolRadioStyle}" GroupName="CanvasTools" Content="PAN / ZOOM" IsChecked="True" Checked="ToolRadio_Checked" ToolTip="Verschieben &amp; stufenloses Zoomen mit Mausrad oder rechter Maustaste"/>
                            <RadioButton x:Name="RbToolRoi" Style="{StaticResource MedicalToolRadioStyle}" GroupName="CanvasTools" Content="ROI RECHTECK" Checked="ToolRadio_Checked" ToolTip="Rechteck zur gezielten Analyse von Zehe, Ferse oder Areal aufziehen"/>
                            <RadioButton x:Name="RbToolProfile" Style="{StaticResource MedicalToolRadioStyle}" GroupName="CanvasTools" Content="PROFIL dT/ds" Checked="ToolRadio_Checked" ToolTip="Messlinie über das Gewebe ziehen für transversalen Temperaturverlauf"/>
                            <RadioButton x:Name="RbToolProbe" Style="{StaticResource MedicalToolRadioStyle}" GroupName="CanvasTools" Content="SONDEN P1-Pn" Checked="ToolRadio_Checked" ToolTip="Punkt-Messsonden platzieren &amp; bilateralen Armstrong ΔT-Ulkuswert berechnen"/>
                            <RadioButton x:Name="RbToolWL" Style="{StaticResource MedicalToolRadioStyle}" GroupName="CanvasTools" Content="W/L FENSTER" Checked="ToolRadio_Checked" ToolTip="Maus ziehen für interaktive DICOM-Fensterung (Breite / Zentrum)"/>
                        </StackPanel>
                    </Border>

                    <!-- Cluster 2: Viewport Mode Selector -->
                    <Border Background="#0C1018" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="2" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="RbViewDual" Style="{StaticResource MedicalToolRadioStyle}" GroupName="ViewModes" Content="DUAL VIEW" IsChecked="True" Checked="ViewMode_Checked" ToolTip="Synchronisierte Doppelansicht: Primär-Thermogramm und diagnostischer Befund"/>
                            <RadioButton x:Name="RbViewCurtain" Style="{StaticResource MedicalToolRadioStyle}" GroupName="ViewModes" Content="VORHANG-SPLIT" Checked="ViewMode_Checked" ToolTip="Interaktiver Schiebe-Vorhang: Ziehen Sie die Trennlinie zwischen Rohbild und Befund-Overlay"/>
                            <RadioButton x:Name="RbView3DRelief" Style="{StaticResource MedicalToolRadioStyle}" GroupName="ViewModes" Content="3D-TOPOGRAFIE" Checked="ViewMode_Checked" ToolTip="2.5D Isometrisches Relief: Heißes Entzündungsgewebe erhebt sich dreidimensional mit Hillshading"/>
                            <RadioButton x:Name="RbViewDSA" Style="{StaticResource MedicalToolRadioStyle}" GroupName="ViewModes" Content="DSA-ANGIO" Checked="ViewMode_Checked" ToolTip="Digitale Subtraktions-Angiographie: Isolierter Gefäßbaum auf dunklem Hintergrund"/>
                            <RadioButton x:Name="RbViewIsotherm" Style="{StaticResource MedicalToolRadioStyle}" GroupName="ViewModes" Content="ISOTHERM" Checked="ViewMode_Checked" ToolTip="Isothermen-Slicing: Isoliert gezielt einen Temperaturkorridor in Farbe"/>
                            <RadioButton x:Name="RbViewDST" Style="{StaticResource MedicalToolRadioStyle}" GroupName="ViewModes" Content="SUBTRAKTION DST" Checked="ViewMode_Checked" ToolTip="Digital Subtraction Thermography: Verlaufsvergleich &amp; Therapiekontrolle"/>
                        </StackPanel>
                    </Border>

                    <!-- Clinical Actions -->
                    <Button Content="BILD LADEN" Click="MenuOpenImage_Click" Background="#141B28" BorderBrush="{StaticResource BorderBrightBrush}"/>
                    <Button Content="DIAGNOSE STARTEN" Click="BtnRunAnalysis_Click" Background="#1D4ED8" Foreground="White" FontWeight="Bold"/>

                    <Separator Width="1" Height="20" Margin="6,0" Background="{StaticResource BorderBrush}"/>

                    <Button Content="EXTREMITÄTEN TRENNEN" Click="BtnAutoSplitFeet_Click" ToolTip="Trennt Extremitäten automatisch &amp; berechnet bilateralen Armstrong-Vergleich"/>
                    <Button Content="RESET ROI" Click="BtnResetROI_Click" ToolTip="Entfernt Bereichsauswahl"/>
                    <Button Content="RESET SONDEN" Click="BtnResetProbes_Click" ToolTip="Entfernt gesetzte Messpins und Schnittprofil"/>

                    <Separator Width="1" Height="20" Margin="6,0" Background="{StaticResource BorderBrush}"/>

                    <!-- Clinical Examination Presets -->
                    <TextBlock Text="PRESET:" VerticalAlignment="Center" Margin="2,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10.5" FontWeight="SemiBold"/>
                    <ComboBox x:Name="ComboPreset" Width="180" SelectionChanged="ComboPreset_SelectionChanged" Background="#101520" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11">
                        <ComboBoxItem Content="-- Standard Diagnostik --" IsSelected="True"/>
                        <ComboBoxItem Content="Diabetischer Fuß (Armstrong DFS)"/>
                        <ComboBoxItem Content="Vaskulär / Angiographie (Frangi)"/>
                        <ComboBoxItem Content="Akute Hyperthermie (Top-Hat)"/>
                        <ComboBoxItem Content="Periphere Ischämie (Perfusion)"/>
                    </ComboBox>

                    <Separator Width="1" Height="20" Margin="6,0" Background="{StaticResource BorderBrush}"/>

                    <!-- Viewport Toggles -->
                    <CheckBox x:Name="ChkSyncViewports" Content="Synchron" IsChecked="True" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="4,0" FontSize="11" ToolTip="Synchronisiert Zoom und Verschiebung beider Viewports simultan"/>
                    <CheckBox x:Name="ChkMinMaxTracker" Content="Min/Max Marker" IsChecked="True" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="4,0" FontSize="11" Click="ChkMinMaxTracker_Click" ToolTip="Hebt kälteste und heißeste Gewebestelle mit Fadenkreuz hervor"/>
                    <CheckBox x:Name="ChkEnableVeinOverlay" Content="Frangi-Venen" IsChecked="True" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="4,0" FontSize="11" Click="ChkEnableVeinOverlay_Click" ToolTip="Schaltet das Frangi-Gefäßoverlay ein oder aus"/>

                    <Separator Width="1" Height="20" Margin="6,0" Background="{StaticResource BorderBrush}"/>

                    <!-- Color Palette Dropdown -->
                    <TextBlock Text="LUT:" VerticalAlignment="Center" Margin="2,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10.5" FontWeight="SemiBold"/>
                    <ComboBox x:Name="ComboPalette" Width="105" SelectionChanged="ComboPalette_SelectionChanged" Background="#101520" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11">
                        <ComboBoxItem Content="Ironbow" IsSelected="True"/>
                        <ComboBoxItem Content="Rainbow"/>
                        <ComboBoxItem Content="Inferno"/>
                        <ComboBoxItem Content="Graustufen"/>
                    </ComboBox>

                    <Separator Width="1" Height="20" Margin="6,0" Background="{StaticResource BorderBrush}"/>

                    <!-- Zoom Controls -->
                    <Button Content="-" Click="BtnZoomOut_Click" Width="26" Padding="0"/>
                    <Button Content="100%" Click="BtnZoomReset_Click" Width="42" Padding="0"/>
                    <Button Content="+" Click="BtnZoomIn_Click" Width="26" Padding="0"/>
                    <Button Content="FIT" Click="BtnZoomFit_Click" Width="36" Padding="0"/>
                </StackPanel>

                <!-- Center: Animated Progress Bar -->
                <ProgressBar Grid.Column="1" x:Name="AnalysisProgressBar" Height="3" IsIndeterminate="True" Foreground="{StaticResource CyanBrush}" Background="Transparent" BorderThickness="0" Margin="14,0" Visibility="Collapsed" VerticalAlignment="Center"/>

                <!-- Right: Report Export Button -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="ARZTSCHRIFTLICHER BEFUND (PDF)" Click="MenuExportReport_Click" Background="#122538" BorderBrush="{StaticResource CyanBrush}" Foreground="{StaticResource CyanBrush}" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- 3. WORKSTATION MAIN DUAL VIEWPORT & CLINICAL INSPECTOR       -->
        <!-- ============================================================ -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="540"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="480" MinWidth="400"/>
            </Grid.ColumnDefinitions>

            <!-- DUAL VIEWPORT WORKBENCH -->
            <Grid Grid.Column="0" Background="#080B11">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Sub-Header showing Viewport Titles & Clinical Status -->
                <Border Grid.Row="0" Background="#0F1420" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="7" Height="7" Background="{StaticResource CyanBrush}" CornerRadius="1" Margin="0,0,6,0"/>
                            <TextBlock Text="PRIMÄR-THERMOGRAMM (UNBEARBEITETE EINGANGS-RADIOMETRIE)" FontWeight="Bold" FontSize="10.5" Foreground="{StaticResource CyanBrush}"/>
                            <TextBlock x:Name="TxtToolHintVp1" Text=" · Mausrad: Zoom | Ziehen: Verschieben" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="6,0,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="7" Height="7" Background="{StaticResource SuccessBrush}" CornerRadius="1" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtVp2Title" Text="DIAGNOSTISCHER BEFUND (VASKULÄR &amp; HYPERTHERMIE)" FontWeight="Bold" FontSize="10.5" Foreground="{StaticResource SuccessBrush}"/>
                            <TextBlock x:Name="TxtResultSubtitle" Text=" · Go AVX2 Engine" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Split Viewports with Full 4-Corner DICOM HUDs -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ColViewport1" Width="*"/>
                        <ColumnDefinition x:Name="ColDivider" Width="1"/>
                        <ColumnDefinition x:Name="ColViewport2" Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- VIEWPORT 1 (Original Thermal Image + Interactive Vectors) -->
                    <Grid Grid.Column="0" Background="#06080E" ClipToBounds="True">
                        <ScrollViewer x:Name="ScrollOriginal" 
                                      HorizontalScrollBarVisibility="Auto" 
                                      VerticalScrollBarVisibility="Auto"
                                      PreviewMouseWheel="Viewport_PreviewMouseWheel"
                                      ScrollChanged="ScrollOriginal_ScrollChanged">
                            <Grid x:Name="CanvasOriginal" 
                                  Background="Transparent"
                                  MouseDown="ViewportOriginal_MouseDown" 
                                  MouseMove="ViewportOriginal_MouseMove" 
                                  MouseUp="ViewportOriginal_MouseUp" 
                                  MouseLeave="ViewportOriginal_MouseLeave">
                                <Image x:Name="ImgOriginal" Stretch="None"/>
                                <Canvas x:Name="OverlayOriginalCanvas" IsHitTestVisible="False"/>
                            </Grid>
                        </ScrollViewer>

                        <!-- DICOM 4-Corner OSD Telemetry -->
                        <Grid IsHitTestVisible="False" Margin="10">
                            <!-- Top Left: Patient & Study Details -->
                            <TextBlock Text="PATIENT: MUSTERN, GERHARD (M)&#x0a;PID: DFS-2026-8812 · 68 J.&#x0a;MODALITÄT: IR-THERMOGRAFIE&#x0a;DATUM: 01.10.2026  14:22:15" 
                                       FontSize="9" FontFamily="Consolas, Segoe UI" Foreground="#B0C4DE" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <!-- Top Right: Sensor & Institutional Setup -->
                            <TextBlock x:Name="HudVp1TopRight" 
                                       Text="DIABETES-ZENTRUM / RADIOLOGIE&#x0a;SENSOR: LWIR 17µm MICROBOLOMETER&#x0a;MATRIX: 640x480 (16-BIT)&#x0a;ZOOM: 100%" 
                                       FontSize="9" FontFamily="Consolas, Segoe UI" Foreground="#B0C4DE" HorizontalAlignment="Right" VerticalAlignment="Top" TextAlignment="Right"/>
                            <!-- Bottom Left: Window / Level & Display Function -->
                            <TextBlock x:Name="HudVp1BottomLeft" 
                                       Text="LUT: IRONBOW MEDICAL GSDF&#x0a;W: 255 (ΔT: 22.0K)  L: 128 (31.0°C)&#x0a;INTERPOLATION: BILINEAR" 
                                       FontSize="9" FontFamily="Consolas, Segoe UI" Foreground="#38BDF8" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                            <!-- Bottom Right: Physical Scale & Calibration -->
                            <TextBlock Text="STATUS: NIST-KALIBRIERT (±0.05°C)&#x0a;FLIR / INFRATEC LWIR&#x0a;MASSTAB: 1 cm ≈ 28.5 px" 
                                       FontSize="9" FontFamily="Consolas, Segoe UI" Foreground="#38BDF8" HorizontalAlignment="Right" VerticalAlignment="Bottom" TextAlignment="Right"/>
                        </Grid>

                        <!-- Physical 50mm Scale Bar Indicator (Medical PACS Standard) -->
                        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,45" IsHitTestVisible="False">
                            <StackPanel Width="142">
                                <TextBlock Text="50 mm" FontSize="8.5" FontFamily="Consolas" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                <Border Height="3" Background="#94A3B8" BorderBrush="#000000" BorderThickness="0.5"/>
                                <Grid>
                                    <Rectangle HorizontalAlignment="Left" Width="1" Height="5" Fill="#94A3B8"/>
                                    <Rectangle HorizontalAlignment="Center" Width="1" Height="5" Fill="#94A3B8"/>
                                    <Rectangle HorizontalAlignment="Right" Width="1" Height="5" Fill="#94A3B8"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Viewport Divider -->
                    <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}"/>

                    <!-- VIEWPORT 2 (Diagnostic Befund / Curtain Wipe / 3D Relief) -->
                    <Grid Grid.Column="2" Background="#06080E" ClipToBounds="True">
                        <ScrollViewer x:Name="ScrollResult" 
                                      HorizontalScrollBarVisibility="Auto" 
                                      VerticalScrollBarVisibility="Auto"
                                      PreviewMouseWheel="Viewport_PreviewMouseWheel"
                                      ScrollChanged="ScrollResult_ScrollChanged">
                            <Grid x:Name="CanvasResult" 
                                  Background="Transparent"
                                  MouseDown="ViewportResult_MouseDown" 
                                  MouseMove="ViewportResult_MouseMove" 
                                  MouseUp="ViewportResult_MouseUp" 
                                  MouseLeave="Viewport_MouseLeave">
                                <!-- Base Image (Diagnostic Result / Overlays / 3D Relief) -->
                                <Image x:Name="ImgResult" Stretch="None"/>

                                <!-- Curtain Wipe Layer (Raw Thermogram under clipping mask) -->
                                <Image x:Name="ImgCurtainRaw" Stretch="None" Visibility="Collapsed">
                                    <Image.Clip>
                                        <RectangleGeometry x:Name="CurtainClipRect" Rect="0,0,0,0"/>
                                    </Image.Clip>
                                </Image>

                                <!-- Vector Overlays Canvas -->
                                <Canvas x:Name="OverlayResultCanvas" IsHitTestVisible="False"/>

                                <!-- Interactive Curtain Divider Line & Handle -->
                                <Canvas x:Name="CanvasCurtain" Visibility="Collapsed" IsHitTestVisible="True">
                                    <Line x:Name="LineCurtain" Stroke="{StaticResource CyanBrush}" StrokeThickness="1.5" StrokeDashArray="3,2"/>
                                    <Border x:Name="BorderCurtainHandle" Width="36" Height="28" Background="#E6101928" BorderBrush="{StaticResource CyanBrush}" BorderThickness="1.5" CornerRadius="3" Cursor="SizeWE" MouseDown="CurtainHandle_MouseDown">
                                        <TextBlock Text="◀ 🌓 ▶" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource CyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Canvas>
                            </Grid>
                        </ScrollViewer>

                        <!-- Floating Armstrong High-Alert Banner -->
                        <Border x:Name="FloatingArmstrongBanner" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0" 
                                Background="#E6DC2626" BorderBrush="#FCD34D" BorderThickness="1.5" CornerRadius="3" Padding="12,5" IsHitTestVisible="False">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚠️ " FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtFloatingArmstrong" Text="ARMSTRONG-WARNUNG: ΔT = 2.8 K (≥ 2.2 K) — Hohes Ulkusrisiko!" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- DICOM 4-Corner OSD Telemetry -->
                        <Grid IsHitTestVisible="False" Margin="10">
                            <!-- Top Left: Pipeline & Algorithm Specs -->
                            <TextBlock Text="BEFUNDUNG: TOP-HAT + FRANGI-HESSE&#x0a;STATISTIK: ROBUSTES MAD (k=3.0)&#x0a;ENGINE: x86_64 AVX2 (256-BIT SIMD)&#x0a;DETERMINISTISCH (REPRODUZIERBAR)" 
                                       FontSize="9" FontFamily="Consolas, Segoe UI" Foreground="#B0C4DE" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <!-- Top Right: Armstrong Diagnostic Classification -->
                            <TextBlock x:Name="HudVp2TopRight" 
                                       Text="KLASSIFIKATION: LEITLINIE IWGDF&#x0a;AUDIT: REVISIONSSICHER SQLITE&#x0a;HASH: SHA-256 SIGNIERT&#x0a;BEWERTUNG: AUTOMATISCH" 
                                       FontSize="9" FontFamily="Consolas, Segoe UI" Foreground="#B0C4DE" HorizontalAlignment="Right" VerticalAlignment="Top" TextAlignment="Right"/>
                            <!-- Bottom Left: Vessel & Hotspot Findings -->
                            <TextBlock x:Name="HudVp2BottomLeft" 
