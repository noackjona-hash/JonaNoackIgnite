<Window x:Class="Ignite.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IGNITE Klinische Diagnose-Workstation · DIN EN ISO 13485 Research Grade"
        Height="980" Width="1620"
        Background="{StaticResource AppBgBrush}" Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable, Segoe UI, -apple-system, Arial"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        Loaded="MainWindow_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid Background="{StaticResource AppBgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="68"/> <!-- 0: Left Navigation Rail -->
            <ColumnDefinition Width="*"/>  <!-- 1: Main Application Shell -->
        </Grid.ColumnDefinitions>

        <!-- ============================================================ -->
        <!-- 0. LEFT NAVIGATION RAIL (SIDEBAR)                            -->
        <!-- Clean white rail, blue squircle highlights, tooltips         -->
        <!-- ============================================================ -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Brand App Logo -->
                    <RowDefinition Height="*"/>    <!-- Navigation Squircles -->
                    <RowDefinition Height="Auto"/> <!-- User Avatar & Settings -->
                </Grid.RowDefinitions>

                <!-- Brand App Icon (Modern Clinical Rounded Squircle with Lightning Bolt) -->
                <Border Grid.Row="0" Margin="0,14,0,16" HorizontalAlignment="Center">
                    <Border Width="44" Height="44" CornerRadius="14" Background="{StaticResource CyanBrush}" Cursor="Hand" ToolTip="IGNITE Klinische Diagnose-Workstation">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="2" Opacity="0.35" Color="#0284C7"/>
                        </Border.Effect>
                        <Path Data="{StaticResource IconIgniteBolt}" Fill="#FFFFFF" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Border>

                <!-- Navigation Rail Squircles Stack -->
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <RadioButton x:Name="RailBtnWorkstation" Style="{StaticResource VoicemodRailRadioStyle}" GroupName="NavRail" IsChecked="True" Checked="NavRail_Checked" ToolTip="Workstation / Dual-View (Strg+1)">
                        <Path Data="{StaticResource IconWorkstation}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Control}}" Width="18" Height="18" Stretch="Uniform"/>
                    </RadioButton>
                    
                    <RadioButton x:Name="RailBtnVascular" Style="{StaticResource VoicemodRailRadioStyle}" GroupName="NavRail" Checked="NavRail_Checked" ToolTip="Vaskuläre Gefäßkartierung / Venenfinder (Strg+2)">
                        <Path Data="{StaticResource IconVascular}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Control}}" Width="18" Height="18" Stretch="Uniform"/>
                    </RadioButton>

                    <RadioButton x:Name="RailBtnHotspots" Style="{StaticResource VoicemodRailRadioStyle}" GroupName="NavRail" Checked="NavRail_Checked" ToolTip="Entzündungsherde &amp; Top-Hat Morphologie (Strg+3)">
                        <Path Data="{StaticResource IconThermal}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Control}}" Width="18" Height="18" Stretch="Uniform"/>
                    </RadioButton>


                    <RadioButton x:Name="RailBtnAnatomy" Style="{StaticResource VoicemodRailRadioStyle}" GroupName="NavRail" Checked="NavRail_Checked" ToolTip="Armstrong 5-Zonen &amp; Angiosome (Strg+5)">
                        <Path Data="{StaticResource IconAnatomy}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Control}}" Width="18" Height="18" Stretch="Uniform"/>
                    </RadioButton>

                    <RadioButton x:Name="RailBtnRadiometry" Style="{StaticResource VoicemodRailRadioStyle}" GroupName="NavRail" Checked="NavRail_Checked" ToolTip="Radiometrisches Spektrum &amp; Profil T(s) (Strg+6)">
                        <Path Data="{StaticResource IconRadiometry}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Control}}" Width="18" Height="18" Stretch="Uniform"/>
                    </RadioButton>

                    <RadioButton x:Name="RailBtnReport" Style="{StaticResource VoicemodRailRadioStyle}" GroupName="NavRail" Checked="NavRail_Checked" ToolTip="Strukturierter Arztbericht IWGDF (Strg+7)">
                        <Path Data="{StaticResource IconReport}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Control}}" Width="18" Height="18" Stretch="Uniform"/>
                    </RadioButton>

                    <RadioButton x:Name="RailBtnParams" Style="{StaticResource VoicemodRailRadioStyle}" GroupName="NavRail" Checked="NavRail_Checked" ToolTip="Pipeline-Parameter &amp; W/L (Strg+8)">
                        <Path Data="{StaticResource IconParams}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Control}}" Width="18" Height="18" Stretch="Uniform"/>
                    </RadioButton>

                    <RadioButton x:Name="RailBtnAudit" Style="{StaticResource VoicemodRailRadioStyle}" GroupName="NavRail" Checked="NavRail_Checked" ToolTip="DSGVO Art. 30 Audit-Log &amp; SQLite (Strg+9)">
                        <Path Data="{StaticResource IconAudit}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Control}}" Width="18" Height="18" Stretch="Uniform"/>
                    </RadioButton>
                </StackPanel>

                <!-- Bottom User Avatar & System Info -->
                <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14">
                    <Button Style="{StaticResource VoicemodRailButtonStyle}" Click="MenuAbout_Click" ToolTip="Info &amp; Jugend forscht 2026">
                        <Path Data="{StaticResource IconInfo}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Control}}" Width="16" Height="16" Stretch="Uniform"/>
                    </Button>
                    <Border Width="40" Height="40" CornerRadius="20" Background="#F1F5F9" BorderBrush="{StaticResource BorderBrightBrush}" BorderThickness="1.5" Margin="0,6,0,0" ToolTip="Angemeldeter Facharzt: Dr. Jona Noack">
                        <Path Data="{StaticResource IconDoctor}" Fill="{StaticResource TextSecondaryBrush}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- 1. MAIN APPLICATION SHELL                                    -->
        <!-- ============================================================ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Row 0: Top Header & Search Bar -->
                <RowDefinition Height="Auto"/> <!-- Row 1: Sub-Navigation Filter Pill Bar -->
                <RowDefinition Height="*"/>    <!-- Row 2: Viewports Workbench & Inspector -->
                <RowDefinition Height="Auto"/> <!-- Row 3: Bottom Filmstrip Gallery -->
                <RowDefinition Height="30"/>   <!-- Row 4: Status & Telemetry Bar -->
            </Grid.RowDefinitions>

            <!-- ============================================================ -->
            <!-- ROW 0: TOP HEADER BAR (Matching Screenshot)                  -->
            <!-- Search pill, green STABIL badge, Patient ID, Blue CTA Button -->
            <!-- ============================================================ -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Left: Nav arrows & Search Box -->
                        <ColumnDefinition Width="*"/>    <!-- Center: Patient / Triage Chip -->
                        <ColumnDefinition Width="Auto"/> <!-- Right: Action Pills & Blue CTA -->
                    </Grid.ColumnDefinitions>

                    <!-- Left: Navigation Arrows & Search Pill -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Navigation Arrows -->
                        <Button Content="‹" Click="BtnZoomReset_Click" Width="30" Height="30" Padding="0" Margin="0,0,3,0" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" ToolTip="Zurücksetzen"/>
                        <Button Content="›" Width="30" Height="30" Padding="0" Margin="0,0,12,0" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" ToolTip="Vorwärts"/>

                        <!-- Search Pill (In Ignite PACS suchen...) -->
                        <Border Width="340" Height="36" CornerRadius="18" Background="{StaticResource InputBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12,0">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Data="{StaticResource IconSearch}" Fill="{StaticResource TextMutedBrush}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Grid.Column="1" x:Name="SearchBox" 
                                         Background="Transparent" BorderThickness="0" 
                                         Foreground="{StaticResource TextPrimaryBrush}" 
                                         CaretBrush="{StaticResource CyanBrush}" 
                                         FontSize="11.5" VerticalAlignment="Center"
                                         TextChanged="SearchBox_TextChanged"/>
                                <TextBlock Grid.Column="1" Text="In Ignite PACS suchen (Patient, Fall, Herd)..." 
                                           FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" 
                                           VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Center: Patient Demographics & Green STABIL Chip (Matching Screenshot) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Green STABIL Pill -->
                        <Border x:Name="BorderTriageBadge" Background="{StaticResource SuccessBgBrush}" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="14" Padding="12,4" Margin="0,0,14,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="BadgeAiStatusDot" Width="8" Height="8" Background="{StaticResource SuccessBrush}" CornerRadius="4" Margin="0,0,6,0"/>
                                <TextBlock x:Name="TxtHeaderAiStatus" Text="STABIL" FontWeight="Bold" FontSize="11" Foreground="#15803D" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <!-- Patient ID Label -->
                        <TextBlock x:Name="PatientIdText" Text="PATIENT ID: 123456789" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Separator Width="1" Height="14" Margin="14,0" Background="{StaticResource BorderBrush}"/>
                        <Border Background="{StaticResource InputBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8,2">
                            <TextBlock x:Name="EngineTimingText" Text="14.8 ms (AVX2 SIMD)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource CyanBrush}"/>
                        </Border>
                    </StackPanel>

                    <!-- Right: Undo/Redo, Menu, Optionen, Exportieren, Berichte, Blue CTA Button -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Undo / Redo Buttons -->
                        <Button x:Name="BtnUndo" Click="BtnUndo_Click" Style="{StaticResource VoicemodButtonPillStyle}" Margin="0,0,3,0" ToolTip="Rückgängig (Strg+Z)" IsEnabled="False">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconUndo}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Control}}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0"/>
                                <TextBlock Text="Undo" VerticalAlignment="Center" FontSize="11"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnRedo" Click="BtnRedo_Click" Style="{StaticResource VoicemodButtonPillStyle}" Margin="0,0,8,0" ToolTip="Wiederholen (Strg+Y)" IsEnabled="False">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconRedo}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Control}}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0"/>
                                <TextBlock Text="Redo" VerticalAlignment="Center" FontSize="11"/>
                            </StackPanel>
                        </Button>

                        <!-- Menu Dropdown -->
                        <Menu Background="Transparent" VerticalAlignment="Center" Margin="0,0,6,0">
                            <MenuItem Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" FontSize="11">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconMenu}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0" SnapsToDevicePixels="True"/>
                                        <TextBlock Text="Menü" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </MenuItem.Header>
                                <MenuItem Header="_Neues Wärmebild öffnen..." Click="MenuOpenImage_Click" InputGestureText="Strg+O"/>
                                <MenuItem Header="_Kontralaterales Bild laden..." Click="MenuOpenContralateral_Click"/>
                                <Separator Background="{StaticResource BorderBrush}"/>
                                <MenuItem Header="_Rückgängig" Click="BtnUndo_Click" InputGestureText="Strg+Z"/>
                                <MenuItem Header="_Wiederholen" Click="BtnRedo_Click" InputGestureText="Strg+Y"/>
                                <MenuItem Header="_Alles Zurücksetzen" Click="BtnResetAll_Click" InputGestureText="Strg+R"/>
                                <Separator Background="{StaticResource BorderBrush}"/>
                                <MenuItem Header="_Ärztlichen Befundbericht exportieren (PDF)..." Click="MenuExportReport_Click"/>
                                <MenuItem Header="_DSGVO Art. 30 Audit-Protokoll einsehen" Click="MenuAuditLog_Click"/>
                                <MenuItem Header="_Klinische Lua-Entscheidungsregeln" Click="MenuLuaEditor_Click"/>
                                <MenuItem Header="_Hardware-Benchmark (AVX2 Vektor)" Click="MenuBenchmark_Click"/>
                                <Separator Background="{StaticResource BorderBrush}"/>
                                <MenuItem Header="_Über IGNITE (Jugend forscht 2026)..." Click="MenuAbout_Click"/>
                                <MenuItem Header="_Beenden" Click="MenuExit_Click"/>
                            </MenuItem>
                        </Menu>

                        <!-- Optionen Button (Matching Screenshot) -->
                        <Button Click="MenuOpenOptions_Click" Style="{StaticResource VoicemodButtonPillStyle}" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconParams}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Control}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0"/>
                                <TextBlock Text="Optionen" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Export Dropdown ("Export für ALLES") -->
                        <Menu Background="Transparent" VerticalAlignment="Center" Margin="0,0,6,0">
                            <MenuItem Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" FontSize="11">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconExport}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0" SnapsToDevicePixels="True"/>
                                        <TextBlock Text="Exportieren ▼" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </MenuItem.Header>
                                <MenuItem Header="-- 3D REKONSTRUKTION &amp; CAD --" IsEnabled="False" FontWeight="Bold"/>
                                <MenuItem Header="_Wavefront 3D-Netz (*.obj mit Farben)..." Click="Export3D_Obj_Click"/>
                                <MenuItem Header="_Stanford PLY Mesh (*.ply)..." Click="Export3D_Ply_Click"/>
                                <MenuItem Header="_Stereolithographie STL 3D-Druck (*.stl)..." Click="Export3D_Stl_Click"/>
                                <MenuItem Header="_XYZ Thermografische Punktwolke (*.xyz)..." Click="Export3D_Xyz_Click"/>
                                <MenuItem Header="_3D Tiefenprofil Matrix (*.csv)..." Click="Export3D_DepthCsv_Click"/>
                                <Separator Background="{StaticResource BorderBrush}"/>
                                <MenuItem Header="-- KLINISCHE BERICHTE &amp; DATEN --" IsEnabled="False" FontWeight="Bold"/>
                                <MenuItem Header="_Ärztlicher Befundbericht (PDF)..." Click="MenuExportReport_Click"/>
                                <MenuItem Header="_Vollständiger Patientendatensatz (JSON)..." Click="ExportClinicalJson_Click"/>
                                <MenuItem Header="_Hotspot- &amp; Ulkusrisikotabelle (CSV)..." Click="ExportHotspotsCsv_Click"/>
                                <MenuItem Header="_5-Zonen Plantardruck- &amp; Biomechaniktabelle (CSV)..." Click="ExportBiomechanicsCsv_Click"/>
                                <MenuItem Header="_2D Radiometrische Temperaturmatrix (CSV)..." Click="BtnExportCsv_Click"/>
                                <Separator Background="{StaticResource BorderBrush}"/>
                                <MenuItem Header="-- BILDER &amp; VIEWS --" IsEnabled="False" FontWeight="Bold"/>
                                <MenuItem Header="_Aktuelle Viewport-Ansicht exportieren (*.png)..." Click="ExportCurrentView_Click"/>
                                <MenuItem Header="_Diagnostisches Befund-Overlay (*.png)..." Click="ExportDiagnosticOverlay_Click"/>
                                <MenuItem Header="_Vaskulärer Frangi-Gefäßbaum (*.png)..." Click="ExportVascularTree_Click"/>
                                <MenuItem Header="_3D Tiefenrelief Farbkarte (*.png)..." Click="Export3DDepthMap_Click"/>
                            </MenuItem>
                        </Menu>

                        <!-- Berichte Button (Matching Screenshot) -->
                        <Button Click="MenuExportReport_Click" Style="{StaticResource VoicemodButtonPillStyle}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconReport}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Control}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0"/>
                                <TextBlock Text="Berichte" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- PRIMARY BLUE CTA BUTTON (Matching Screenshot: "Diagnose Starten") -->
                        <Button Click="BtnRunAnalysis_Click" Style="{StaticResource VoicemodLimeHeroButtonStyle}" ToolTip="Führt die vollständige radiometrische AVX2-Befundung aus">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconPlay}" Fill="#FFFFFF" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="Diagnose Starten" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Notifications & Help -->
                        <Border Margin="12,0,4,0" VerticalAlignment="Center" Cursor="Hand" ToolTip="Benachrichtigungen" Width="28" Height="28" CornerRadius="14" Background="Transparent">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Path Data="{StaticResource IconBell}" Fill="{StaticResource TextSecondaryBrush}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Margin="2,0,4,0" VerticalAlignment="Center" Cursor="Hand" MouseDown="MenuAbout_Click" ToolTip="Hilfe" Width="28" Height="28" CornerRadius="14" Background="Transparent">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Path Data="{StaticResource IconHelp}" Fill="{StaticResource TextSecondaryBrush}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================================================ -->
            <!-- ROW 1: CATEGORY FILTER PILL BAR (Matching Screenshot)        -->
            <!-- [ + Alle ] [ 2D Dual-View ] [ ◐ Vorhang-Split ] ...          -->
            <!-- ============================================================ -->
            <Border Grid.Row="1" Background="{StaticResource AppBgBrush}" Padding="16,8,16,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Horizontal Scrolling Filter Pills -->
                    <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton x:Name="RbFilterAll" Style="{StaticResource VoicemodPillStyle}" GroupName="PillViewFilter" Content="+ Alle" Checked="RbFilterAll_Checked" ToolTip="Vollständige Übersicht"/>
                            <RadioButton x:Name="RbViewDual" Style="{StaticResource VoicemodPillStyle}" GroupName="PillViewFilter" Checked="ViewMode_Checked" ToolTip="Doppelansicht: Rohbild und Befund">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconWorkstation}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Control}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0"/>
                                    <TextBlock Text="2D Dual-View" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="RbViewCurtain" Style="{StaticResource VoicemodPillStyle}" GroupName="PillViewFilter" IsChecked="True" Checked="ViewMode_Checked" ToolTip="Interaktiver Schiebe-Vorhang">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconCurtain}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Control}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0"/>
                                    <TextBlock Text="Vorhang-Split" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="RbViewDSA" Style="{StaticResource VoicemodPillStyle}" GroupName="PillViewFilter" Checked="ViewMode_Checked" ToolTip="Digitale Subtraktions-Angiographie (Venen)">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconVascular}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Control}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0"/>
                                    <TextBlock Text="8.3 Radiometrie (DSA)" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="RbView3DRelief" Style="{StaticResource VoicemodPillStyle}" GroupName="PillViewFilter" Checked="ViewMode_Checked" ToolTip="2.5D Topografisches Höhenmodell">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconRelief}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Control}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0"/>
                                    <TextBlock Text="3D-Relief" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="RbViewIsotherm" Style="{StaticResource VoicemodPillStyle}" GroupName="PillViewFilter" Checked="ViewMode_Checked" ToolTip="Isothermen-Bandfilterung">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconIsotherm}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Control}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0"/>
                                    <TextBlock Text="Isothermen" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="RbViewPressureProxy" Style="{StaticResource VoicemodPillStyle}" GroupName="PillViewFilter" Checked="ViewMode_Checked" ToolTip="Biomechanische Plantardruck- &amp; Scherspannungsschätzung (Pennes-Bioheat in kPa)">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconPressure}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Control}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0"/>
                                    <TextBlock Text="Druck-Proxy" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="RbViewLaplace" Style="{StaticResource VoicemodPillStyle}" GroupName="PillViewFilter" Checked="ViewMode_Checked" ToolTip="Laplace Tiefengewebe-Abszess &amp; Wärmestau-Filterung">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconLaplace}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Control}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0"/>
                                    <TextBlock Text="Wärmestau (∇²T)" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="RbView3DAnatomy" Style="{StaticResource VoicemodPillStyle}" GroupName="PillViewFilter" Checked="ViewMode_Checked" ToolTip="3D-Anatomische Rekonstruktion &amp; Lambert'sche Kantenkorrektur">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconRelief}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Control}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0"/>
                                    <TextBlock Text="📐 3D-Kantenkorrektur" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            
                            <Separator Width="1" Height="20" Margin="10,0" Background="{StaticResource BorderBrush}"/>

                            <Button Content="Extremitäten trennen" Click="BtnAutoSplitFeet_Click" Padding="12,4" Margin="2,0" ToolTip="Trennt linken &amp; rechten Fuß automatisch"/>
                            <Button Content="Reset ROI" Click="BtnResetROI_Click" Padding="10,4" Margin="2,0"/>
                            <Button Content="Reset Sonden" Click="BtnResetProbes_Click" Padding="10,4" Margin="2,0"/>
                            <Button x:Name="BtnResetAll" Content="↺ Alles Zurücksetzen" Click="BtnResetAll_Click" Padding="12,4" Margin="4,0" ToolTip="Setzt Zoom, Pan, Sonden, ROIs, Filter und Ansichten auf Ausgangszustand zurück (Strg+R)" Style="{StaticResource VoicemodButtonPillStyle}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Right Preset & Color Palette Selector -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="PRESET:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10.5" FontWeight="Bold"/>
                        <ComboBox x:Name="ComboPreset" Width="160" SelectionChanged="ComboPreset_SelectionChanged" Margin="0,0,10,0">
                            <ComboBoxItem Content="-- Standard Diagnostik --" IsSelected="True"/>
                            <ComboBoxItem Content="Diabetischer Fuß (Armstrong DFS)"/>
                            <ComboBoxItem Content="Vaskulär / Angiographie (Frangi)"/>
                            <ComboBoxItem Content="Akute Hyperthermie (Top-Hat)"/>
                            <ComboBoxItem Content="Periphere Ischämie (Perfusion)"/>
                        </ComboBox>

                        <TextBlock Text="LUT:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10.5" FontWeight="Bold"/>
                        <ComboBox x:Name="ComboPalette" Width="100" SelectionChanged="ComboPalette_SelectionChanged" Margin="0,0,12,0">
                            <ComboBoxItem Content="Ironbow" IsSelected="True"/>
                            <ComboBoxItem Content="Rainbow"/>
                            <ComboBoxItem Content="Inferno"/>
                            <ComboBoxItem Content="Graustufen"/>
                        </ComboBox>

                        <CheckBox x:Name="ChkSyncViewports" Content="Sync" IsChecked="True" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Synchroner Zoom beider Viewports"/>
                        <CheckBox x:Name="ChkMinMaxTracker" Content="Min/Max" IsChecked="True" VerticalAlignment="Center" Margin="0,0,8,0" Click="ChkMinMaxTracker_Click" ToolTip="Markiert kälteste und heißeste Stelle"/>
                        <CheckBox x:Name="ChkEnableVeinOverlay" Content="Venen" IsChecked="True" VerticalAlignment="Center" Margin="0,0,8,0" Click="ChkEnableVeinOverlay_Click" ToolTip="Frangi-Gefäßfilter Überlagerung"/>
                        <CheckBox x:Name="ChkShowZonesOverlay" Content="Zonen" IsChecked="False" VerticalAlignment="Center" Margin="0,0,4,0" Click="ChkShowZonesOverlay_Click" ToolTip="Anatomische 5-Zonen Konturen &amp; Belastungsmarker auf Canvas einblenden"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================================================ -->
            <!-- ROW 2: WORKBENCH & INSPECTOR                                 -->
            <!-- ============================================================ -->
            <Grid Grid.Row="2" Margin="14,0,14,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="540"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="450" MinWidth="380"/>
                </Grid.ColumnDefinitions>

                <!-- DUAL VIEWPORT WORKBENCH (Matching Screenshot) -->
                <Grid Grid.Column="0">
                    <Border CornerRadius="16" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Viewport Headers -->
                                <RowDefinition Height="*"/>    <!-- Canvas Area -->
                            </Grid.RowDefinitions>

                            <!-- Viewport Titles Sub-Header (Matching Screenshot) -->
                            <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="■ PRIMÄR-THERMOGRAMM (ROHBILD)" FontWeight="Bold" FontSize="11" Foreground="#1E293B"/>
                                        <TextBlock x:Name="TxtVp2Title" Text="   Rohbild (Primär) vs. Befunddaten (Gefäßkarte)" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="6,0,0,0"/>
                                        <TextBlock x:Name="TxtToolHintVp1" Text=" - Bilateraler Thermogramm vs Rohbild" FontSize="10" Foreground="{StaticResource CyanBrush}" Margin="6,0,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="BILDDATENSATZ: LWIR-17µm FLIR" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Split Viewports Area -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="ColViewport1" Width="*"/>
                                    <ColumnDefinition x:Name="ColDivider" Width="1"/>
                                    <ColumnDefinition x:Name="ColViewport2" Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- VIEWPORT 1 (Raw Thermal Image) -->
                                <Grid Grid.Column="0" Background="#FFFFFF" ClipToBounds="True">
                                    <ScrollViewer x:Name="ScrollOriginal" 
                                                  HorizontalScrollBarVisibility="Auto" 
                                                  VerticalScrollBarVisibility="Auto"
                                                  PreviewMouseWheel="Viewport_PreviewMouseWheel"
                                                  ScrollChanged="ScrollOriginal_ScrollChanged">
                                        <!-- Centered Grid matching exact image dimensions with ZERO offset -->
                                        <Grid x:Name="CanvasOriginal" 
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Background="Transparent"
                                              MouseDown="ViewportOriginal_MouseDown" 
                                              MouseMove="ViewportOriginal_MouseMove" 
                                              MouseUp="ViewportOriginal_MouseUp" 
                                              MouseLeave="ViewportOriginal_MouseLeave">
                                            <Image x:Name="ImgOriginal" Stretch="None"/>
                                            <!-- Watermark FLIR Logo (Matching Screenshot) -->
                                            <TextBlock Text="❖ FLIR" FontWeight="Black" FontSize="20" Foreground="#283548" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,12,0,0" IsHitTestVisible="False" Opacity="0.85"/>
                                            <Canvas x:Name="OverlayOriginalCanvas" IsHitTestVisible="False"/>
                                        </Grid>
                                    </ScrollViewer>

                                    <!-- DICOM 4-Corner OSD Telemetry Badges (Light Card Style) -->
                                    <Grid IsHitTestVisible="False" Margin="10">
                                        <Border CornerRadius="6" Background="#EEFFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <TextBlock Text="PATIENT: MUSTERN, GERHARD (M)&#x0a;PID: DFS-2026-8812 · 68 J.&#x0a;MODALITÄT: IR-THERMOGRAFIE&#x0a;DATUM: 01.10.2026  14:22:15" 
                                                       FontSize="9" FontFamily="Consolas, Segoe UI" Foreground="#1E293B"/>
                                        </Border>

                                        <Border CornerRadius="6" Background="#EEFFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Top">
                                            <TextBlock x:Name="HudVp1TopRight" 
                                                       Text="DIABETES-ZENTRUM / RADIOLOGIE&#x0a;SENSOR: LWIR 17µm FLIR&#x0a;MATRIX: 640x480 (16-BIT)&#x0a;ZOOM: 100%" 
                                                       FontSize="9" FontFamily="Consolas, Segoe UI" Foreground="#1E293B" TextAlignment="Right"/>
                                        </Border>

                                        <Border CornerRadius="6" Background="#EEFFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,50">
                                            <TextBlock x:Name="HudVp1BottomLeft" 
                                                       Text="LUT: IRONBOW MEDICAL GSDF&#x0a;W: 255 (ΔT: 22.0K)  L: 128 (31.0°C)&#x0a;INTERPOLATION: BILINEAR" 
                                                       FontSize="9" FontFamily="Consolas, Segoe UI" Foreground="{StaticResource CyanBrush}"/>
                                        </Border>
                                    </Grid>

                                    <!-- Physical 50mm Scale Bar -->
                                    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,16" IsHitTestVisible="False">
                                        <StackPanel Width="142">
                                            <TextBlock Text="50 mm" FontSize="8.5" FontFamily="Consolas" Foreground="#64748B" HorizontalAlignment="Center"/>
                                            <Border Height="3" Background="#64748B" BorderBrush="#000000" BorderThickness="0.5"/>
                                            <Grid>
                                                <Rectangle HorizontalAlignment="Left" Width="1" Height="5" Fill="#64748B"/>
                                                <Rectangle HorizontalAlignment="Center" Width="1" Height="5" Fill="#64748B"/>
                                                <Rectangle HorizontalAlignment="Right" Width="1" Height="5" Fill="#64748B"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Viewport Divider -->
                                <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}"/>

                                <!-- VIEWPORT 2 (Diagnostic Findings & Overlays) -->
                                <Grid Grid.Column="2" Background="#FFFFFF" ClipToBounds="True">
                                    <ScrollViewer x:Name="ScrollResult" 
                                                  HorizontalScrollBarVisibility="Auto" 
                                                  VerticalScrollBarVisibility="Auto"
                                                  PreviewMouseWheel="Viewport_PreviewMouseWheel"
                                                  ScrollChanged="ScrollResult_ScrollChanged">
                                        <!-- Centered Grid matching exact image dimensions with ZERO offset -->
                                        <Grid x:Name="CanvasResult" 
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Background="Transparent"
                                              MouseDown="ViewportResult_MouseDown" 
                                              MouseMove="ViewportResult_MouseMove" 
                                              MouseUp="ViewportResult_MouseUp" 
                                              MouseLeave="Viewport_MouseLeave">
                                            <Image x:Name="ImgResult" Stretch="None"/>

                                            <Image x:Name="ImgCurtainRaw" Stretch="None" Visibility="Collapsed">
                                                <Image.Clip>
                                                    <RectangleGeometry x:Name="CurtainClipRect" Rect="0,0,0,0"/>
                                                </Image.Clip>
                                            </Image>

                                            <Canvas x:Name="OverlayResultCanvas" IsHitTestVisible="False"/>

                                            <!-- Curtain Handle (Matching Screenshot) -->
                                            <Canvas x:Name="CanvasCurtain" Visibility="Collapsed" IsHitTestVisible="True">
                                                <Line x:Name="LineCurtain" Stroke="{StaticResource CyanBrush}" StrokeThickness="1.5" StrokeDashArray="3,2"/>
                                                <Border x:Name="BorderCurtainHandle" Width="36" Height="28" Background="#FFFFFF" BorderBrush="{StaticResource CyanBrush}" BorderThickness="1.5" CornerRadius="6" Cursor="SizeWE" MouseDown="CurtainHandle_MouseDown">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.2" Color="#000000"/>
                                                    </Border.Effect>
                                                    <TextBlock Text="◀ ◐ ▶" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource CyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Canvas>
                                        </Grid>
                                    </ScrollViewer>

                                    <!-- Floating Armstrong High-Alert Banner -->
                                    <Border x:Name="FloatingArmstrongBanner" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0" 
                                            Background="#FEE2E2" BorderBrush="#DC2626" BorderThickness="1.5" CornerRadius="8" Padding="14,6" IsHitTestVisible="False">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconWarning}" Fill="#DC2626" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock x:Name="TxtFloatingArmstrong" Text="ARMSTRONG-WARNUNG: ΔT = 2.8 K (≥ 2.2 K) — Hohes Ulkusrisiko!" FontWeight="Bold" FontSize="11.5" Foreground="#DC2626" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- DICOM 4-Corner OSD Telemetry Badges (Light Card Style) -->
                                    <Grid IsHitTestVisible="False" Margin="10">
                                        <Border CornerRadius="6" Background="#EEFFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <TextBlock Text="BEFUNDUNG: TOP-HAT + FRANGI-HESSE&#x0a;STATISTIK: ROBUSTES MAD (k=3.0)&#x0a;ENGINE: x86_64 AVX2 (256-BIT SIMD)&#x0a;DETERMINISTISCH (REPRODUZIERBAR)" 
                                                       FontSize="9" FontFamily="Consolas, Segoe UI" Foreground="#1E293B"/>
                                        </Border>

                                        <Border CornerRadius="6" Background="#EEFFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Top">
                                            <TextBlock x:Name="HudVp2TopRight" 
                                                       Text="KLASSIFIKATION: LEITLINIE IWGDF&#x0a;AUDIT: REVISIONSSICHER SQLITE&#x0a;HASH: SHA-256 SIGNIERT&#x0a;BEWERTUNG: DETERMINISTISCH / CAD" 
                                                       FontSize="9" FontFamily="Consolas, Segoe UI" Foreground="#1E293B" TextAlignment="Right"/>
                                        </Border>

                                        <Border CornerRadius="6" Background="#EEFFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,16">
                                            <TextBlock x:Name="HudVp2BottomLeft" 
                                                       Text="VASKULÄR: FRANGI-GEFÄSSFILTER&#x0a;HERDE: MORPHOLOGISCHE DETEKTION&#x0a;ARMSTRONG SCHWELLE: ΔT >= 2.2 K" 
                                                       FontSize="9" FontFamily="Consolas, Segoe UI" Foreground="{StaticResource CyanBrush}"/>
                                        </Border>
                                    </Grid>

                                    <!-- Vertical Calibrated Temperature Scale Bar (Matching Screenshot) -->
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" 
                                            Background="#FFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="6,8">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.1" Color="#000000"/>
                                        </Border.Effect>
                                        <StackPanel Width="40" HorizontalAlignment="Center">
                                            <TextBlock Text="42°C" FontSize="8.5" FontWeight="Bold" Foreground="#EF4444" HorizontalAlignment="Center"/>
                                            <TextBlock Text="37°C" FontSize="8" Foreground="#F59E0B" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                            <Border Height="140" Width="10" Margin="0,3" CornerRadius="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#FFFFFF" Offset="0.0"/>
                                                        <GradientStop Color="#FFFF00" Offset="0.18"/>
                                                        <GradientStop Color="#FF0000" Offset="0.42"/>
                                                        <GradientStop Color="#800080" Offset="0.72"/>
                                                        <GradientStop Color="#000080" Offset="1.0"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <TextBlock Text="26°C" FontSize="8" Foreground="#0284C7" HorizontalAlignment="Center"/>
                                            <TextBlock Text="20°C" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource CyanBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>

                            <!-- ============================================================ -->
                            <!-- FLOATING ACTION DOCK (BOTTOM CAPSULE - MATCHING SCREENSHOT)  -->
                            <!-- White capsule, subtle shadow, tools, blue central button     -->
                            <!-- ============================================================ -->
                            <Border Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20" 
                                    Background="#FFFFFF" BorderBrush="{StaticResource BorderBrightBrush}" BorderThickness="1" CornerRadius="26" Padding="10,5">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="3" Opacity="0.12" Color="#0F172A"/>
                                </Border.Effect>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Interactive Tool Radio Buttons -->
                                    <RadioButton x:Name="RbToolPan" Style="{StaticResource VoicemodDockRadioStyle}" GroupName="CanvasTools" IsChecked="True" Checked="ToolRadio_Checked" ToolTip="Pan &amp; Zoom">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconPan}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Control}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0"/>
                                            <TextBlock Text="PAN" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="RbToolRoi" Style="{StaticResource VoicemodDockRadioStyle}" GroupName="CanvasTools" Checked="ToolRadio_Checked" ToolTip="Rechteck zur fokussierten Analyse aufziehen (Pixelgenau, ohne Offset)">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconRoi}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Control}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0"/>
                                            <TextBlock Text="ROI" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="RbToolProfile" Style="{StaticResource VoicemodDockRadioStyle}" GroupName="CanvasTools" Checked="ToolRadio_Checked" ToolTip="Linie für Temperatur-Schnittprofil ziehen (Pixelgenau)">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconProfile}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Control}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0"/>
                                            <TextBlock Text="PROFIL" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="RbToolProbe" Style="{StaticResource VoicemodDockRadioStyle}" GroupName="CanvasTools" Checked="ToolRadio_Checked" ToolTip="Punkt-Messsonden P1, P2 setzen">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconProbe}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Control}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0"/>
                                            <TextBlock Text="SONDEN" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="RbToolGoniometer" Style="{StaticResource VoicemodDockRadioStyle}" GroupName="CanvasTools" Checked="ToolRadio_Checked" ToolTip="Orthopädisches 3-Punkt Goniometer (Hallux Valgus Winkel HVA &amp; IMA)">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconGoniometer}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Control}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0"/>
                                            <TextBlock Text="WINKEL" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="RbToolWL" Style="{StaticResource VoicemodDockRadioStyle}" GroupName="CanvasTools" Checked="ToolRadio_Checked" ToolTip="Interaktive Kontrast- &amp; Helligkeitsfensterung">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconWindowLevel}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Control}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0"/>
                                            <TextBlock Text="W/L" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </RadioButton>

                                    <Separator Width="1" Height="22" Margin="8,0" Background="{StaticResource BorderBrush}"/>

                                    <!-- Blue Circular Central Action Button (Matching Screenshot) -->
                                    <Border Width="42" Height="42" CornerRadius="21" Background="{StaticResource CyanBrush}" Cursor="Hand" Margin="2,0" 
                                            MouseDown="BtnCentralRun_MouseDown" ToolTip="Diagnose sofort ausführen">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="2" Opacity="0.4" Color="#0284C7"/>
                                        </Border.Effect>
                                        <Path Data="{StaticResource IconIgniteBolt}" Fill="#FFFFFF" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <Separator Width="1" Height="22" Margin="8,0" Background="{StaticResource BorderBrush}"/>

                                    <!-- Quick Zoom Controls (Matching Screenshot) -->
                                    <Button Content="-" Click="BtnZoomOut_Click" Width="28" Height="28" Padding="0" Margin="2,0" ToolTip="Zoom verkleinern"/>
                                    <Button Content="100%" Click="BtnZoomReset_Click" Height="28" Padding="8,0" Margin="2,0" FontSize="10.5" ToolTip="Originalgröße"/>
                                    <Button Content="+" Click="BtnZoomIn_Click" Width="28" Height="28" Padding="0" Margin="2,0" ToolTip="Zoom vergrößern"/>
                                    <Button Click="BtnZoomFit_Click" Height="28" Padding="8,0" Margin="2,0" FontSize="10.5" ToolTip="Ganzes Bild einpassen">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconZoomFit}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Control}}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0"/>
                                            <TextBlock Text="FIT" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Analysis Progress Bar -->
                            <ProgressBar Grid.Row="1" x:Name="AnalysisProgressBar" Height="3" IsIndeterminate="True" Foreground="{StaticResource CyanBrush}" Background="Transparent" BorderThickness="0" VerticalAlignment="Top" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- SPLITTER -->
                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

                <!-- ============================================================ -->
                <!-- RIGHT INSPECTOR / CONTROL PANEL (Matching Screenshot)        -->
                <!-- White card background, pill tabs, clean sliders with badges  -->
                <!-- ============================================================ -->
                <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Active Profile / Examination Card -->
                            <RowDefinition Height="*"/>    <!-- Inspector Tabs -->
                        </Grid.RowDefinitions>

                        <!-- Top Active Case Header Card (Matching Screenshot) -->
                        <Border Grid.Row="0" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" CornerRadius="15,15,0,0" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Case Thumbnail Squircle -->
                                <Border Grid.Column="0" Width="46" Height="46" CornerRadius="12" Background="#F1F5F9" BorderBrush="{StaticResource BorderBrightBrush}" BorderThickness="1" Margin="0,0,12,0">
                                    <Path Data="{StaticResource IconDicom}" Fill="{StaticResource CyanBrush}" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Demographics & Subtitle -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Patient ID" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="6110502 20.77 - 61.14()" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1,0,0"/>
                                    <TextBlock Text="ASNC75050 27900K 6" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,1,0,0"/>
                                    <Border HorizontalAlignment="Left" Background="#E0F2FE" CornerRadius="4" Padding="6,1" Margin="0,3,0,0">
                                        <TextBlock Text="ARMSTRONG STADIUM 0" FontSize="9" FontWeight="Bold" Foreground="{StaticResource CyanBrush}"/>
                                    </Border>
                                </StackPanel>

                                <!-- Quick Action Buttons -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Click="BtnCopyDoctorText_Click" Padding="8,4" Margin="0,0,4,0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrightBrush}" Foreground="{StaticResource CyanBrush}" FontWeight="SemiBold" ToolTip="Kopiert strukturierten Arztbrief-Befundtext in die Zwischenablage für Praxis-EDV">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconCopy}" Fill="{StaticResource CyanBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0"/>
                                            <TextBlock Text="Befund" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="BtnExportCsv_Click" Padding="8,4" Margin="0,0,4,0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrightBrush}" Foreground="{StaticResource CyanBrush}" FontWeight="SemiBold" ToolTip="Exportiert die 2D-Temperaturmatrix als wissenschaftliche CSV-Tabelle">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconRadiometry}" Fill="{StaticResource CyanBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0"/>
                                            <TextBlock Text="CSV" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="MenuExportReport_Click" Padding="8,4" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrightBrush}" Foreground="{StaticResource CyanBrush}" FontWeight="SemiBold" ToolTip="Vollständigen Befundbericht generieren &amp; drucken">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconDownload}" Fill="{StaticResource CyanBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0"/>
                                            <TextBlock Text="Export" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Inspector Tabs (Pill Tab Style Matching Screenshot) -->
                        <TabControl Grid.Row="1" x:Name="InspectorTabs" Background="Transparent" BorderThickness="0">

                            <!-- TAB 0: PARAMETERS & WINDOW/LEVEL (Matching Screenshot) -->
                            <TabItem x:Name="TabParams" IsSelected="True">
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconParams}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0"/>
                                        <TextBlock Text="Parameter" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </TabItem.Header>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="Diagnostische Pipeline-Parameter" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>

                                        <!-- Window / Level Card -->
