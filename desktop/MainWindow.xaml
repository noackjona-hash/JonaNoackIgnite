<Window x:Class="Ignite.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IGNITE Medical Imaging Suite v5.0.0 [Jugend Forscht 2026] - Deterministische Thermografie-Workstation"
        Height="880" Width="1380"
        Background="#1E1E1E" Foreground="#CCCCCC"
        FontFamily="Segoe UI, Segoe UI Variable, Arial"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Classic Dark Slate Workstation Theme -->
        <SolidColorBrush x:Key="HeaderBg" Color="#2D2D30"/>
        <SolidColorBrush x:Key="PanelBg" Color="#252526"/>
        <SolidColorBrush x:Key="BorderColor" Color="#3F3F46"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#007ACC"/>
        <SolidColorBrush x:Key="TextLight" Color="#F1F1F1"/>
        <SolidColorBrush x:Key="TextMuted" Color="#9E9E9E"/>

        <Style TargetType="Menu">
            <Setter Property="Background" Value="{StaticResource HeaderBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextLight}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="{StaticResource HeaderBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextLight}"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#333337"/>
            <Setter Property="Foreground" Value="{StaticResource TextLight}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource TextLight}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextLight}"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="RowBackground" Value="#252526"/>
            <Setter Property="AlternatingRowBackground" Value="#2A2A2D"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Main Menu -->
            <RowDefinition Height="Auto"/> <!-- Main Toolbar -->
            <RowDefinition Height="*"/>    <!-- Workstation Viewports & Docking Inspector -->
            <RowDefinition Height="26"/>   <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- 1. MAIN MENU BAR -->
        <Menu Grid.Row="0">
            <MenuItem Header="_Datei">
                <MenuItem Header="_Wärmebild öffnen..." Click="MenuOpenImage_Click" InputGestureText="Strg+O"/>
                <MenuItem Header="_Zweites Bild für Seitenvergleich..." Click="MenuOpenContralateral_Click"/>
                <Separator/>
                <MenuItem Header="_Befundbericht exportieren (JSON/HTML)..." Click="MenuExportReport_Click"/>
                <Separator/>
                <MenuItem Header="_Beenden" Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="_Analyse-Modus">
                <MenuItem Header="1. Entzündungs-Detektor (Top-Hat &amp; MAD)" Click="ModeInflammation_Click"/>
                <MenuItem Header="2. Venen- &amp; Adernkartierung (Frangi-Hesse)" Click="ModeVascular_Click"/>
                <MenuItem Header="3. Perfusion &amp; Temperaturgradient" Click="ModePerfusion_Click"/>
                <MenuItem Header="4. Bilateraler Seitenvergleich (Armstrong)" Click="ModeBilateral_Click"/>
            </MenuItem>
            <MenuItem Header="_Falschfarben-Palette">
                <MenuItem Header="Ironbow (Medizinischer Standard)" Click="PaletteIronbow_Click"/>
                <MenuItem Header="Rainbow / Jet" Click="PaletteRainbow_Click"/>
                <MenuItem Header="Inferno" Click="PaletteInferno_Click"/>
                <MenuItem Header="Monochrom Graustufen" Click="PaletteGray_Click"/>
            </MenuItem>
            <MenuItem Header="_Werkzeuge">
                <MenuItem Header="_DSGVO-Auditprotokoll anzeigen" Click="MenuAuditLog_Click"/>
                <MenuItem Header="_Lua-Regel-Editor öffnen" Click="MenuLuaEditor_Click"/>
                <MenuItem Header="_Hardware-Benchmark (AVX2 vs Skalar)" Click="MenuBenchmark_Click"/>
            </MenuItem>
            <MenuItem Header="_Hilfe">
                <MenuItem Header="_Über IGNITE v5.0.0 (Jugend Forscht)..." Click="MenuAbout_Click"/>
                <MenuItem Header="_Methodische Dokumentation" Click="MenuDocs_Click"/>
            </MenuItem>
        </Menu>

        <!-- 2. QUICK TOOLBAR -->
        <Border Grid.Row="1" Background="{StaticResource HeaderBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="6,4">
            <StackPanel Orientation="Horizontal">
                <Button Content="📂 Bild laden" Click="MenuOpenImage_Click"/>
                <Button Content="⚡ Analyse starten" Click="BtnRunAnalysis_Click" Background="#0E639C"/>
                <Button Content="🩸 Venen-Overlay" Click="BtnToggleVascular_Click"/>
                <Button Content="⚖️ Seitenvergleich" Click="ModeBilateral_Click"/>
                <Button Content="💾 Bericht speichern" Click="MenuExportReport_Click"/>

                <Separator Width="2" Margin="8,2" Background="{StaticResource BorderColor}"/>

                <TextBlock Text="Palette:" VerticalAlignment="Center" Margin="4,0" Foreground="{StaticResource TextMuted}"/>
                <ComboBox x:Name="ComboPalette" Width="130" SelectionChanged="ComboPalette_SelectionChanged" Background="#333337" Foreground="{StaticResource TextLight}" VerticalContentAlignment="Center">
                    <ComboBoxItem Content="Ironbow (Standard)" IsSelected="True"/>
                    <ComboBoxItem Content="Rainbow"/>
                    <ComboBoxItem Content="Inferno"/>
                    <ComboBoxItem Content="Graustufen"/>
                </ComboBox>

                <Separator Width="2" Margin="8,2" Background="{StaticResource BorderColor}"/>

                <Button Content="🔍 Zoom +" Click="BtnZoomIn_Click" Width="32"/>
                <Button Content="100%" Click="BtnZoomReset_Click" Width="45"/>
                <Button Content="🔍 Zoom -" Click="BtnZoomOut_Click" Width="32"/>
                <Button Content="↔ Fit" Click="BtnZoomFit_Click" Width="40"/>
            </StackPanel>
        </Border>

        <!-- 3. WORKSTATION MAIN VIEWPORT & INSPECTOR -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="400"/>       <!-- Dual Viewport Screen -->
                <ColumnDefinition Width="5"/>                       <!-- Splitter -->
                <ColumnDefinition Width="420" MinWidth="320"/>      <!-- Docking Inspector Tabs -->
            </Grid.ColumnDefinitions>

            <!-- DUAL VIEWPORT WORKBENCH -->
            <Grid Grid.Column="0" Background="#141414">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Sub-Header showing Viewport titles -->
                <Border Grid.Row="0" Background="#202022" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="10,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="EINGANGS-WÄRMEBILD (FLIR SENSOR RAW)" FontWeight="Bold" FontSize="11" Foreground="#007ACC"/>
                        <TextBlock Grid.Column="1" Text="DIAGNOSTISCHES ANALYSE-ERGEBNIS (GO CORE + AVX2)" FontWeight="Bold" FontSize="11" Foreground="#4EC9B0"/>
                    </Grid>
                </Border>

                <!-- Split Viewports -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="2"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Viewport 1 (Original Thermal Image) -->
                    <Border Grid.Column="0" ClipToBounds="True" Background="#0F0F0F">
                        <ScrollViewer x:Name="ScrollOriginal" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <Grid x:Name="CanvasOriginal" MouseMove="Viewport_MouseMove" MouseLeave="Viewport_MouseLeave">
                                <Image x:Name="ImgOriginal" Stretch="None"/>
                                <Canvas x:Name="OverlayOriginalCanvas" IsHitTestVisible="False"/>
                            </Grid>
                        </ScrollViewer>
                    </Border>

                    <!-- Viewport Divider -->
                    <GridSplitter Grid.Column="1" Width="2" HorizontalAlignment="Stretch" Background="#3E3E42"/>

                    <!-- Viewport 2 (Analysis Result / Overlay / Veins / Difference) -->
                    <Border Grid.Column="2" ClipToBounds="True" Background="#0F0F0F">
                        <ScrollViewer x:Name="ScrollResult" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <Grid x:Name="CanvasResult" MouseMove="Viewport_MouseMove" MouseLeave="Viewport_MouseLeave">
                                <Image x:Name="ImgResult" Stretch="None"/>
                                <Canvas x:Name="OverlayResultCanvas" IsHitTestVisible="False"/>
                            </Grid>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>

            <!-- SPLITTER -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#2B2B2B"/>

            <!-- RIGHT DOCKING INSPECTOR PANEL -->
            <Border Grid.Column="2" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1,0,0,0">
                <TabControl x:Name="InspectorTabs" Background="Transparent" BorderThickness="0">
                    
                    <!-- TAB 1: PARAMETER & CONTROL -->
                    <TabItem Header="⚙️ Parameter">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Pipeline-Konfiguration" FontWeight="Bold" FontSize="14" Foreground="#4EC9B0" Margin="0,0,0,10"/>

                                <TextBlock Text="Schwellenwert-Faktor k (Streuung):" Margin="0,4,0,2"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="45"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="SliderK" Minimum="1.0" Maximum="5.0" Value="2.5" SmallChange="0.1" ValueChanged="SliderK_ValueChanged" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ElementName=SliderK, Path=Value, StringFormat={}{0:F2}}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Bold"/>
                                </Grid>

                                <TextBlock Text="Morphologie Kernel-Faktor:" Margin="0,8,0,2"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="45"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="SliderKernel" Minimum="0.01" Maximum="0.12" Value="0.05" SmallChange="0.01" ValueChanged="SliderKernel_ValueChanged" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ElementName=SliderKernel, Path=Value, StringFormat={}{0:P0}}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Bold"/>
                                </Grid>

                                <TextBlock Text="Statistisches Modell:" Margin="0,8,0,2"/>
                                <ComboBox x:Name="ComboThresholdMode" SelectedIndex="0" Background="#333337" Foreground="{StaticResource TextLight}">
                                    <ComboBoxItem Content="Robustes MAD (Median Absolute Deviation)"/>
                                    <ComboBoxItem Content="Gauß-Verteilung (Mittelwert ± k*Sigma)"/>
                                </ComboBox>

                                <Separator Margin="0,14" Background="{StaticResource BorderColor}"/>

                                <TextBlock Text="Zusatzmodule:" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <CheckBox x:Name="ChkFrangi" Content="Venen- &amp; Adernkartierung (Frangi-Hesse)" IsChecked="True" Foreground="{StaticResource TextLight}" Margin="0,3"/>
                                <CheckBox x:Name="ChkPerfusion" Content="Longitudinaler Temperaturgradient" IsChecked="True" Foreground="{StaticResource TextLight}" Margin="0,3"/>
                                <CheckBox x:Name="ChkErodeMargin" Content="Gewebekanten-Erosion (Chamfer Distanz)" IsChecked="True" Foreground="{StaticResource TextLight}" Margin="0,3"/>

                                <Separator Margin="0,14" Background="{StaticResource BorderColor}"/>

                                <Button Content="🚀 Neu berechnen (Go Core + AVX2)" Click="BtnRunAnalysis_Click" Background="#0E639C" Height="36" FontSize="13"/>

                                <Border Background="#1C1C1E" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Messwerte der aktuellen Pipeline:" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                        <TextBlock x:Name="TxtTissuePixels" Text="Gewebe-Pixel: --" Margin="0,4,0,1" FontSize="11"/>
                                        <TextBlock x:Name="TxtHotspotCount" Text="Gefundene Herde: --" Margin="0,1" FontSize="11"/>
                                        <TextBlock x:Name="TxtLatency" Text="Rechenzeit: -- ms" Margin="0,1" FontSize="11" Foreground="#4EC9B0" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- TAB 2: DETECTED HOTSPOTS TABLE -->
                    <TabItem Header="🔬 Herde &amp; Befunde">
                        <Grid Margin="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Klinisch auffällige Entzündungsareale:" FontWeight="Bold" Margin="4,4,4,8" Foreground="#4EC9B0"/>

                            <DataGrid Grid.Row="1" x:Name="GridHotspots" SelectionChanged="GridHotspots_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Region.Id}" Width="35"/>
                                    <DataGridTextColumn Header="Fläche" Binding="{Binding Region.AreaPixels}" Width="55"/>
                                    <DataGridTextColumn Header="Anteil %" Binding="{Binding Region.AreaPercent}" Width="60"/>
                                    <DataGridTextColumn Header="Max T" Binding="{Binding Region.MaxVal}" Width="50"/>
                                    <DataGridTextColumn Header="Circularity" Binding="{Binding Region.Circularity}" Width="70"/>
                                    <DataGridTextColumn Header="Risiko" Binding="{Binding Assessment.RiskLevel}" Width="75"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Grid.Row="2" Background="#1E1E1E" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Padding="8" Margin="0,6,0,0">
                                <StackPanel>
                                    <TextBlock Text="Klinische Empfehlung (aus Lua):" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock x:Name="TxtLuaRecommendation" Text="Wählen Sie einen Herd in der Tabelle aus..." TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12" Foreground="#CE9178"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- TAB 3: PERFUSION & GRADIENT -->
                    <TabItem Header="🩸 Perfusion">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Perfusion &amp; Gefäßgesundheit" FontWeight="Bold" FontSize="14" Foreground="#4EC9B0" Margin="0,0,0,10"/>

                                <Border Background="#1C1C1E" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Longitudinaler Temperaturabfall (dT/dy):" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                                        <TextBlock x:Name="TxtPerfusionStatus" Text="STATUS: --" FontSize="13" FontWeight="Bold" Margin="0,4,0,2"/>
                                        <TextBlock x:Name="TxtPerfusionDrop" Text="Maximaler Abfall: -- K/cm" FontSize="12" Margin="0,2"/>
                                        <TextBlock x:Name="TxtPerfusionDesc" Text="Keine Daten geladen." TextWrapping="Wrap" Margin="0,6,0,0" FontSize="11" Foreground="#CCCCCC"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Interpretation:" FontWeight="Bold" Margin="0,4,0,2"/>
                                <TextBlock Text="• Ein starker Temperaturabfall in Richtung der Zehen (> 4.5 K) weist auf eine periphere arterielle Verschlusskrankheit (pAVK) oder diabetische Mikroangiopathie hin." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,2"/>
                                <TextBlock Text="• Gleichmäßige Verläufe kennzeichnen eine physiologische Gefäßdurchblutung." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,2"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- TAB 4: BILATERAL SYMMETRY (ARMSTRONG) -->
                    <TabItem Header="⚖️ Seitenvergleich">
                        <Grid Margin="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="4,4,4,8">
                                <TextBlock Text="Bilateraler Seitenvergleich (L vs R)" FontWeight="Bold" FontSize="13" Foreground="#4EC9B0"/>
                                <TextBlock Text="Armstrong-Kriterium: ΔT >= 2.2 K = aktiver Entzündungsherd" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                            </StackPanel>

                            <DataGrid Grid.Row="1" x:Name="GridSymmetry">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Anatomische Zone" Binding="{Binding Name}" Width="150"/>
                                    <DataGridTextColumn Header="Links" Binding="{Binding LeftMean, StringFormat={}{0:F1}}" Width="50"/>
                                    <DataGridTextColumn Header="Rechts" Binding="{Binding RightMean, StringFormat={}{0:F1}}" Width="50"/>
                                    <DataGridTextColumn Header="ΔT" Binding="{Binding DeltaT, StringFormat={}{0:F1}}" Width="50"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Grid.Row="2" Background="#1E1E1E" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Padding="8" Margin="0,6,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="TxtSymmetryAssessment" Text="Laden Sie zwei Bilder für den Seitenvergleich." TextWrapping="Wrap" FontSize="11" Foreground="#4EC9B0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- TAB 5: LUA SCRIPT ENGINE -->
                    <TabItem Header="📜 Lua-Regeln">
                        <Grid Margin="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Klinische Diagnose-Logik (Live-Skript):" FontWeight="Bold" Margin="4,4,4,6" Foreground="#4EC9B0"/>

                            <TextBox Grid.Row="1" x:Name="TxtLuaCode" FontFamily="Consolas, Cascadia Code, Courier New" FontSize="12" Background="#141414" Foreground="#DCDCDC" BorderBrush="{StaticResource BorderColor}" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                <Button Content="Standard wiederherstellen" Click="BtnResetLua_Click"/>
                                <Button Content="💾 Regel anwenden" Click="BtnApplyLua_Click" Background="#0E639C"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <!-- TAB 6: GDPR AUDIT LOG (SQLITE) -->
                    <TabItem Header="🛡️ DSGVO &amp; Log">
                        <Grid Margin="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Revisionssichere Untersuchungshistorie (SQLite):" FontWeight="Bold" Margin="4,4,4,6" Foreground="#4EC9B0"/>

                            <DataGrid Grid.Row="1" x:Name="GridAudit">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="30"/>
                                    <DataGridTextColumn Header="Zeit" Binding="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" Width="65"/>
                                    <DataGridTextColumn Header="Patienten-Hash" Binding="{Binding PatientHash}" Width="95"/>
                                    <DataGridTextColumn Header="Modus" Binding="{Binding Mode}" Width="75"/>
                                    <DataGridTextColumn Header="Herde" Binding="{Binding HotspotCount}" Width="45"/>
                                    <DataGridTextColumn Header="Risiko" Binding="{Binding HighestRisk}" Width="75"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- 4. BOTTOM STATUS BAR -->
        <Border Grid.Row="3" Background="{StaticResource HeaderBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0" Padding="8,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" x:Name="StatusText" Text="Bereit. Laden Sie ein Infrarotbild zum Starten." FontSize="11" Foreground="#9E9E9E" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1" x:Name="CursorCoordsText" Text="X: --, Y: -- | Temp: --" FontSize="11" FontFamily="Consolas" Foreground="#CE9178" Margin="10,0" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="2" x:Name="EngineTimingText" Text="Go Core: -- ms (AVX2 aktiv)" FontSize="11" FontFamily="Consolas" Foreground="#4EC9B0" Margin="10,0" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="3" x:Name="LuaRuleText" Text="Regeln: armstrong_criteria.lua" FontSize="11" Foreground="#DCDCDC" Margin="10,0" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="4" x:Name="PatientIdText" Text="DSGVO: ANON-4f9a2b" FontSize="11" FontWeight="Bold" Foreground="#007ACC" Margin="10,0" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
