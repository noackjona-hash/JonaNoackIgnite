                                                    <TextBlock Text="MAD STREUUNG" FontSize="9" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                                                    <TextBlock x:Name="TxtHistoMad" Text="-- K" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="2" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8,6" Margin="3,0,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="SCHWELLE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource CriticalBrush}"/>
                                                    <TextBlock x:Name="TxtHistoThreshold" Text="-- °C" FontSize="14" FontWeight="Bold" Foreground="{StaticResource CriticalBrush}"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Histogram Canvas -->
                                        <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="6" Height="190">
                                            <Canvas x:Name="CanvasHistogram" ClipToBounds="True" Background="Transparent" SizeChanged="CanvasHistogram_SizeChanged"/>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <!-- TAB 4: THERMAL LINE PROFILE T(s) -->
                            <TabItem x:Name="TabProfile">
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconProfile}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0" SnapsToDevicePixels="True"/>
                                        <TextBlock Text="Profil (%)" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </TabItem.Header>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="Thermisches Schnittprofil T(s)" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource CyanBrush}" Margin="0,0,0,2"/>
                                        <TextBlock Text="Temperaturverlauf entlang des gezogenen Messvektors (Pixelgenau, ohne Offset)." FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"/>

                                        <!-- KPI Grid -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8,6" Margin="0,0,3,0">
                                                <StackPanel>
                                                    <TextBlock Text="T MIN" FontSize="9" FontWeight="Bold" Foreground="{StaticResource CyanBrush}"/>
                                                    <TextBlock x:Name="TxtProfileMinTemp" Text="-- °C" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="1" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8,6" Margin="3,0">
                                                <StackPanel>
                                                    <TextBlock Text="T MAX" FontSize="9" FontWeight="Bold" Foreground="{StaticResource CriticalBrush}"/>
                                                    <TextBlock x:Name="TxtProfileMaxTemp" Text="-- °C" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="2" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8,6" Margin="3,0,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="T MITTEL" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <TextBlock x:Name="TxtProfileMeanTemp" Text="-- °C" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10,6" Margin="0,0,0,10">
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock x:Name="TxtProfileLength" Text="Pfadlänge: -- px" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock x:Name="TxtProfileMaxGrad" Text="Maximaler Gradient: -- K/px" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Button HorizontalAlignment="Right" Click="BtnCopyProfileCsv_Click" Padding="8,3">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource IconCopy}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,5,0" SnapsToDevicePixels="True"/>
                                                        <TextBlock Text="CSV KOPIEREN" FontSize="10" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Border>

                                        <!-- Vector Graph -->
                                        <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="6" Height="200">
                                            <Canvas x:Name="CanvasProfileGraph" ClipToBounds="True" Background="Transparent" SizeChanged="CanvasProfileGraph_SizeChanged"/>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <!-- TAB 5: POINT TEMPERATURE PROBES -->
                            <TabItem x:Name="TabProbes">
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconProbe}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0" SnapsToDevicePixels="True"/>
                                        <TextBlock Text="Sonden" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </TabItem.Header>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="Klinische Punkt-Temperatursonden (P₁ ... Pn)" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource CyanBrush}" Margin="0,0,0,2"/>
                                        <TextBlock Text="Manuelle Platzierung von Messsonden für bilateralen Armstrong-Seitenvergleich." FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"/>

                                        <!-- Armstrong Delta T Callout Card -->
                                        <Border x:Name="BorderArmstrongRiskCard" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="ARMSTRONG-VERGLEICH (P₁ vs P₂):" FontWeight="Bold" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                                    <Border x:Name="BadgeArmstrongState" HorizontalAlignment="Right" Background="#E0F2FE" BorderBrush="{StaticResource CyanBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1">
                                                        <TextBlock x:Name="TxtProbeRiskBadge" Text="KEINE DATEN" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource CyanBrush}"/>
                                                    </Border>
                                                </Grid>
                                                <TextBlock x:Name="TxtProbeDeltaT" Text="ΔT = -- K" FontSize="22" FontWeight="Black" Foreground="{StaticResource CyanBrush}" Margin="0,4,0,2"/>
                                                <TextBlock x:Name="TxtProbeAssessment" Text="Klicken Sie im Bild auf zwei homologe Stellen." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Probes List -->
                                        <TextBlock Text="Gesetzte Messpunkte:" FontWeight="Bold" FontSize="11" Margin="0,0,0,6"/>
                                        <DataGrid x:Name="GridProbes" MaxHeight="170">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Sonde" Binding="{Binding Label}" Width="50"/>
                                                <DataGridTextColumn Header="X" Binding="{Binding Position.X, StringFormat={}{0:F0}}" Width="45"/>
                                                <DataGridTextColumn Header="Y" Binding="{Binding Position.Y, StringFormat={}{0:F0}}" Width="45"/>
                                                <DataGridTextColumn Header="Raw" Binding="{Binding RawVal}" Width="45"/>
                                                <DataGridTextColumn Header="Temperatur" Binding="{Binding Temperature, StringFormat={}{0:F1} °C}" Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <Button Click="BtnResetProbes_Click" HorizontalAlignment="Right" Margin="0,10,0,0" Padding="10,4">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconTrash}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" SnapsToDevicePixels="True"/>
                                                <TextBlock Text="SONDEN ZURÜCKSETZEN" FontSize="10" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <!-- TAB 6: ANATOMISCHE FUSS-ZONEN MATRIX -->
                            <TabItem x:Name="TabAnatomy">
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconAnatomy}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0" SnapsToDevicePixels="True"/>
                                        <TextBlock Text="5-Zonen" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </TabItem.Header>
                                <Grid Margin="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                        <TextBlock Text="Anatomische Zonen-Matrix (Armstrong-Pflock-Zonen)" FontWeight="Bold" FontSize="13" Foreground="{StaticResource CyanBrush}"/>
