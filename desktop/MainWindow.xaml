                                                            <TextBlock x:Name="TxtGoniometerAngle" Text="-- °" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Grid.Column="1" Background="#F1F5F9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8,5" Margin="3,0,0,0">
                                                        <StackPanel>
                                                            <TextBlock Text="SCHWEREGRAD" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                                                            <TextBlock x:Name="TxtGoniometerGrade" Text="Grad 0" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>

                                                <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4">
                                                    <TextBlock x:Name="TxtGoniometerIndication" Text="Klicken Sie im Bild auf 3 Punkte zur Achsenmessung..." TextWrapping="Wrap" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
