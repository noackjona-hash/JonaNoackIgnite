                            <!-- TAB: BIOMECHANICS & PENNES BIOHEAT PRESSURE PROXY -->
                            <TabItem x:Name="TabBiomechanics">
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconPressure}" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0" SnapsToDevicePixels="True"/>
