                                        <TextBlock Text="Schwellenwert-Faktor k (Standard: 3.0):" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,2"/>
                                        <Grid>
                                            <Slider x:Name="SliderK" Minimum="1.5" Maximum="5.0" Value="3.0" SmallChange="0.1" ValueChanged="SliderK_ValueChanged" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding ElementName=SliderK, Path=Value, StringFormat={}{0:F1}}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Bold" Foreground="{StaticResource CyanBrush}" FontSize="11"/>
                                        </Grid>
                                        <TextBlock Text="Vielfaches (k * MAD), ab dem ein Areal als Entzündung gilt." FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Top-Hat Morphological Radius -->
                                <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Morphologie Kernel-Radius (AVX2 Top-Hat):" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,2"/>
                                        <Grid>
                                            <Slider x:Name="SliderKernel" Minimum="0.01" Maximum="0.12" Value="0.05" SmallChange="0.01" ValueChanged="SliderKernel_ValueChanged" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding ElementName=SliderKernel, Path=Value, StringFormat={}{0:P0}}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Bold" Foreground="{StaticResource CyanBrush}" FontSize="11"/>
                                        </Grid>
                                        <TextBlock Text="Größe des Strukturelements relativ zur Bildauflösung." FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Threshold Mode Selector -->
                                <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Statistisches Ausreißer-Modell:" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="ComboThresholdMode" SelectedIndex="0" Background="#101420" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11">
                                            <ComboBoxItem Content="Robustes MAD (Median Absolute Deviation) — Empfohlen"/>
                                            <ComboBoxItem Content="Gauß-Verteilung (Mittelwert ± k*Sigma)"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Border>

                                <!-- Feature Checkboxes -->
                                <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Klinische Module:" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6"/>
                                        <CheckBox x:Name="ChkFrangi" Content="Venenkartierung aktivieren (Frangi-Hesse Filter)" IsChecked="True" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,3" FontSize="11"/>
                                        <CheckBox x:Name="ChkPerfusion" Content="Longitudinaler Temperaturgradient (dT/dy)" IsChecked="True" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,3" FontSize="11"/>
                                        <CheckBox x:Name="ChkAnatomicalCutoff" Content="Anatomischer Cutoff (Waden oberhalb 65% filtern)" IsChecked="True" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,3" FontSize="11"/>
                                        <CheckBox x:Name="ChkErodeMargin" Content="Gewebekanten-Erosion (Chamfer-Distanz)" IsChecked="True" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,3" FontSize="11"/>
                                    </StackPanel>
                                </Border>

                                <Button Content="⚡ Gesamte Pipeline neu berechnen (Go Core + AVX2)" Click="BtnRunAnalysis_Click" Background="#2563EB" Height="36" FontSize="12" Foreground="White" FontWeight="Bold"/>

                                <!-- Live Metrics Card -->
                                <Border Background="#0D121D" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="HARDWARE-LATENZ (AVX2 GEMESSEN)" FontWeight="Bold" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock x:Name="TxtTissuePixels" Text="Gewebe-Pixel: --" Margin="0,4,0,2" FontSize="11"/>
                                        <TextBlock x:Name="TxtHotspotCount" Text="Gefundene Herde: --" Margin="0,2" FontSize="11"/>
                                        <TextBlock x:Name="TxtLatency" Text="Rechenzeit: -- ms" Margin="0,2" FontSize="11" Foreground="{StaticResource CyanBrush}" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- TAB 2: DETECTED HOTSPOTS TABLE -->
                    <TabItem Header="🔬 Herde">
