                                    <RadioButton x:Name="RbToolProfile" Style="{StaticResource VoicemodDockRadioStyle}" GroupName="CanvasTools" Content="📈 PROFIL" Checked="ToolRadio_Checked" ToolTip="Linie für Temperatur-Schnittprofil ziehen"/>
                                    <RadioButton x:Name="RbToolProbe" Style="{StaticResource VoicemodDockRadioStyle}" GroupName="CanvasTools" Content="📍 SONDEN" Checked="ToolRadio_Checked" ToolTip="Punkt-Messsonden P1, P2 setzen"/>
                                    <RadioButton x:Name="RbToolWL" Style="{StaticResource VoicemodDockRadioStyle}" GroupName="CanvasTools" Content="◐ W/L" Checked="ToolRadio_Checked" ToolTip="Interaktive Kontrast- &amp; Helligkeitsfensterung"/>

                                    <Separator Width="1" Height="22" Margin="8,0" Background="{StaticResource BorderBrush}"/>

                                    <!-- Big Glowing Cyan Action Trigger (Central Mic equivalent in Voicemod) -->
                                    <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource CyanBrush}" Cursor="Hand" Margin="2,0" 
                                            MouseDown="BtnCentralRun_MouseDown" ToolTip="Diagnose sofort ausführen (AVX2 SIMD Core)">
                                        <TextBlock Text="⚡" FontSize="20" FontWeight="Black" Foreground="#080B10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <Separator Width="1" Height="22" Margin="8,0" Background="{StaticResource BorderBrush}"/>

                                    <!-- Quick Zoom Controls -->
                                    <Button Content="-" Click="BtnZoomOut_Click" Width="28" Height="28" Padding="0" Margin="2,0" ToolTip="Zoom verkleinern"/>
                                    <Button Content="100%" Click="BtnZoomReset_Click" Height="28" Padding="8,0" Margin="2,0" FontSize="10.5" ToolTip="Originalgröße"/>
                                    <Button Content="+" Click="BtnZoomIn_Click" Width="28" Height="28" Padding="0" Margin="2,0" ToolTip="Zoom vergrößern"/>
                                    <Button Content="⛶ FIT" Click="BtnZoomFit_Click" Height="28" Padding="8,0" Margin="2,0" FontSize="10.5" ToolTip="Ganzes Bild einpassen"/>
                                </StackPanel>
                            </Border>

                            <!-- Analysis Progress Bar -->
                            <ProgressBar Grid.Row="1" x:Name="AnalysisProgressBar" Height="3" IsIndeterminate="True" Foreground="{StaticResource CyanBrush}" Background="Transparent" BorderThickness="0" VerticalAlignment="Top" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- SPLITTER -->
                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

                <!-- ============================================================ -->
                <!-- VOICEMOD RIGHT INSPECTOR / CONTROL PANEL                     -->
                <!-- Dark glass cards, rectangular value badges on sliders        -->
                <!-- ============================================================ -->
                <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Active Profile / Examination Card -->
                            <RowDefinition Height="*"/>    <!-- Inspector Tabs -->
                        </Grid.RowDefinitions>

                        <!-- Top Voicemod Active Case Header Card -->
                        <Border Grid.Row="0" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" CornerRadius="15,15,0,0" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Case Thumbnail Squircle -->
                                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="14" Background="#111622" BorderBrush="{StaticResource CyanBrush}" BorderThickness="1.5" Margin="0,0,12,0">
                                    <TextBlock Text="🩻" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Demographics & Subtitle -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Gerhard Mustern" FontWeight="Bold" FontSize="13.5" Foreground="#FFFFFF"/>
                                    <TextBlock Text="DFS-2026-8812 · 68 J. (M)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                    <Border HorizontalAlignment="Left" Background="#132734" CornerRadius="4" Padding="6,1" Margin="0,3,0,0">
                                        <TextBlock Text="ARMSTRONG STADIUM 0" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource CyanBrush}"/>
                                    </Border>
                                </StackPanel>

                                <!-- Quick Report Export -->
                                <Button Grid.Column="2" Content="📄 Export" Click="MenuExportReport_Click" Padding="10,5" Background="#142636" BorderBrush="{StaticResource CyanBrush}" Foreground="{StaticResource CyanBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Inspector Tabs -->
                        <TabControl Grid.Row="1" x:Name="InspectorTabs" Background="Transparent" BorderThickness="0">

                            <!-- TAB 0: VASCULAR & VEIN ANGIOGRAPHY (VOICEMOD SLIDER STYLE) -->
                            <TabItem x:Name="TabVascular" Header="🩸 Vaskulär">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="Vaskuläre Gefäßkartierung (Frangi-Hesse)" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource CyanBrush}" Margin="0,0,0,3"/>
                                        <TextBlock Text="Hesse-Matrix Eigenwerte (λ1, λ2) mit Randunterdrückung &amp; 99.5-Perzentil Normalisierung zur Gefäßisolierung." 
                                                   TextWrapping="Wrap" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>

                                        <!-- Visualization Mode Selector Card -->
                                        <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="Farb- &amp; Darstellungsmodus:" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6"/>
                                                <ComboBox x:Name="ComboVeinRenderMode" SelectionChanged="ComboVeinRenderMode_SelectionChanged">
                                                    <ComboBoxItem Content="1. Fluoreszierendes Cyan (Standard-Überlagerung)" IsSelected="True"/>
                                                    <ComboBoxItem Content="2. Digitale Subtraktions-Angiographie (DSA Gefäßbaum)"/>
                                                    <ComboBoxItem Content="3. Königliches Kobaltblau (Klassischer Venenfarbton)"/>
                                                    <ComboBoxItem Content="4. ICG Chirurgisches Grün (Fluoreszenz)"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </Border>

                                        <!-- VOICEMOD SLIDER: VEIN OPACITY -->
                                        <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="👁️" Margin="0,0,6,0" FontSize="12"/>
                                                        <TextBlock Text="Deckkraft / Opazität" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <!-- Voicemod Dark Value Box -->
                                                    <Border HorizontalAlignment="Right" Background="#111520" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,3">
                                                        <TextBlock x:Name="TxtVeinOpacity" Text="85%" FontWeight="Bold" Foreground="{StaticResource CyanBrush}" FontSize="11"/>
                                                    </Border>
                                                </Grid>
                                                <Slider x:Name="SliderVeinOpacity" Minimum="0.1" Maximum="1.0" Value="0.85" SmallChange="0.05" ValueChanged="SliderVeinOpacity_ValueChanged"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- VOICEMOD SLIDER: VEIN SENSITIVITY THRESHOLD -->
                                        <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="🔉" Margin="0,0,6,0" FontSize="12"/>
                                                        <TextBlock Text="Gefäß-Empfindlichkeit (Schwelle)" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <!-- Voicemod Dark Value Box -->
                                                    <Border HorizontalAlignment="Right" Background="#111520" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,3">
                                                        <TextBlock x:Name="TxtVeinThreshold" Text="20" FontWeight="Bold" Foreground="{StaticResource CyanBrush}" FontSize="11"/>
                                                    </Border>
                                                </Grid>
                                                <Slider x:Name="SliderVeinThreshold" Minimum="5" Maximum="120" Value="20" SmallChange="5" ValueChanged="SliderVeinThreshold_ValueChanged"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Recompute Action Button (Primary Cyan) -->
                                        <Button Content="FRANGI-FILTER NEU BERECHNEN" Click="BtnRecalcVeins_Click" Style="{StaticResource VoicemodPrimaryButtonStyle}" Margin="0,2,0,10"/>

                                        <!-- Metric Information Card -->
                                        <Border Background="#10141E" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12">
                                            <StackPanel>
                                                <TextBlock Text="VASKULÄRE METRIKEN &amp; PARAMETER:" FontWeight="Bold" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                                                <TextBlock x:Name="TxtVesselCoverage" Text="• Gefäßabdeckung: 4.8% des Gewebes" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2"/>
                                                <TextBlock Text="• Frangi-Skalen: σ ∈ {1.2, 2.0, 3.2, 4.8} mm" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2"/>
                                                <TextBlock Text="• Randbereinigung: Distanz-Maske unterdrückt Kantenkälte." FontSize="10.5" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <!-- TAB 1: STRUCTURED CLINICAL FINDINGS (ARZTBERICHT) -->
                            <TabItem Header="📋 Arztbericht">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="Strukturierter Ärztlicher Befundbericht" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource CyanBrush}" Margin="0,0,0,2"/>
                                        <TextBlock Text="Automatisierte klinische Befundung nach IWGDF-Leitlinien &amp; Wagner-Armstrong Kriterien." FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                        <!-- Patient Metadata Card -->
                                        <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Row="0" Grid.Column="0">
                                                    <TextBlock Text="PATIENT:" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                                    <TextBlock Text="Mustern, Gerhard (M, 68 J.)" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                </StackPanel>
                                                <StackPanel Grid.Row="0" Grid.Column="1">
                                                    <TextBlock Text="FALL-ID:" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                                    <TextBlock Text="DFS-2026-8812 / #940214" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                </StackPanel>

                                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,8,0,0">
                                                    <TextBlock Text="INDIKATION:" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                                    <TextBlock Text="V.a. Diabetisches Fußsyndrom" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,8,0,0">
                                                    <TextBlock Text="AKQUISITION:" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                                    <TextBlock Text="01.10.2026 14:22:15 CET" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Triage Badge -->
                                        <Border Background="#1C1520" BorderBrush="{StaticResource CriticalBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="DIAGNOSTISCHE EINSTUFUNG:" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource CriticalBrush}"/>
                                                    <Border HorizontalAlignment="Right" Background="{StaticResource CriticalBrush}" CornerRadius="4" Padding="6,1">
                                                        <TextBlock Text="ARMSTRONG STADIUM 1B" FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="Subklinischer Entzündungsfokus (Prä-Ulkus)" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF" Margin="0,4,0,2"/>
                                                <TextBlock Text="Seitenasymmetrie ΔT = +2.85 K überschreitet die Armstrong-Gefahrengrenze (≥ 2.2 K). Hohes Risiko eines bevorstehenden Gewebedurchbruchs." FontSize="10.5" Foreground="#FCA5A5" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Findings Detailed Box -->
                                        <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="Objektive Radiometrische Befunde:" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                                <TextBlock Text="• Thermografische Untersuchung beider Plantarflächen im standardisierten Temperaturfenster (20.0°C–42.0°C).&#x0a;• Im Bereich Os metatarsale I/II rechts fokale Hyperthermie mit T_max = 36.4°C.&#x0a;• Kontralaterale Differenz zum linken Fuß: ΔT = +2.85 K (Signifikanzgrenze ≥ 2.2 K nach Armstrong et al. erfüllt).&#x0a;• Multiskalige Frangi-Hesse-Analyse: Ausschluss oberflächlicher Gefäßdilatation im Hotspot.&#x0a;• Longitudinaler Perfusionsgradient: dT/dy = -0.42 K/cm ohne distalen Durchblutungsabbruch." 
                                                           TextWrapping="Wrap" FontSize="10.5" FontFamily="Consolas, Segoe UI" Foreground="{StaticResource TextPrimaryBrush}" LineHeight="16"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Export Button -->
                                        <Button Content="📄 PDF-Befundbericht generieren" Click="MenuExportReport_Click" Style="{StaticResource VoicemodPrimaryButtonStyle}" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <!-- TAB 2: PARAMETERS & WINDOW/LEVEL (VOICEMOD SLIDER STYLE) -->
                            <TabItem Header="⚙️ Parameter">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="Diagnostische Pipeline-Parameter" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource CyanBrush}" Margin="0,0,0,10"/>

                                        <!-- Window / Level Card -->
                                        <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="DICOM Fensterung (Window / Level):" FontWeight="Bold" FontSize="11" Margin="0,0,0,8"/>
                                                
                                                <!-- W Slider -->
                                                <Grid Margin="0,0,0,6">
                                                    <TextBlock Text="Fensterbreite (Kontrast W)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                    <Border HorizontalAlignment="Right" Background="#111520" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,3">
                                                        <TextBlock x:Name="TxtWindowWidth" Text="255" FontWeight="Bold" Foreground="{StaticResource CyanBrush}" FontSize="11"/>
                                                    </Border>
