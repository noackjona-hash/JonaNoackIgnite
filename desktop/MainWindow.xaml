                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Klinische Entscheidungslogik (Eingebettetes Lua 5.1):" FontWeight="Bold" Margin="0,0,0,6" Foreground="{StaticResource CyanBrush}" FontSize="12"/>

                            <TextBox Grid.Row="1" x:Name="TxtLuaCode" 
                                     FontFamily="Consolas, Cascadia Code, Courier New" FontSize="11.5" 
                                     Background="#06090F" Foreground="#A9B7C6" BorderBrush="{StaticResource BorderBrush}"
                                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                <Button Content="STANDARD WIEDERHERSTELLEN" Click="BtnResetLua_Click"/>
                                <Button Content="REGEL SPEICHERN &amp; ANWENDEN" Click="BtnApplyLua_Click" Background="#14253A" Foreground="{StaticResource CyanBrush}"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <!-- TAB 11: AUDIT TRAIL (SQLITE) -->
                    <TabItem Header="🗄️ DSGVO Audit">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="DSGVO Art. 30 Evaluationsprotokoll (SQLite):" FontWeight="Bold" Margin="0,0,0,6" Foreground="{StaticResource CyanBrush}" FontSize="12"/>

                            <DataGrid Grid.Row="1" x:Name="GridAudit">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="30"/>
                                    <DataGridTextColumn Header="Zeitstempel" Binding="{Binding Timestamp}" Width="125"/>
                                    <DataGridTextColumn Header="Patient" Binding="{Binding PatientId}" Width="90"/>
                                    <DataGridTextColumn Header="Modus" Binding="{Binding AnalysisType}" Width="110"/>
                                    <DataGridTextColumn Header="Herde" Binding="{Binding HotspotsFound}" Width="45"/>
                                    <DataGridTextColumn Header="Max ΔT" Binding="{Binding MaxDeltaT, StringFormat={}{0:F1} K}" Width="60"/>
                                    <DataGridTextColumn Header="Risiko" Binding="{Binding RiskLevel}" Width="75"/>
                                    <DataGridTextColumn Header="Laufzeit" Binding="{Binding ExecutionTimeMs, StringFormat={}{0:F1} ms}" Width="65"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                </TabControl>
            </Border>
        </Grid>

        <!-- ============================================================ -->
        <!-- 4. BOTTOM PACS FILMSTRIP / CASE SERIES STRIP                 -->
        <!-- ============================================================ -->
        <Border Grid.Row="4" x:Name="FilmstripContainer" Background="#070A10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- Filmstrip Header Bar -->
                <Border Grid.Row="0" Background="#0C101A" Padding="10,2">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="KLINISCHE SERIE &amp; TESTFÄLLE (PACS ARCHIV)" FontWeight="Bold" FontSize="10" Foreground="{StaticResource CyanBrush}"/>
                            <TextBlock x:Name="TxtFilmstripCount" Text=" (21 Patientenfälle)" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="4,0,0,0"/>
                            <TextBlock Text=" · 1 Klick zum sofortigen Laden &amp; Analysieren" FontSize="9.5" Foreground="{StaticResource TextMutedBrush}" Margin="8,0,0,0"/>
                        </StackPanel>
                        <Button x:Name="BtnToggleFilmstrip" HorizontalAlignment="Right" Content="Ausblenden" Click="BtnToggleFilmstrip_Click" Padding="6,1" FontSize="9.5" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>
                </Border>
                <!-- Horizontal Scrollable Filmstrip of Cases -->
                <ScrollViewer Grid.Row="1" x:Name="ScrollFilmstrip" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="6,6">
                    <StackPanel x:Name="PanelFilmstrip" Orientation="Horizontal"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- 5. CLINICAL STATUS & TELEMETRY BAR                           -->
        <!-- ============================================================ -->
        <Border Grid.Row="5" Background="#06080E" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Status Message & Active Tool Prompt -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="●" Foreground="{StaticResource SuccessBrush}" FontSize="9" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Text="Bereit für radiologische Befundung. Studie laden (Strg+O) oder DICOM-Fall auswählen." FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Center: Hardware Telemetry -->
                <TextBlock Grid.Column="1" Text="SIMD Hardware-Beschleunigung: x86_64 AVX2 256-Bit (32 Pixel/Takt)" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="14,0"/>

                <!-- Right: Real-time Cursor Coordinates & Temperature -->
                <TextBlock Grid.Column="2" x:Name="CursorCoordsText" Text="X: --, Y: -- | Temp: --" FontSize="10.5" Foreground="{StaticResource CyanBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
