                                            <DataGridTextColumn Header="Max ΔT" Binding="{Binding MaxDeltaT, StringFormat={}{0:F1} K}" Width="60"/>
                                            <DataGridTextColumn Header="Risiko" Binding="{Binding RiskLevel}" Width="75"/>
                                            <DataGridTextColumn Header="Laufzeit" Binding="{Binding ExecutionTimeMs, StringFormat={}{0:F1} ms}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </TabItem>

                            <!-- TAB 14: VASCULAR & VEIN ANGIOGRAPHY -->
                            <TabItem x:Name="TabVascular" Header="🩸 Vaskulär">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="Vaskuläre Gefäßkartierung (Frangi-Hesse)" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource CyanBrush}" Margin="0,0,0,3"/>
                                        <TextBlock Text="Hesse-Matrix Eigenwerte (λ1, λ2) mit Randunterdrückung &amp; 99.5-Perzentil Normalisierung zur Gefäßisolierung." 
                                                   TextWrapping="Wrap" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>

                                        <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="Farb- &amp; Darstellungsmodus:" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6"/>
                                                <ComboBox x:Name="ComboVeinRenderMode" SelectionChanged="ComboVeinRenderMode_SelectionChanged">
                                                    <ComboBoxItem Content="1. Fluoreszierendes Cyan (Standard-Überlagerung)" IsSelected="True"/>
                                                    <ComboBoxItem Content="2. Digitale Subtraktions-Angiographie (DSA Gefäßbaum)"/>
                                                    <ComboBoxItem Content="3. Königliches Kobaltblau (Klassischer Venenfarbton)"/>
                                                    <ComboBoxItem Content="4. ICG Chirurgisches Grün (Fluoreszenz)"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6">
                                                    <TextBlock Text="Deckkraft / Opazität" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                    <Border HorizontalAlignment="Right" Background="#F1F5F9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,3">
                                                        <TextBlock x:Name="TxtVeinOpacity" Text="85%" FontWeight="Bold" Foreground="{StaticResource CyanBrush}" FontSize="11"/>
                                                    </Border>
                                                </Grid>
                                                <Slider x:Name="SliderVeinOpacity" Minimum="0.1" Maximum="1.0" Value="0.85" SmallChange="0.05" ValueChanged="SliderVeinOpacity_ValueChanged"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6">
                                                    <TextBlock Text="Gefäß-Empfindlichkeit (Schwelle)" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                    <Border HorizontalAlignment="Right" Background="#F1F5F9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,3">
                                                        <TextBlock x:Name="TxtVeinThreshold" Text="20" FontWeight="Bold" Foreground="{StaticResource CyanBrush}" FontSize="11"/>
                                                    </Border>
                                                </Grid>
                                                <Slider x:Name="SliderVeinThreshold" Minimum="5" Maximum="120" Value="20" SmallChange="5" ValueChanged="SliderVeinThreshold_ValueChanged"/>
                                            </StackPanel>
                                        </Border>

                                        <Button Content="FRANGI-FILTER NEU BERECHNEN" Click="BtnRecalcVeins_Click" Style="{StaticResource VoicemodPrimaryButtonStyle}" Margin="0,2,0,10"/>

                                        <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12">
                                            <StackPanel>
                                                <TextBlock Text="VASKULÄRE METRIKEN &amp; PARAMETER:" FontWeight="Bold" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                                                <TextBlock x:Name="TxtVesselCoverage" Text="• Gefäßabdeckung: 4.8% des Gewebes" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2"/>
                                                <TextBlock Text="• Frangi-Skalen: σ ∈ {1.5, 2.5, 4.0, 6.0} mm" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2"/>
                                                <TextBlock Text="• Randbereinigung: Distanz-Maske unterdrückt Geweberandartefakte." FontSize="10.5" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <!-- TAB 15: STRUCTURED CLINICAL FINDINGS (ARZTBERICHT) -->
                            <TabItem Header="📋 Arztbericht">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="Strukturierter Ärztlicher Befundbericht" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource CyanBrush}" Margin="0,0,0,2"/>
                                        <TextBlock Text="Automatisierte klinische Befundung nach IWGDF-Leitlinien &amp; Wagner-Armstrong Kriterien." FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                        <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Row="0" Grid.Column="0">
                                                    <TextBlock Text="PATIENT:" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                                    <TextBlock Text="Mustern, Gerhard (M, 68 J.)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Row="0" Grid.Column="1">
                                                    <TextBlock Text="FALL-ID:" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                                    <TextBlock Text="DFS-2026-8812 / #940214" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                </StackPanel>

                                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,8,0,0">
                                                    <TextBlock Text="INDIKATION:" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                                    <TextBlock Text="V.a. Diabetisches Fußsyndrom" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,8,0,0">
                                                    <TextBlock Text="AKQUISITION:" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                                    <TextBlock Text="01.10.2026 14:22:15 CET" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Border Background="#FEE2E2" BorderBrush="{StaticResource CriticalBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="DIAGNOSTISCHE EINSTUFUNG:" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource CriticalBrush}"/>
                                                    <Border HorizontalAlignment="Right" Background="{StaticResource CriticalBrush}" CornerRadius="4" Padding="6,1">
                                                        <TextBlock Text="ARMSTRONG KLASSE B" FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="KRITISCHES ULKUS-RISIKO" FontSize="16" FontWeight="Black" Foreground="{StaticResource CriticalBrush}" Margin="0,4,0,2"/>
                                                <TextBlock Text="Seitenasymmetrie ΔT = +2.85 K überschreitet die Armstrong-Gefahrengrenze (≥ 2.2 K). Hohes Risiko eines bevorstehenden Gewebedurchbruchs." FontSize="10.5" Foreground="#991B1B" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="Objektive Radiometrische Befunde:" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                                <TextBlock Text="• Thermografische Untersuchung beider Plantarflächen im standardisierten Temperaturfenster (20.0°C–42.0°C).&#x0a;• Im Bereich Os metatarsale I/II rechts fokale Hyperthermie mit T_max = 36.4°C.&#x0a;• Kontralaterale Differenz zum linken Fuß: ΔT = +2.85 K (Signifikanzgrenze ≥ 2.2 K nach Armstrong et al. erfüllt).&#x0a;• Multiskalige Frangi-Hesse-Analyse: Ausschluss oberflächlicher Gefäßdilatation im Hotspot.&#x0a;• Longitudinaler Perfusionsgradient: dT/dy = -0.42 K/cm ohne distalen Durchblutungsabbruch." 
                                                           TextWrapping="Wrap" FontSize="10.5" FontFamily="Consolas, Segoe UI" Foreground="{StaticResource TextPrimaryBrush}" LineHeight="16"/>
                                            </StackPanel>
                                        </Border>

                                        <Button Content="📄 PDF-Befundbericht generieren" Click="MenuExportReport_Click" Style="{StaticResource VoicemodPrimaryButtonStyle}" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                        </TabControl>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============================================================ -->
            <!-- ROW 3: BOTTOM FILMSTRIP GALLERY                              -->
            <!-- ============================================================ -->
            <Border Grid.Row="3" x:Name="FilmstripContainer" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <Border Grid.Row="0" Background="#F8FAFC" Padding="12,2">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="■ KLINISCHE SERIE &amp; FALLREIHE (FALL ARCHIV)" FontWeight="Bold" FontSize="10.5" Foreground="{StaticResource CyanBrush}"/>
                                <TextBlock x:Name="TxtFilmstripCount" Text=" (21 Patientenfälle)" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="4,0,0,0"/>
                                <TextBlock Text=" · 1 Klick zum sofortigen Laden" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="10,0,0,0"/>
                            </StackPanel>
                            <Button x:Name="BtnToggleFilmstrip" HorizontalAlignment="Right" Content="Ausblenden" Click="BtnToggleFilmstrip_Click" Padding="6,1" FontSize="9.5" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Grid>
                    </Border>
                    
                    <ScrollViewer Grid.Row="1" x:Name="ScrollFilmstrip" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="8,8">
                        <StackPanel x:Name="PanelFilmstrip" Orientation="Horizontal"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ============================================================ -->
            <!-- ROW 4: STATUS & TELEMETRY BAR                                -->
            <!-- ============================================================ -->
            <Border Grid.Row="4" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="●" Foreground="{StaticResource CyanBrush}" FontSize="9" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText" Text="Bereit für radiologische Befundung. Bild laden oder Fall aus Filmstrip wählen." FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="SIMD x86_64 AVX2 256-Bit (32 Pixel/Takt)" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="16,0"/>

                    <TextBlock Grid.Column="2" x:Name="CursorCoordsText" Text="X: --, Y: -- | Temp: --" FontSize="10.5" Foreground="{StaticResource CyanBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
