                            <DataGrid Grid.Row="1" x:Name="GridHotspots" SelectionChanged="GridHotspots_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Region.Id}" Width="35"/>
                                    <DataGridTextColumn Header="Fläche" Binding="{Binding Region.AreaPixels}" Width="55"/>
                                    <DataGridTextColumn Header="Anteil %" Binding="{Binding Region.AreaPercent, StringFormat={}{0:F2}%}" Width="60"/>
                                    <DataGridTextColumn Header="Max T" Binding="{Binding Region.MaxVal}" Width="45"/>
                                    <DataGridTextColumn Header="Zirkul." Binding="{Binding Region.Circularity, StringFormat={}{0:F2}}" Width="50"/>
                                    <DataGridTextColumn Header="Risiko" Binding="{Binding Assessment.RiskLevel}" Width="75"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Detail Card -->
                            <Border Grid.Row="2" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="Klinische Lua-Bewertung des ausgewählten Herds:" FontWeight="Bold" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock x:Name="TxtLuaRecommendation" Text="Wählen Sie einen Herd aus der Tabelle..." TextWrapping="Wrap" Margin="0,4,0,0" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- TAB 3: DEDICATED VASCULAR & VEIN ANGIOGRAPHY TAB -->
                    <TabItem x:Name="TabVascular" Header="🩸 Venen">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Vaskuläre Gefäßkartierung (Frangi-Hesse)" FontWeight="Bold" FontSize="13" Foreground="{StaticResource CyanBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="Isoliert tubuläre Gefäßbäume über multiskalige Hesse-Eigenwerte (λ1, λ2) zur Unterscheidung von Entzündungsherden." 
                                           TextWrapping="Wrap" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"/>

                                <!-- Render Mode Selector -->
                                <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="Visualisierungs- &amp; Farbmodus:" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="ComboVeinRenderMode" SelectionChanged="ComboVeinRenderMode_SelectionChanged" Background="#101420" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11">
                                            <ComboBoxItem Content="1. Fluoreszierendes Cyan (Standard-Überlagerung)" IsSelected="True"/>
                                            <ComboBoxItem Content="2. Digitale Subtraktions-Angiographie (DSA / Reiner Gefäßbaum)"/>
                                            <ComboBoxItem Content="3. Königliches Kobaltblau (Klassischer Venenfarbton)"/>
                                            <ComboBoxItem Content="4. ICG Chirurgisches Grün (Fluoreszenz)"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Border>

                                <!-- Real-Time Opacity Slider -->
                                <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="Deckkraft / Transparenz:" FontWeight="SemiBold" FontSize="11"/>
                                            <TextBlock x:Name="TxtVeinOpacity" Text="85%" HorizontalAlignment="Right" FontWeight="Bold" Foreground="{StaticResource CyanBrush}" FontSize="11"/>
                                        </Grid>
                                        <Slider x:Name="SliderVeinOpacity" Minimum="0.1" Maximum="1.0" Value="0.85" SmallChange="0.05" Margin="0,4,0,0" ValueChanged="SliderVeinOpacity_ValueChanged"/>
                                    </StackPanel>
                                </Border>

                                <!-- Sensitivity / Threshold Slider -->
                                <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="Gefäß-Empfindlichkeit (Schwellenwert):" FontWeight="SemiBold" FontSize="11"/>
                                            <TextBlock x:Name="TxtVeinThreshold" Text="20" HorizontalAlignment="Right" FontWeight="Bold" Foreground="{StaticResource CyanBrush}" FontSize="11"/>
                                        </Grid>
                                        <Slider x:Name="SliderVeinThreshold" Minimum="5" Maximum="120" Value="20" SmallChange="5" Margin="0,4,0,0" ValueChanged="SliderVeinThreshold_ValueChanged"/>
                                    </StackPanel>
                                </Border>

                                <!-- Recompute Button -->
                                <Button Content="⚡ Frangi-Venenfilter neu berechnen" Click="BtnRecalcVeins_Click" Background="#2563EB" Height="32" FontWeight="Bold" Foreground="White" Margin="0,2,0,8"/>

                                <!-- Anatomical Vessel Info Card -->
                                <Border Background="#0D121D" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="VASKULÄRE METRIKEN &amp; PARAMETER:" FontWeight="Bold" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="TxtVesselCoverage" Text="• Gefäßabdeckung: 4.8% des Gewebes" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1"/>
                                        <TextBlock Text="• Frangi-Skalen: σ ∈ {1.2, 2.0, 3.2, 4.8} mm" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1"/>
                                        <TextBlock Text="• Differenzierung: Röhrenförmige Gefäße werden vor Hotspot-Klassifikation separiert." FontSize="10" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- TAB 4: NEW! 256-BIN RADIOMETRISCHES HISTOGRAMM -->
                    <TabItem x:Name="TabHistogram" Header="📊 Spektrum">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Radiometrisches Dichtespektrum (256-Kanal)" FontWeight="Bold" FontSize="13" Foreground="{StaticResource CyanBrush}" Margin="0,0,0,2"/>
                                <TextBlock Text="Verteilung der Gewebetemperaturen mit statistischen Trennlinien für Otsu-Hintergrund, Median und MAD-Ausreißer." FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <!-- Histogram Metrics Grid -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,2,0">
                                        <StackPanel>
                                            <TextBlock Text="MEDIAN T" FontSize="9" FontWeight="Bold" Foreground="{StaticResource CyanBrush}"/>
                                            <TextBlock x:Name="TxtHistoMedian" Text="-- °C" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="2,0">
                                        <StackPanel>
                                            <TextBlock Text="MAD STREUUNG" FontSize="9" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                                            <TextBlock x:Name="TxtHistoMad" Text="-- K" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="2,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="SCHWELLE (k*MAD)" FontSize="9" FontWeight="Bold" Foreground="{StaticResource CriticalBrush}"/>
                                            <TextBlock x:Name="TxtHistoThreshold" Text="-- °C" FontSize="13" FontWeight="Bold" Foreground="#FF5252"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Histogram Canvas -->
                                <Border Background="#05070B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="4" Height="190">
                                    <Canvas x:Name="CanvasHistogram" ClipToBounds="True" Background="#05070B" SizeChanged="CanvasHistogram_SizeChanged"/>
                                </Border>

                                <!-- Color LUT Ramp Display -->
                                <Border Height="12" Margin="0,4,0,8" CornerRadius="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#000080" Offset="0.0"/>
                                            <GradientStop Color="#800080" Offset="0.25"/>
                                            <GradientStop Color="#FF0000" Offset="0.55"/>
                                            <GradientStop Color="#FFFF00" Offset="0.8"/>
                                            <GradientStop Color="#FFFFFF" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <Border Background="#0D121D" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8">
                                    <StackPanel>
                                        <TextBlock Text="Statistische Erläuterung:" FontWeight="Bold" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                        <TextBlock Text="• Cyan = Median-Temperatur des gesunden Gewebes" FontSize="10" Foreground="{StaticResource CyanBrush}"/>
                                        <TextBlock Text="• Rot = Robuster Schwellenwert (Median + k*MAD). Pixel rechts davon werden als Entzündungsherd markiert." FontSize="10" Foreground="{StaticResource CriticalBrush}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- TAB 5: THERMAL LINE PROFILE T(s) -->
                    <TabItem x:Name="TabProfile" Header="📈 Profil T(s)">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Thermisches Schnittprofil T(s)" FontWeight="Bold" FontSize="13" Foreground="{StaticResource CyanBrush}" Margin="0,0,0,2"/>
                                <TextBlock Text="Transversaler oder longitudinaler Temperaturverlauf entlang des gezogenen Messvektors." FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <!-- Metric KPI Cards -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,2,0">
                                        <StackPanel>
                                            <TextBlock Text="T MIN" FontSize="9" FontWeight="Bold" Foreground="{StaticResource CyanBrush}"/>
                                            <TextBlock x:Name="TxtProfileMinTemp" Text="-- °C" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="2,0">
                                        <StackPanel>
                                            <TextBlock Text="T MAX" FontSize="9" FontWeight="Bold" Foreground="#FF5252"/>
                                            <TextBlock x:Name="TxtProfileMaxTemp" Text="-- °C" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="2,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="T MITTEL" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock x:Name="TxtProfileMeanTemp" Text="-- °C" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,0,0,8">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock x:Name="TxtProfileLength" Text="Pfadlänge: -- px" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock x:Name="TxtProfileMaxGrad" Text="Maximaler Gradient |dT/ds|: -- K/px" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button HorizontalAlignment="Right" Content="📋 CSV kopieren" Click="BtnCopyProfileCsv_Click" Padding="6,2" FontSize="10"/>
                                    </Grid>
                                </Border>

                                <!-- Vector Chart Display Canvas -->
                                <Border Background="#05070B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="4" Height="200">
                                    <Canvas x:Name="CanvasProfileGraph" ClipToBounds="True" Background="#05070B" SizeChanged="CanvasProfileGraph_SizeChanged"/>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- TAB 6: POINT TEMPERATURE PROBES & ARMSTRONG RISK -->
                    <TabItem x:Name="TabProbes" Header="📍 Sonden">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Klinische Punkt-Temperatursonden (P₁ ... Pn)" FontWeight="Bold" FontSize="13" Foreground="{StaticResource CyanBrush}" Margin="0,0,0,2"/>
                                <TextBlock Text="Manuelle Platzierung von Messsonden für bilateralen Armstrong-Seitenvergleich an homologen Stellen." FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <!-- Armstrong Delta T Callout Card -->
