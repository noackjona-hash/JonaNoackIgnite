                                            </Border>
                                        </Grid>
                                        <TextBlock x:Name="TxtProbeDeltaT" Text="ΔT = -- K" FontSize="22" FontWeight="Black" Foreground="{StaticResource CyanBrush}" Margin="0,4,0,2"/>
                                        <TextBlock x:Name="TxtProbeAssessment" Text="Klicken Sie im Bild auf zwei homologe Stellen (z. B. linker Großzeh &amp; rechter Großzeh)." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
