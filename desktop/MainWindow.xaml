<Window x:Class="Ignite.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IGNITE AI · Clinical Diagnostic Workstation · DIN EN ISO 13485 Research Grade"
        Height="980" Width="1620"
        Background="{StaticResource AppBgBrush}" Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable, Segoe UI, -apple-system, Arial"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        Loaded="MainWindow_Loaded">

    <Grid Background="{StaticResource AppBgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="68"/> <!-- 0: Left Voicemod Navigation Rail -->
            <ColumnDefinition Width="*"/>  <!-- 1: Main Application Shell -->
        </Grid.ColumnDefinitions>

        <!-- ============================================================ -->
        <!-- 0. VOICEMOD LEFT NAVIGATION RAIL (SIDEBAR)                   -->
        <!-- Squircles, neon cyan highlights, tooltip descriptions        -->
        <!-- ============================================================ -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Brand App Logo -->
                    <RowDefinition Height="*"/>    <!-- Navigation Squircles -->
                    <RowDefinition Height="Auto"/> <!-- User Avatar & Settings -->
                </Grid.RowDefinitions>

                <!-- Brand App Icon (Voicemod VM Logo equivalent) -->
                <Border Grid.Row="0" Margin="0,14,0,16" HorizontalAlignment="Center">
                    <Border Width="44" Height="44" CornerRadius="14" Background="{StaticResource CyanBrush}" Cursor="Hand" ToolTip="IGNITE Medical AI Workstation">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- High-energy vector logo -->
                            <TextBlock Text="⚡" FontSize="22" FontWeight="Black" Foreground="#080B10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Border>

                <!-- Navigation Rail Squircles Stack -->
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <RadioButton x:Name="RailBtnWorkstation" Style="{StaticResource VoicemodRailRadioStyle}" GroupName="NavRail" IsChecked="True" Checked="NavRail_Checked" ToolTip="Workstation / Dual-View (Strg+1)">
                        <TextBlock Text="◫" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </RadioButton>
                    
                    <RadioButton x:Name="RailBtnVascular" Style="{StaticResource VoicemodRailRadioStyle}" GroupName="NavRail" Checked="NavRail_Checked" ToolTip="Vaskuläre Gefäßkartierung / Venenfinder (Strg+2)">
                        <TextBlock Text="🩸" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </RadioButton>

                    <RadioButton x:Name="RailBtnHotspots" Style="{StaticResource VoicemodRailRadioStyle}" GroupName="NavRail" Checked="NavRail_Checked" ToolTip="Entzündungsherde &amp; Top-Hat Morphologie (Strg+3)">
                        <TextBlock Text="🔥" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </RadioButton>

                    <RadioButton x:Name="RailBtnAnatomy" Style="{StaticResource VoicemodRailRadioStyle}" GroupName="NavRail" Checked="NavRail_Checked" ToolTip="Armstrong 5-Zonen &amp; Angiosome (Strg+4)">
                        <TextBlock Text="🦶" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </RadioButton>

                    <RadioButton x:Name="RailBtnRadiometry" Style="{StaticResource VoicemodRailRadioStyle}" GroupName="NavRail" Checked="NavRail_Checked" ToolTip="Radiometrisches Spektrum &amp; Profil T(s) (Strg+5)">
                        <TextBlock Text="📊" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </RadioButton>

                    <RadioButton x:Name="RailBtnReport" Style="{StaticResource VoicemodRailRadioStyle}" GroupName="NavRail" Checked="NavRail_Checked" ToolTip="Strukturierter Arztbericht IWGDF (Strg+6)">
                        <TextBlock Text="📋" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </RadioButton>

                    <RadioButton x:Name="RailBtnParams" Style="{StaticResource VoicemodRailRadioStyle}" GroupName="NavRail" Checked="NavRail_Checked" ToolTip="Pipeline-Parameter &amp; W/L (Strg+7)">
                        <TextBlock Text="⚙️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </RadioButton>

                    <RadioButton x:Name="RailBtnAudit" Style="{StaticResource VoicemodRailRadioStyle}" GroupName="NavRail" Checked="NavRail_Checked" ToolTip="DSGVO Art. 30 Audit-Log &amp; SQLite (Strg+8)">
                        <TextBlock Text="🗄️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </RadioButton>
                </StackPanel>

                <!-- Bottom User Avatar & System Info -->
                <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14">
                    <Button Style="{StaticResource VoicemodRailButtonStyle}" Click="MenuAbout_Click" ToolTip="Info &amp; Jugend forscht 2026">
                        <TextBlock Text="ℹ️" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Border Width="40" Height="40" CornerRadius="13" Background="#171C28" BorderBrush="{StaticResource BorderBrightBrush}" BorderThickness="1.5" Margin="0,6,0,0" ToolTip="Angemeldeter Facharzt: Dr. Jona Noack">
                        <TextBlock Text="👨‍⚕️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- 1. MAIN APPLICATION SHELL                                    -->
        <!-- ============================================================ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Row 0: Voicemod Top Header & Search Bar -->
                <RowDefinition Height="Auto"/> <!-- Row 1: Sub-Navigation Filter Pill Bar -->
                <RowDefinition Height="*"/>    <!-- Row 2: Viewports Workbench & Voicemod Inspector -->
                <RowDefinition Height="Auto"/> <!-- Row 3: Bottom Filmstrip Gallery -->
                <RowDefinition Height="30"/>   <!-- Row 4: Status & Telemetry Bar -->
            </Grid.RowDefinitions>

            <!-- ============================================================ -->
            <!-- ROW 0: VOICEMOD TOP HEADER BAR                               -->
            <!-- Search bar pill, patient demographics, lime hero CTA button  -->
            <!-- ============================================================ -->
            <Border Grid.Row="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Left: Nav arrows & Search Box -->
                        <ColumnDefinition Width="*"/>    <!-- Center: Patient / Triage Chip -->
                        <ColumnDefinition Width="Auto"/> <!-- Right: Action Pills & Hero Lime CTA -->
                    </Grid.ColumnDefinitions>

                    <!-- Left: Navigation Arrows & Voicemod Search Pill -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Navigation Arrows -->
                        <Button Content="‹" Click="BtnZoomReset_Click" Width="30" Height="30" Padding="0" Margin="0,0,3,0" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" ToolTip="Zurücksetzen"/>
                        <Button Content="›" Width="30" Height="30" Padding="0" Margin="0,0,12,0" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" ToolTip="Vorwärts"/>

                        <!-- Voicemod Search Pill (In Ignite PACS suchen...) -->
                        <Border Width="340" Height="36" CornerRadius="18" Background="{StaticResource InputBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12,0">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔍" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Grid.Column="1" x:Name="SearchBox" 
                                         Background="Transparent" BorderThickness="0" 
                                         Foreground="{StaticResource TextPrimaryBrush}" 
                                         CaretBrush="{StaticResource CyanBrush}" 
                                         FontSize="11.5" VerticalAlignment="Center"
                                         TextChanged="SearchBox_TextChanged"/>
                                <TextBlock Grid.Column="1" Text="In Ignite PACS suchen (Patient, Fall, Herd)..." 
                                           FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" 
                                           VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Center: Patient Demographics & Triage Chip -->
                    <Border Grid.Column="1" HorizontalAlignment="Center" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="16,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="BadgeAiStatusDot" Width="10" Height="10" Background="{StaticResource CyanBrush}" CornerRadius="5" Margin="0,0,10,0"/>
                            <TextBlock x:Name="PatientIdText" Text="PATIENT: MUSTERN, GERHARD (M, *1958)" FontWeight="Bold" FontSize="11.5" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            <Separator Width="1" Height="14" Margin="14,0" Background="{StaticResource BorderBrush}"/>
                            <TextBlock x:Name="TxtHeaderAiStatus" Text="TRIAGE: NORMALBEFUND (GRAD 0)" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource CyanBrush}" VerticalAlignment="Center"/>
                            <Separator Width="1" Height="14" Margin="14,0" Background="{StaticResource BorderBrush}"/>
                            <Border Background="#132734" CornerRadius="10" Padding="8,2">
                                <TextBlock x:Name="EngineTimingText" Text="14.8 ms (AVX2 SIMD)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource CyanBrush}"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Right: Menu Bar, Case Load, PDF Export & Hero Lime CTA Button -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Clinical PACS Menu Bar Dropdown -->
                        <Menu Background="Transparent" VerticalAlignment="Center" Margin="0,0,10,0">
                            <MenuItem Header="☰ MENÜ" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" FontSize="11">
                                <MenuItem Header="_Neues Wärmebild öffnen..." Click="MenuOpenImage_Click" InputGestureText="Strg+O"/>
                                <MenuItem Header="_Kontralaterales Bild laden (Bilateraler Vergleich)..." Click="MenuOpenContralateral_Click"/>
                                <Separator Background="{StaticResource BorderBrush}"/>
                                <MenuItem Header="_Ärztlichen Befundbericht exportieren (PDF)..." Click="MenuExportReport_Click"/>
                                <Separator Background="{StaticResource BorderBrush}"/>
                                <MenuItem Header="_DSGVO Art. 30 Audit-Protokoll einsehen" Click="MenuAuditLog_Click"/>
                                <MenuItem Header="_Klinische Lua-Entscheidungsregeln (IWGDF)" Click="MenuLuaEditor_Click"/>
                                <MenuItem Header="_Hardware-Benchmark (AVX2 Vektor vs Skalar)" Click="MenuBenchmark_Click"/>
                                <Separator Background="{StaticResource BorderBrush}"/>
                                <MenuItem Header="_Über IGNITE (Jugend forscht 2026)..." Click="MenuAbout_Click"/>
                                <MenuItem Header="_Dokumentation (ALGORITHM.md)" Click="MenuDocs_Click"/>
                                <Separator Background="{StaticResource BorderBrush}"/>
                                <MenuItem Header="_Beenden" Click="MenuExit_Click"/>
                            </MenuItem>
                        </Menu>

                        <!-- Load Image Button -->
                        <Button Content="📁 BILD ÖFFNEN" Click="MenuOpenImage_Click" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" Margin="0,0,8,0"/>

                        <!-- PDF Export Button -->
                        <Button Content="📄 ARZTSCHRIFTL. BEFUND" Click="MenuExportReport_Click" Background="#132635" BorderBrush="{StaticResource CyanBrush}" Foreground="{StaticResource CyanBrush}" FontWeight="Bold" Margin="0,0,10,0"/>

                        <!-- VOICEMOD SIGNATURE HERO LIME CTA BUTTON (Equivalent to "HOL DIR PRO!") -->
                        <Button Content="⚡ DIAGNOSE STARTEN" Click="BtnRunAnalysis_Click" Style="{StaticResource VoicemodLimeHeroButtonStyle}" ToolTip="Führt die vollständige radiometrische AVX2-Pipeline aus"/>

                        <!-- Notification & Help Glyphs -->
                        <TextBlock Text="🔔" FontSize="15" Foreground="{StaticResource TextSecondaryBrush}" Margin="12,0,8,0" VerticalAlignment="Center" Cursor="Hand" ToolTip="System-Benachrichtigungen"/>
                        <TextBlock Text="❓" FontSize="15" Foreground="{StaticResource TextSecondaryBrush}" Margin="4,0,4,0" VerticalAlignment="Center" Cursor="Hand" MouseDown="MenuAbout_Click" ToolTip="Hilfe"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================================================ -->
            <!-- ROW 1: VOICEMOD CATEGORY FILTER PILL BAR                     -->
            <!-- [ Alle ] [ Dual-View ] [ Vaskulär ] [ Vorhang ] [ 3D ] ...   -->
            <!-- ============================================================ -->
            <Border Grid.Row="1" Background="{StaticResource AppBgBrush}" Padding="16,8,16,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Horizontal Scrolling Filter Pills (Voicemod categories equivalent) -->
                    <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton x:Name="RbFilterAll" Style="{StaticResource VoicemodPillStyle}" GroupName="PillViewFilter" Content="✦ Alle" IsChecked="True" Checked="RbFilterAll_Checked" ToolTip="Vollständige Übersicht"/>
                            <RadioButton x:Name="RbViewDual" Style="{StaticResource VoicemodPillStyle}" GroupName="PillViewFilter" Content="◫ Dual-View" Checked="ViewMode_Checked" ToolTip="Synchronisierte Doppelansicht: Rohbild und Befund"/>
                            <RadioButton x:Name="RbViewCurtain" Style="{StaticResource VoicemodPillStyle}" GroupName="PillViewFilter" Content="🌓 Vorhang-Split" Checked="ViewMode_Checked" ToolTip="Interaktiver Schiebe-Vorhang"/>
                            <RadioButton x:Name="RbViewDSA" Style="{StaticResource VoicemodPillStyle}" GroupName="PillViewFilter" Content="🩸 Vaskulär (DSA)" Checked="ViewMode_Checked" ToolTip="Digitale Subtraktions-Angiographie (Frangi-Venen)"/>
                            <RadioButton x:Name="RbView3DRelief" Style="{StaticResource VoicemodPillStyle}" GroupName="PillViewFilter" Content="⛰️ 3D-Relief" Checked="ViewMode_Checked" ToolTip="2.5D Topografisches Höhenmodell"/>
                            <RadioButton x:Name="RbViewIsotherm" Style="{StaticResource VoicemodPillStyle}" GroupName="PillViewFilter" Content="🌐 Isothermen" Checked="ViewMode_Checked" ToolTip="Isothermen-Bandfilterung"/>
                            <RadioButton x:Name="RbViewDST" Style="{StaticResource VoicemodPillStyle}" GroupName="PillViewFilter" Content="⏱️ Subtraktion DST" Checked="ViewMode_Checked" ToolTip="Longitudinale Verlaufsdifferenz"/>
                            
                            <Separator Width="1" Height="20" Margin="10,0" Background="{StaticResource BorderBrush}"/>

                            <Button Content="Extremitäten trennen" Click="BtnAutoSplitFeet_Click" Padding="12,4" Margin="2,0" ToolTip="Trennt linken &amp; rechten Fuß automatisch"/>
                            <Button Content="Reset ROI" Click="BtnResetROI_Click" Padding="10,4" Margin="2,0"/>
                            <Button Content="Reset Sonden" Click="BtnResetProbes_Click" Padding="10,4" Margin="2,0"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Right Preset & Color Palette Selector -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="PRESET:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10.5" FontWeight="Bold"/>
                        <ComboBox x:Name="ComboPreset" Width="170" SelectionChanged="ComboPreset_SelectionChanged" Margin="0,0,12,0">
                            <ComboBoxItem Content="-- Standard Diagnostik --" IsSelected="True"/>
                            <ComboBoxItem Content="Diabetischer Fuß (Armstrong DFS)"/>
                            <ComboBoxItem Content="Vaskulär / Angiographie (Frangi)"/>
                            <ComboBoxItem Content="Akute Hyperthermie (Top-Hat)"/>
                            <ComboBoxItem Content="Periphere Ischämie (Perfusion)"/>
                        </ComboBox>

                        <TextBlock Text="LUT:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10.5" FontWeight="Bold"/>
                        <ComboBox x:Name="ComboPalette" Width="105" SelectionChanged="ComboPalette_SelectionChanged" Margin="0,0,12,0">
                            <ComboBoxItem Content="Ironbow" IsSelected="True"/>
                            <ComboBoxItem Content="Rainbow"/>
                            <ComboBoxItem Content="Inferno"/>
                            <ComboBoxItem Content="Graustufen"/>
                        </ComboBox>

                        <CheckBox x:Name="ChkSyncViewports" Content="Sync" IsChecked="True" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="Synchroner Zoom beider Viewports"/>
                        <CheckBox x:Name="ChkMinMaxTracker" Content="Min/Max" IsChecked="True" VerticalAlignment="Center" Margin="0,0,10,0" Click="ChkMinMaxTracker_Click" ToolTip="Markiert kälteste und heißeste Stelle"/>
                        <CheckBox x:Name="ChkEnableVeinOverlay" Content="Venen" IsChecked="True" VerticalAlignment="Center" Margin="0,0,4,0" Click="ChkEnableVeinOverlay_Click" ToolTip="Frangi-Gefäßfilter Überlagerung"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================================================ -->
            <!-- ROW 2: WORKBENCH & VOICEMOD INSPECTOR                        -->
            <!-- ============================================================ -->
            <Grid Grid.Row="2" Margin="14,0,14,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="540"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="450" MinWidth="380"/>
                </Grid.ColumnDefinitions>

                <!-- DUAL VIEWPORT WORKBENCH WITH FLOATING ACTION DOCK -->
                <Grid Grid.Column="0">
                    <Border CornerRadius="16" Background="#0A0C13" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Viewport Headers -->
                                <RowDefinition Height="*"/>    <!-- Canvas Area -->
                            </Grid.RowDefinitions>

                            <!-- Viewport Titles Sub-Header -->
                            <Border Grid.Row="0" Background="#121622" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="8" Height="8" Background="{StaticResource CyanBrush}" CornerRadius="4" Margin="0,0,8,0"/>
                                        <TextBlock Text="PRIMÄR-THERMOGRAMM (ROHBILD)" FontWeight="Bold" FontSize="11" Foreground="{StaticResource CyanBrush}"/>
                                        <TextBlock x:Name="TxtToolHintVp1" Text=" · Mausrad = Zoom | Ziehen = Verschieben" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="6,0,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="8" Height="8" Background="{StaticResource ProLimeBrush}" CornerRadius="4" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="TxtVp2Title" Text="DIAGNOSTISCHER BEFUND (VASKULÄR &amp; HYPERTHERMIE)" FontWeight="Bold" FontSize="11" Foreground="{StaticResource ProLimeBrush}"/>
                                        <TextBlock x:Name="TxtResultSubtitle" Text=" · Go AVX2 Engine" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Split Viewports Area -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="ColViewport1" Width="*"/>
                                    <ColumnDefinition x:Name="ColDivider" Width="1"/>
                                    <ColumnDefinition x:Name="ColViewport2" Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- VIEWPORT 1 (Raw Thermal Image) -->
                                <Grid Grid.Column="0" Background="#06080E" ClipToBounds="True">
                                    <ScrollViewer x:Name="ScrollOriginal" 
                                                  HorizontalScrollBarVisibility="Auto" 
                                                  VerticalScrollBarVisibility="Auto"
                                                  PreviewMouseWheel="Viewport_PreviewMouseWheel"
                                                  ScrollChanged="ScrollOriginal_ScrollChanged">
                                        <Grid x:Name="CanvasOriginal" 
                                              Background="Transparent"
                                              MouseDown="ViewportOriginal_MouseDown" 
                                              MouseMove="ViewportOriginal_MouseMove" 
                                              MouseUp="ViewportOriginal_MouseUp" 
                                              MouseLeave="ViewportOriginal_MouseLeave">
                                            <Image x:Name="ImgOriginal" Stretch="None"/>
                                            <Canvas x:Name="OverlayOriginalCanvas" IsHitTestVisible="False"/>
                                        </Grid>
                                    </ScrollViewer>

                                    <!-- DICOM 4-Corner OSD Telemetry Badges -->
                                    <Grid IsHitTestVisible="False" Margin="10">
                                        <Border CornerRadius="6" Background="#C00B0E14" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <TextBlock Text="PATIENT: MUSTERN, GERHARD (M)&#x0a;PID: DFS-2026-8812 · 68 J.&#x0a;MODALITÄT: IR-THERMOGRAFIE&#x0a;DATUM: 01.10.2026  14:22:15" 
                                                       FontSize="9" FontFamily="Consolas, Segoe UI" Foreground="#B0C4DE"/>
                                        </Border>

                                        <Border CornerRadius="6" Background="#C00B0E14" Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Top">
                                            <TextBlock x:Name="HudVp1TopRight" 
                                                       Text="DIABETES-ZENTRUM / RADIOLOGIE&#x0a;SENSOR: LWIR 17µm MICROBOLOMETER&#x0a;MATRIX: 640x480 (16-BIT)&#x0a;ZOOM: 100%" 
                                                       FontSize="9" FontFamily="Consolas, Segoe UI" Foreground="#B0C4DE" TextAlignment="Right"/>
                                        </Border>

                                        <Border CornerRadius="6" Background="#C00B0E14" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,50">
                                            <TextBlock x:Name="HudVp1BottomLeft" 
                                                       Text="LUT: IRONBOW MEDICAL GSDF&#x0a;W: 255 (ΔT: 22.0K)  L: 128 (31.0°C)&#x0a;INTERPOLATION: BILINEAR" 
                                                       FontSize="9" FontFamily="Consolas, Segoe UI" Foreground="{StaticResource CyanBrush}"/>
                                        </Border>
                                    </Grid>

                                    <!-- Physical 50mm Scale Bar -->
                                    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,16" IsHitTestVisible="False">
                                        <StackPanel Width="142">
                                            <TextBlock Text="50 mm" FontSize="8.5" FontFamily="Consolas" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                            <Border Height="3" Background="#94A3B8" BorderBrush="#000000" BorderThickness="0.5"/>
                                            <Grid>
                                                <Rectangle HorizontalAlignment="Left" Width="1" Height="5" Fill="#94A3B8"/>
                                                <Rectangle HorizontalAlignment="Center" Width="1" Height="5" Fill="#94A3B8"/>
                                                <Rectangle HorizontalAlignment="Right" Width="1" Height="5" Fill="#94A3B8"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Viewport Divider -->
                                <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}"/>

                                <!-- VIEWPORT 2 (Diagnostic Findings & Overlays) -->
                                <Grid Grid.Column="2" Background="#06080E" ClipToBounds="True">
                                    <ScrollViewer x:Name="ScrollResult" 
                                                  HorizontalScrollBarVisibility="Auto" 
                                                  VerticalScrollBarVisibility="Auto"
                                                  PreviewMouseWheel="Viewport_PreviewMouseWheel"
                                                  ScrollChanged="ScrollResult_ScrollChanged">
                                        <Grid x:Name="CanvasResult" 
                                              Background="Transparent"
                                              MouseDown="ViewportResult_MouseDown" 
                                              MouseMove="ViewportResult_MouseMove" 
                                              MouseUp="ViewportResult_MouseUp" 
                                              MouseLeave="Viewport_MouseLeave">
                                            <Image x:Name="ImgResult" Stretch="None"/>

                                            <Image x:Name="ImgCurtainRaw" Stretch="None" Visibility="Collapsed">
                                                <Image.Clip>
                                                    <RectangleGeometry x:Name="CurtainClipRect" Rect="0,0,0,0"/>
                                                </Image.Clip>
                                            </Image>

                                            <Canvas x:Name="OverlayResultCanvas" IsHitTestVisible="False"/>

                                            <Canvas x:Name="CanvasCurtain" Visibility="Collapsed" IsHitTestVisible="True">
                                                <Line x:Name="LineCurtain" Stroke="{StaticResource CyanBrush}" StrokeThickness="1.5" StrokeDashArray="3,2"/>
                                                <Border x:Name="BorderCurtainHandle" Width="36" Height="28" Background="#E6101928" BorderBrush="{StaticResource CyanBrush}" BorderThickness="1.5" CornerRadius="6" Cursor="SizeWE" MouseDown="CurtainHandle_MouseDown">
                                                    <TextBlock Text="◀ 🌓 ▶" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource CyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Canvas>
                                        </Grid>
                                    </ScrollViewer>

                                    <!-- Floating Armstrong High-Alert Banner -->
                                    <Border x:Name="FloatingArmstrongBanner" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0" 
                                            Background="#E6DC2626" BorderBrush="#FCD34D" BorderThickness="1.5" CornerRadius="8" Padding="14,6" IsHitTestVisible="False">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="⚠️ " FontSize="14" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtFloatingArmstrong" Text="ARMSTRONG-WARNUNG: ΔT = 2.8 K (≥ 2.2 K) — Hohes Ulkusrisiko!" FontWeight="Bold" FontSize="11.5" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- DICOM 4-Corner OSD Telemetry Badges -->
                                    <Grid IsHitTestVisible="False" Margin="10">
                                        <Border CornerRadius="6" Background="#C00B0E14" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <TextBlock Text="BEFUNDUNG: TOP-HAT + FRANGI-HESSE&#x0a;STATISTIK: ROBUSTES MAD (k=3.0)&#x0a;ENGINE: x86_64 AVX2 (256-BIT SIMD)&#x0a;DETERMINISTISCH (REPRODUZIERBAR)" 
                                                       FontSize="9" FontFamily="Consolas, Segoe UI" Foreground="#B0C4DE"/>
