                                                    <TextBlock Text="Fensterzentrum (Helligkeit L)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                    <Border HorizontalAlignment="Right" Background="#F1F5F9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,3">
                                                        <TextBlock x:Name="TxtWindowLevel" Text="128" FontWeight="Bold" Foreground="{StaticResource CyanBrush}" FontSize="11"/>
                                                    </Border>
                                                </Grid>
