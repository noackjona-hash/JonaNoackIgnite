<Window x:Class="Ignite.Desktop.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IGNITE Medical Workstation Initialisierung"
        Height="400" Width="660"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Custom Smooth Gradient ProgressBar Style -->
        <Style x:Key="SplashProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="TemplateRoot">
                            <!-- Background Track -->
                            <Border CornerRadius="3" Background="#1E293B" BorderThickness="0"/>
                            <!-- Indicator Fill -->
                            <Decorator x:Name="PART_Indicator" HorizontalAlignment="Left">
                                <Border CornerRadius="3">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#0284C7" Offset="0.0"/>
                                            <GradientStop Color="#38BDF8" Offset="0.5"/>
                                            <GradientStop Color="#0D9488" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Decorator>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="14" BorderBrush="#0284C7" BorderThickness="1.5">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0A0F1D" Offset="0.0"/>
                <GradientStop Color="#0F172A" Offset="0.6"/>
                <GradientStop Color="#070B14" Offset="1.0"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="36" ShadowDepth="0" Color="#0284C7" Opacity="0.4"/>
        </Border.Effect>

        <Grid Margin="30,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Brand Header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Medical Cross & Lightning Squircle Logo Badge -->
                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12" Margin="0,0,16,0"
                        BorderBrush="#38BDF8" BorderThickness="1.5">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0369A1" Offset="0"/>
                            <GradientStop Color="#0284C7" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="0" Color="#38BDF8" Opacity="0.45"/>
                    </Border.Effect>
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Medical Cross -->
                        <Rectangle Width="8" Height="26" Fill="#FFFFFF" RadiusX="2" RadiusY="2"/>
                        <Rectangle Width="26" Height="8" Fill="#FFFFFF" RadiusX="2" RadiusY="2"/>
                        <!-- Lightning Bolt -->
                        <Path Data="{StaticResource IconIgniteBolt}" Fill="#FDE047" Stretch="Uniform" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="0" Color="#000000" Opacity="0.5"/>
                            </Path.Effect>
                        </Path>
                    </Grid>
                </Border>

                <!-- Brand Typography -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="IGNITE PACS" FontSize="21" FontWeight="Black" Foreground="#38BDF8"/>
                        <TextBlock Text=" · MEDICAL WORKSTATION" FontSize="21" FontWeight="Bold" Foreground="#F8FAFC" Margin="6,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="Deterministische Infrarot-Thermografie &amp; Diabetische Ulkusprävention"
                               FontSize="11.5" FontWeight="Normal" Foreground="#94A3B8" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Version Badge -->
                <Border Grid.Column="2" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="10,6" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="v5.0.0 PRO" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center"/>
                        <TextBlock Text="RESEARCH GRADE" FontSize="8.5" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Clinical Specifications Grid Cards -->
            <Grid Grid.Row="1" Margin="0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Card 1: SIMD -->
                <Border Grid.Column="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="12,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="AVX2 SIMD-KERN" FontSize="9.5" FontWeight="Bold" Foreground="#64748B"/>
                        </StackPanel>
                        <TextBlock Text="Go 1.27 + ASM" FontSize="13" FontWeight="Bold" Foreground="#F1F5F9"/>
                        <TextBlock Text="32 Pixel / Taktzyklus" FontSize="10" Foreground="#0284C7" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Card 2: Diagnostik -->
                <Border Grid.Column="2" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="12,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <Ellipse Width="6" Height="6" Fill="#38BDF8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="DIAGNOSTIK-NORM" FontSize="9.5" FontWeight="Bold" Foreground="#64748B"/>
                        </StackPanel>
                        <TextBlock Text="Armstrong ΔT ≥ 2.2K" FontSize="13" FontWeight="Bold" Foreground="#F1F5F9"/>
                        <TextBlock Text="Frangi 2D Gefäßfilter" FontSize="10" Foreground="#0D9488" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Card 3: Compliance -->
                <Border Grid.Column="4" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="12,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <Ellipse Width="6" Height="6" Fill="#A855F7" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="COMPLIANCE" FontSize="9.5" FontWeight="Bold" Foreground="#64748B"/>
                        </StackPanel>
                        <TextBlock Text="DIN EN ISO 13485" FontSize="13" FontWeight="Bold" Foreground="#F1F5F9"/>
                        <TextBlock Text="DSGVO Art. 30 Audit" FontSize="10" Foreground="#8B5CF6" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Loading Progress -->
            <StackPanel Grid.Row="2" Margin="0,0,0,16">
                <Grid Margin="0,0,0,8">
                    <TextBlock x:Name="TxtSplashStatus" Text="Initialisiere Hardware-beschleunigten Rechenkern..." FontSize="11" FontWeight="SemiBold" Foreground="#CBD5E1"/>
                    <TextBlock x:Name="TxtSplashPercent" Text="0%" FontSize="11.5" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                </Grid>
                <ProgressBar x:Name="SplashProgress" Height="6" Minimum="0" Maximum="100" Value="0" Style="{StaticResource SplashProgressBarStyle}"/>
            </StackPanel>

            <!-- Status Footer -->
            <Grid Grid.Row="3">
                <TextBlock Text="Jugend forscht 2026 – Fachgebiet Arbeitswelt / Informatik" FontSize="10" Foreground="#64748B"/>
                <TextBlock Text="Jona Noack · Deterministischer Go-SIMD Kern · 100% Lokal" FontSize="10" Foreground="#64748B" HorizontalAlignment="Right"/>
            </Grid>
        </Grid>
    </Border>
</Window>
