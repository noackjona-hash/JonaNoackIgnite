<Window x:Class="Ignite.Desktop.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IGNITE Loader"
        Height="360" Width="580"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen">

    <Border Background="#141416" CornerRadius="12" BorderBrush="#007ACC" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="0" Color="#007ACC" Opacity="0.4"/>
        </Border.Effect>

        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Brand Header -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="IGNITE MEDICAL" FontSize="26" FontWeight="ExtraBold" Foreground="#007ACC"/>
                <TextBlock Text="Deterministische Thermografie-Workstation • v5.0.0" FontSize="13" FontWeight="SemiBold" Foreground="#4EC9B0" Margin="0,2,0,0"/>
                <TextBlock Text="Jugend forscht 2026 – Fachgebiet Arbeitswelt / Informatik" FontSize="11" Foreground="#888888" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Middle Highlights -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,15">
                <TextBlock Text="⚡ Go 1.27 + x86_64 AVX2 Vektor-Assembler (32 Pixel/Takt)" FontSize="11" Foreground="#CCCCCC" Margin="0,2"/>
                <TextBlock Text="🩺 Armstrong-Kriterien (ΔT >= 2.2 K) &amp; Frangi-Venenkartierung" FontSize="11" Foreground="#CCCCCC" Margin="0,2"/>
                <TextBlock Text="🛡️ Revisionssicheres DSGVO-Auditprotokoll (SQLite)" FontSize="11" Foreground="#CCCCCC" Margin="0,2"/>
            </StackPanel>

            <!-- Loading Progress -->
            <ProgressBar Grid.Row="2" x:Name="SplashProgress" Height="6" IsIndeterminate="True" Foreground="#007ACC" Background="#26262B" BorderThickness="0" Margin="0,10"/>

            <!-- Status Text -->
            <Grid Grid.Row="3">
                <TextBlock x:Name="TxtSplashStatus" Text="Initialisiere Hardware-beschleunigten Rechenkern..." FontSize="11" Foreground="#999999"/>
                <TextBlock Text="100% Lokal &amp; DSGVO-konform" FontSize="11" Foreground="#666666" HorizontalAlignment="Right"/>
            </Grid>
        </Grid>
    </Border>
</Window>
